check "hello.lang has 13 top-level statements": len(hello_ast.stmts) == 13
check "hello.lang's first statement is the greeting let":
  (hello_ast.stmts[0]).kind == "let" and (hello_ast.stmts[0]).name == "greeting"
check "hello.lang's last statement is the verdict check":
  (hello_ast.stmts[12]).kind == "check" and (hello_ast.stmts[12]).label == "verdict"
check "the if/else in hello.lang round-trips structurally":
  ((hello_ast.stmts[9]).value).kind == "if" and
    ((hello_ast.stmts[9]).value).cond.op == ">" and
    (((((hello_ast.stmts[9]).value).then).stmts[0]).expr).value == "big"

# ---- tests: `shape` declarations (v0.12 guest parity, round 338) --------
# The claim is that the guest desugars `shape` EXACTLY as the host's
# `shape_def` does — to a plain `let` binding a record whose first field is
# `__shape` — so the shape is an ordinary runtime value and every rule that
# already applies to a `let` name applies to it for free.
let sh_ast = parse_whence("shape Point = @{x: num, y: num}\nlet p = 1")
let sh_rec = (sh_ast.stmts[0]).value
check "a shape declaration parses": not missed(sh_ast)
check "a shape desugars to an ordinary let":
  (sh_ast.stmts[0]).kind == "let" and (sh_ast.stmts[0]).name == "Point"
check "the bound value is a record literal": sh_rec.kind == "record"
check "__shape comes first and names the shape":
  ((sh_rec.pairs)[0]).name == "__shape" and
    (((sh_rec.pairs)[0]).value).value == "Point"
check "a primitive field type becomes a str spec node":
  ((sh_rec.pairs)[1]).name == "x" and (((sh_rec.pairs)[1]).value).kind == "str"
check "an empty shape still carries __shape":
  len((((parse_whence("shape E = @{}\nlet p = 1")).stmts[0]).value).pairs) == 1

# A shape-typed FIELD is a NameRef, never a copy: `shape L = @{a: P}` must
# read the one binding `P` names, which is what makes nested shapes compose
# structurally instead of snapshotting P at declaration time (host
# `_type_spec_expr`).
let sh_nest = parse_whence("shape P = @{x: num}\nshape L = @{a: P}\nlet q = 1")
let sh_field = ((((sh_nest.stmts[1]).value).pairs)[1]).value
check "a shape-typed field becomes a name node, not a copy":
  sh_field.kind == "name" and sh_field.value == "P"

# Annotation position: the spec node a guard reads its type FROM.
let sh_guard = parse_whence("shape P = @{x: num}\nfn f(a: P) { a }\nlet z = 1")
let sh_spec = (((((sh_guard.stmts[1]).body).stmts[0]).value).args)[1]
check "a parameter guard reads a shape by name":
  sh_spec.kind == "name" and sh_spec.value == "P"
let sh_ret = parse_whence("shape P = @{x: num}\nfn f() -> P { 1 }\nlet z = 1")
check "a return annotation carries a name node for a shape":
  ((sh_ret.stmts[1]).ret_type).kind == "name" and
    ((sh_ret.stmts[1]).ret_type).value == "P"
check "a return annotation carries a str node for a primitive":
  ((((parse_whence("fn f() -> num { 1 }\nlet z = 1")).stmts[0]).ret_type).kind
   == "str")
check "an unannotated fn still has the empty-string sentinel":
  (((parse_whence("fn f() { 1 }\nlet z = 1")).stmts[0]).ret_type) == ""

# The five declaration-time rejections, in the host's own order, plus the
# two that were already there before shapes existed.
check "a shape cannot reference itself":
  missed(parse_whence("shape P = @{x: P}\nlet z = 1"))
check "no forward references between shapes":
  missed(parse_whence("shape A = @{b: B}\nshape B = @{x: num}\nlet z = 1"))
check "a primitive tag cannot be redeclared as a shape":
  missed(parse_whence("shape num = @{x: num}\nlet z = 1"))
check "a shape cannot be declared twice in one block":
  missed(parse_whence("shape P = @{x: num}\nshape P = @{y: num}\nlet z = 1"))
# v0.18 (round 342): the type namespace is the value namespace, so it has the
# value namespace's scope rule — one frame per block, innermost-out. Sibling
# and shadowing declarations are therefore fine (a `let` may do both), while
# an annotation naming a shape whose block has CLOSED is refused where it is
# written instead of misbehaving three different ways at run time.
check "sibling blocks may each declare the same shape name":
  not missed(parse_whence("fn a() { shape S = @{x: num}\n1 }\n" +
                          "fn b() { shape S = @{y: num}\n1 }\nlet z = 1"))
check "an inner block may shadow an outer shape name":
  not missed(parse_whence("shape S = @{x: num}\n" +
                          "fn a() { shape S = @{y: num}\n1 }\nlet z = 1"))
check "a block-local shape is a real type inside its own block":
  not missed(parse_whence("fn a() { shape S = @{x: num}\nfn f(p: S) -> S { p }\n" +
                          "f(@{x: 1}) }\nlet z = 1"))
check "but not after that block has closed":
  missed(parse_whence("fn a() { shape S = @{x: num}\n1 }\n" +
                      "fn f(p: S) { p }\nlet z = 1"))
check "out of scope is worded differently from never declared":
  contains(str(reasons(parse_whence("fn a() { shape S = @{x: num}\n1 }\n" +
                                    "fn f(p: S) { p }\nlet z = 1"))),
           "not in scope here") and
  contains(str(reasons(parse_whence("fn f(p: Nope) { p }\nlet z = 1"))),
           "unknown type")
check "duplicate shape fields are rejected":
  missed(parse_whence("shape P = @{x: num, x: str}\nlet z = 1"))
check "a shape name cannot be rebound, like any other let":
  missed(parse_whence("shape P = @{x: num}\nlet P = 1\nlet z = 1"))
check "an unknown type name is still rejected":
  missed(parse_whence("fn f(a: Nope) { a }\nlet z = 1"))

# `shape` stays a CONTEXTUAL keyword: only three ADJACENT tokens trigger it,
# which is exactly what the host's peek(1)/peek(2) require (neither skips a
# newline). Both halves matter — the first keeps old programs working, the
# second is the premise that lets `shapes_declared_before` recover the
# host's mutable parser state from the token stream alone.
check "`shape` is contextual, not reserved":
  not missed(parse_whence("let shape = 5\nlet z = shape + 1"))
check "a field may be called shape":
  not missed(parse_whence("let r = @{shape: 3}\nlet z = r.shape"))
check "`shape` needs three adjacent tokens":
  missed(parse_whence("shape\nP = @{x: num}\nlet z = 1"))

print("self_host.lang: guest lexer+parser for real Whence syntax, all checks above passed")

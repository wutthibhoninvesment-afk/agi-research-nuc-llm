# A token that can never START a statement is NOT a separator error: it
# falls through to `parse_stmt`, which refuses it with the specific
# message. `1 + 2)` is the pre-existing case; `x = 2` is the one decision 32
# added a cure for at the host, and the guest must not shadow it either.
#
# v0.36 (round 398), decision 45: these two asserted `"unexpected token"`,
# a prefix the guest wrote and the host never did. They now assert the
# whole thing the host writes -- `unexpected '='` -- which is what the
# earlier spelling could not: `contains(..., "unexpected token")` passes
# for ANY offending token, so neither check ever tested the half of the
# sentence its own name promises.
check "a stray token that starts no expression is still its own error":
  contains(str(parse_whence("let x = 1\nx = 2")), "unexpected '='")
check "a stray token that starts no expression is a miss":
  missed(parse_whence("1 + 2)"))
check "...and names the offending token":
  contains(str(parse_whence("1 + 2)")), "unexpected ')'")
# v0.36 (round 398), decision 45: the GOT half of `expected X, got Y`, and
# the want half at the six sites `expect_name` used to answer with one
# sentence. `show_tok` is `whence/parser.py`'s `_show` written in Whence:
# the EOF token is `end of input` and not the empty string its `v` field
# holds, and a number is not quoted.
#
# v0.39 (round 408), decision 48 rewrote the rest of it. The got slot is
# now EITHER a literal the author can type back verbatim in Whence OR
# prose -- never a spelling from the implementation language. Three of the
# checks below moved with it, and one of them is worth reading twice:
# "a string in the got slot switches quotes when it holds a single one"
# asserted `got "a'b"`, and `got "a'b"` is still what comes out, because a
# string is now ALWAYS double-quoted. The check would have stayed green
# with its own claim gone. It is replaced here by the pair that can tell
# the two rules apart -- a KEYWORD and a STRING carrying the same text.
check "the got half names end of input, not the token's empty value":
  contains(str(parse_whence("(1 + 2")), "expected ')', got end of input")
check "a number in the got slot is not quoted":
  contains(str(parse_whence("check 1: 1 == 1")),
           "expected a string label after 'check', got 1")
check "a name in the got slot is quoted":
  contains(str(parse_whence("let let = 1")), "expected a name, got 'let'")
check "a newline in the got slot is prose, not the host language's escape":
  contains(str(parse_whence("let x\nlet y = 1")), "expected '=', got a line break")
# Round 414 (language C). ONE probe cannot support the word ALWAYS, and the
# one this check had is the probe the rule it replaced renders IDENTICALLY:
# decision 48's predecessor single-quoted a string UNLESS it held a single
# quote, so `"a'b"` came out double-quoted under BOTH rules. `checkpin.py`
# put the old switching rule back and this check stayed green while its two
# siblings went red -- verdict `shadowed`, i.e. the direct descendant of the
# inert check round 408 §6.1 replaced it with. A string with no apostrophe in
# it is what the two rules actually disagree about, so the second probe is
# the one carrying the word "always".
check "a string in the got slot is a Whence literal, always double-quoted":
  contains(str(parse_whence("let f = fn(x) { x }\nlet v = f(1 \"a'b\")")),
           "expected ')', got \"a'b\"") and
  contains(str(parse_whence("let f = fn(x) { x }\nlet v = f(1 \"ab\")")),
           "expected ')', got \"ab\"")
check "...so a keyword and a string spelled alike no longer collide":
  contains(str(parse_whence("let \"let\" = 1")), "expected a name, got \"let\"")
check "...and the keyword keeps decision 44's single quotes":
  contains(str(parse_whence("let let = 1")), "expected a name, got 'let'")
check "a quote inside a string in the got slot is escaped, so it re-lexes":
  contains(str(parse_whence("let f = fn(x) { x }\nlet v = f(1 \"a\\\"b\")")),
           "expected ')', got \"a\\\"b\"")
check "expect_name says which KIND of name it wanted":
  contains(str(parse_whence("let r = @{a: 1,}")), "expected field name, got '}'")
check "...and a parameter is a parameter, not just a name":
  contains(str(parse_whence("fn f(a,) { a }")),
           "expected parameter name, got ')'")

check "duplicate let in one block is a miss":
  missed(parse_whence("fn f() { let x = 1\nlet x = 2\nx }"))
check "duplicate let names the variable":
  contains(str(parse_whence("fn f() { let x = 1\nlet x = 2\nx }")),
           "'x' is already bound in this block (line 1); Whence has no rebinding")
# v0.37 (round 402), decision 46. The line in that sentence is COMPUTED, and
# these are the checks that say so. There are exactly two plausible wrong
# answers -- a hard-coded `(line 1)`, and reporting the DUPLICATE's line
# instead of the FIRST binding's -- and the program below separates them:
# the first binding is on line 3, the collision on line 4, so a wrong
# implementation fails one of the next two checks and a right one passes
# both. Without them the check above passes for a guest that never looked
# at a token, because line 1 is where the first binding usually is.
check "...and the line is the FIRST binding's, not a constant":
  contains(str(parse_whence("fn f() {\n\nlet x = 1\nlet x = 2\nx }")),
           "'x' is already bound in this block (line 3)")
check "...while the position clause still points at the DUPLICATE":
  contains(str(parse_whence("fn f() {\n\nlet x = 1\nlet x = 2\nx }")),
           "Whence has no rebinding at line 4, col 1")
check "a duplicate fn is reported exactly as a duplicate let is":
  contains(str(parse_whence("fn f() { 1 }\nfn f() { 2 }\nf()")),
           "'f' is already bound in this block (line 1); Whence has no rebinding")
# The binding table is per-block on both sides, and it has to stay that way:
# `bound_line` scanning an OUTER block's table would turn legal shadowing
# into a parse error. The host accepts this program (`whence/parser.py`
# pushes a fresh `bound` per `stmt_list`); so must the guest.
check "an inner block may still bind a name the outer block bound":
  not missed(parse_whence("fn f() { let x = 1\n if true { let x = 2\n x } else { x } }"))
# ...and the SIBLING direction: a name bound in a closed inner block must
# not be visible to the table of the block that follows it.
check "a name bound inside a closed block does not collide with a later one":
  not missed(parse_whence("fn f() { if true { let x = 1\n x } else { 0 }\nlet x = 2\nx }"))
check "duplicate param is a miss": missed(parse_whence("fn f(a, a) { a }"))
check "bad token in a string is a miss": missed(parse_whence("`"))
check "chained comparisons are rejected, matching the host":
  missed(parse_whence("1 < 2 < 3"))
check "...with the host's own wording":
  contains(str(parse_whence("1 < 2 < 3")), "do not chain")

# ---- tests: round-trip on a REAL example file's actual source -------------
# hello.lang, verbatim (escaped for embedding as a Whence string literal).
let hello_src =
  "let greeting = \"hello, \" + \"whence\"\n" +
  "print(greeting)\n" +
  "fn square(x) { x * x }\n" +
  "let numbers = range(1, 6)\n" +
  "let squares = map(square, numbers)\n" +
  "print(squares)\n" +
  "fn add(a, b) { a + b }\n" +
  "let total = fold(add, 0, squares)\n" +
  "print(\"sum of squares: \" + str(total))\n" +
  "let verdict = if total > 50 { \"big\" } else { \"small\" }\n" +
  "print(verdict)\n" +
  "check \"sum of squares\": total == 55\n" +
  "check \"verdict\": verdict == \"big\"\n"
let hello_ast = parse_whence(hello_src)
check "the guest parser consumes hello.lang's real source without error":
  not missed(hello_ast)
check "hello.lang has 13 top-level statements": len(hello_ast.stmts) == 13
check "hello.lang's first statement is the greeting let":
  (hello_ast.stmts[0]).kind == "let" and (hello_ast.stmts[0]).name == "greeting"
check "hello.lang's last statement is the verdict check":
  (hello_ast.stmts[12]).kind == "check" and (hello_ast.stmts[12]).label == "verdict"
check "the if/else in hello.lang round-trips structurally":
  ((hello_ast.stmts[9]).value).kind == "if" and
    ((hello_ast.stmts[9]).value).cond.op == ">" and
    (((((hello_ast.stmts[9]).value).then).stmts[0]).expr).value == "big"

# ---- tests: `shape` declarations (v0.12 guest parity, round 338) --------
# The claim is that the guest desugars `shape` EXACTLY as the host's
# `shape_def` does — to a plain `let` binding a record whose first field is
# `__shape` — so the shape is an ordinary runtime value and every rule that
# already applies to a `let` name applies to it for free.
let sh_ast = parse_whence("shape Point = @{x: num, y: num}\nlet p = 1")
let sh_rec = (sh_ast.stmts[0]).value
check "a shape declaration parses": not missed(sh_ast)
check "a shape desugars to an ordinary let":
  (sh_ast.stmts[0]).kind == "let" and (sh_ast.stmts[0]).name == "Point"
check "the bound value is a record literal": sh_rec.kind == "record"
check "__shape comes first and names the shape":
  ((sh_rec.pairs)[0]).name == "__shape" and
    (((sh_rec.pairs)[0]).value).value == "Point"
check "a primitive field type becomes a str spec node":
  ((sh_rec.pairs)[1]).name == "x" and (((sh_rec.pairs)[1]).value).kind == "str"
check "an empty shape still carries __shape":
  len((((parse_whence("shape E = @{}\nlet p = 1")).stmts[0]).value).pairs) == 1

# A shape-typed FIELD is a NameRef, never a copy: `shape L = @{a: P}` must
# read the one binding `P` names, which is what makes nested shapes compose
# structurally instead of snapshotting P at declaration time (host
# `_type_spec_expr`).
let sh_nest = parse_whence("shape P = @{x: num}\nshape L = @{a: P}\nlet q = 1")
let sh_field = ((((sh_nest.stmts[1]).value).pairs)[1]).value
check "a shape-typed field becomes a name node, not a copy":
  sh_field.kind == "name" and sh_field.value == "P"

# Annotation position: the spec node a parameter contract reads its type
# FROM. v0.19 (round 344): it rides on the fn NODE, in `param_types`, not
# on a `let a = typed(a, P, "…")` statement prepended to the body — see
# `build_param_contracts`. The body is now byte-identical to an
# unannotated one, which is the last of the four checks below.
let sh_guard = parse_whence("shape P = @{x: num}\nfn f(a: P) { a }\nlet z = 1")
let sh_pt = ((sh_guard.stmts[1]).param_types)[0]
check "a parameter contract reads a shape by name":
  (sh_pt.spec).kind == "name" and (sh_pt.spec).value == "P"
check "a parameter contract carries index, name and label":
  sh_pt.index == 0 and sh_pt.name == "a" and
    sh_pt.label == "parameter 'a' of f"
check "an unannotated fn carries no parameter contracts":
  len(((parse_whence("fn f(a) { a }\nlet z = 1")).stmts[0]).param_types) == 0
check "an annotated fn's body is left alone, no prepended guard":
  len(((sh_guard.stmts[1]).body).stmts) == 1 and
    ((((sh_guard.stmts[1]).body).stmts)[0]).kind == "exprstmt"
let sh_ret = parse_whence("shape P = @{x: num}\nfn f() -> P { 1 }\nlet z = 1")
check "a return annotation carries a name node for a shape":
  ((sh_ret.stmts[1]).ret_type).kind == "name" and
    ((sh_ret.stmts[1]).ret_type).value == "P"
check "a return annotation carries a str node for a primitive":
  ((((parse_whence("fn f() -> num { 1 }\nlet z = 1")).stmts[0]).ret_type).kind
   == "str")
check "an unannotated fn still has the empty-string sentinel":
  (((parse_whence("fn f() { 1 }\nlet z = 1")).stmts[0]).ret_type) == ""

# The five declaration-time rejections, in the host's own order, plus the
# two that were already there before shapes existed.
check "a shape cannot reference itself":
  missed(parse_whence("shape P = @{x: P}\nlet z = 1"))
check "no forward references between shapes":
  missed(parse_whence("shape A = @{b: B}\nshape B = @{x: num}\nlet z = 1"))
check "a primitive tag cannot be redeclared as a shape":
  missed(parse_whence("shape num = @{x: num}\nlet z = 1"))
check "a shape cannot be declared twice in one block":
  missed(parse_whence("shape P = @{x: num}\nshape P = @{y: num}\nlet z = 1"))
# v0.18 (round 342): the type namespace is the value namespace, so it has the
# value namespace's scope rule — one frame per block, innermost-out. Sibling
# and shadowing declarations are therefore fine (a `let` may do both), while
# an annotation naming a shape whose block has CLOSED is refused where it is
# written instead of misbehaving three different ways at run time.
check "sibling blocks may each declare the same shape name":
  not missed(parse_whence("fn a() { shape S = @{x: num}\n1 }\n" +
                          "fn b() { shape S = @{y: num}\n1 }\nlet z = 1"))
check "an inner block may shadow an outer shape name":
  not missed(parse_whence("shape S = @{x: num}\n" +
                          "fn a() { shape S = @{y: num}\n1 }\nlet z = 1"))
check "a block-local shape is a real type inside its own block":
  not missed(parse_whence("fn a() { shape S = @{x: num}\nfn f(p: S) -> S { p }\n" +
                          "f(@{x: 1}) }\nlet z = 1"))
check "but not after that block has closed":
  missed(parse_whence("fn a() { shape S = @{x: num}\n1 }\n" +
                      "fn f(p: S) { p }\nlet z = 1"))
check "out of scope is worded differently from never declared":
  contains(str(reasons(parse_whence("fn a() { shape S = @{x: num}\n1 }\n" +
                                    "fn f(p: S) { p }\nlet z = 1"))),
           "not in scope here") and
  contains(str(reasons(parse_whence("fn f(p: Nope) { p }\nlet z = 1"))),
           "unknown type")
check "duplicate shape fields are rejected":
  missed(parse_whence("shape P = @{x: num, x: str}\nlet z = 1"))
check "a shape name cannot be rebound, like any other let":
  missed(parse_whence("shape P = @{x: num}\nlet P = 1\nlet z = 1"))
check "an unknown type name is still rejected":
  missed(parse_whence("fn f(a: Nope) { a }\nlet z = 1"))

# `shape` stays a CONTEXTUAL keyword: only three ADJACENT tokens trigger it,
# which is exactly what the host's peek(1)/peek(2) require (neither skips a
# newline). Both halves matter — the first keeps old programs working, the
# second is the premise that lets `shapes_declared_before` recover the
# host's mutable parser state from the token stream alone.
check "`shape` is contextual, not reserved":
  not missed(parse_whence("let shape = 5\nlet z = shape + 1"))
check "a field may be called shape":
  not missed(parse_whence("let r = @{shape: 3}\nlet z = r.shape"))
check "`shape` needs three adjacent tokens":
  missed(parse_whence("shape\nP = @{x: num}\nlet z = 1"))

# v0.40 (round 410), decision 49 --- the guest's half of the numeric-text
# rule, checked in Whence. Doubling rather than a 4001-character source
# line: `rep9` builds the digit string in 12 concatenations, and the check
# section is not part of the section `test_self_eval.py` pins byte-identical
# against self_eval.lang, so the helper lives here.
fn rep9(n) { rep9_at("9", n) }
fn rep9_at(s, n) {
  if len(s) >= n { slice(s, 0, n) } else { rep9_at(s + s, n) }
}
check "rep9 builds the digit string it says it does":
  len(rep9(4001)) == 4001 and rep9(4001)[4000] == "9"
check "an integer literal at the cap is accepted":
  ((lex_all("let a = " + rep9(num_text_digit_limit)))[3]).t == "num"
check "one digit past the cap is a lex error, in the host's own words":
  ((lex_all("let a = " + rep9(num_text_digit_limit + 1)))[3]).v ==
    "4001 digits is over the 4000-digit limit for numeric text (str of a larger integer is a summary, not digits)"
check "and it is reported at the literal's first column, not the scan's end":
  ((lex_all("let a = " + rep9(num_text_digit_limit + 1)))[3]).col == 9
check "a float literal is never refused, however many digits it has":
  ((lex_all("let a = " + rep9(num_text_digit_limit + 1) + ".5"))[3]).t == "num"
check "and an overflowing float literal is still inf on this side too":
  ((lex_all("let a = " + rep9(num_text_digit_limit + 1) + ".5"))[3]).v ==
    pos_inf

print("self_host.lang: guest lexer+parser for real Whence syntax, all checks above passed")

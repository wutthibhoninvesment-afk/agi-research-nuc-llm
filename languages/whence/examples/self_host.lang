# self_host.lang — a lexer and parser for REAL Whence syntax, written in
# Whence (self-hosting round 3; meta.lang's guest arithmetic language was
# round 2's warm-up). This is the honest test of the host language's own
# expressiveness: can Whence describe Whence?
#
# Scope: lexer + parser only. The output is an AST as Whence records
# (`@{kind: "...", ...}`), not evaluated — writing a full guest evaluator
# with closures/env/provenance/builtins in Whence-without-mutation is a
# separate, much larger project left for a future round (see the knowledge
# file). What IS built here: character classification, a real two-pass-free
# single-pass lexer with the SAME bracket-depth newline-suppression rule as
# the host (`whence/lexer.py`), full operator-precedence recursive descent
# (rescue > or > and > not > comparison > +- > */％ > unary > postfix >
# primary), blocks, if/else-if chains, fn literals and defs, record and list
# literals, and the host's own "no rebinding in one block" rule re-enforced
# by the guest parser itself.
#
# Errors are total, per design decision 2: every `expect_*` either returns
# the next position or a `miss`, and because `if`/`and`/`or` on a miss
# condition never evaluate either branch (see `_if_bad`/host `and`/`or`),
# a poisoned position silently short-circuits every later step without ever
# fabricating a new, wrong reason — the ORIGINAL miss reason (a plain string)
# survives untouched all the way to the top because `merge_miss` only
# extends a reason list, never replaces it. `run.py`'s own meta.lang comment
# already used this pattern for a toy language; here it carries the full
# real grammar.

# ---- character classes -----------------------------------------------------
let digits = "0123456789"
let lower = "abcdefghijklmnopqrstuvwxyz"
let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
let name_start_chars = lower + upper + "_"
let name_cont_chars = name_start_chars + digits

fn is_digit(c) { contains(digits, c) }
fn is_name_start(c) { contains(name_start_chars, c) }
fn is_name_cont(c) { contains(name_cont_chars, c) }

let keywords = ["let", "fn", "if", "else", "check", "rescue",
                "why", "snip", "miss", "true", "false", "and", "or", "not"]
let two_char_ops = ["==", "!=", "<=", ">=", "@{", "->"]
let one_char_ops = "+-*/%()[]{},:.=<>"

# index of the first char at/after i that fails pred (mirrors meta.lang)
fn scan_while(s, i, pred) {
  if i < len(s) and pred(s[i]) { scan_while(s, i + 1, pred) } else { i }
}
fn slice(s, i, j) { if i >= j { "" } else { s[i] + slice(s, i + 1, j) } }

# mirrors whence/lexer.py's post-round-323 exponent scan (round 332): only
# consumes "e"/"E" + optional sign + digits when a full, valid exponent
# follows, so a bare trailing e/E that starts a NAME ("5experiment") is
# left untouched, exactly like the host.
fn exp_end(s, j) {
  if j < len(s) and (s[j] == "e" or s[j] == "E") {
    let k = j + 1
    let k2 = if k < len(s) and (s[k] == "+" or s[k] == "-") { k + 1 } else { k }
    if k2 < len(s) and is_digit(s[k2]) { scan_while(s, k2, is_digit) } else { j }
  } else { j }
}

# The other half of the same mirror, and round 332 did not have it (round
# 350). The host's literal scanner converts with `float(text)`/`int(text)`,
# which OVERFLOWS TO `inf` for `1e400` -- deliberately, and pinned by
# tests/test_lexer.py::test_exponent_overflow_becomes_inf_not_a_lex_error.
# `num(text)` does NOT: an out-of-range finite-syntax string is an "out of
# range" MISS, a string-CONVERSION rule that whence/lexer.py's own comment
# is careful to separate from the literal-grammar one. Round 332 mirrored
# the exponent SCAN into `exp_end` and silently inherited `num`'s
# CONVERSION with it, so every overflowing literal -- `1e400`, and the
# pre-existing 400-digit-plus-fraction case that predates round 332
# entirely -- carried a miss here where the host carries `inf`.
# `pos_inf` is the host's own answer obtained the host's own way: this very
# literal, lexed one level up. A literal the scan produced is always valid
# Whence number syntax and is never signed (`-1e400` is op `-` then the
# literal `1e400`), so "out of range" is the ONLY way `num` can fail on it
# and the overflow is always toward +inf.
let pos_inf = 1e400
# v0.40 (round 410), decision 49: `values.SHOW_INT_DIGITS`. The guest cannot
# import the host's constant, so it is written here once and pinned against
# the host by `tests/test_lexer_guest_parity.py`'s table-parity section --
# the same arrangement as `keywords`, `one_char_ops` and the escape table.
let num_text_digit_limit = 4000
fn lit_num(text) {
  let v = num(text)
  if missed(v) { pos_inf } else { v }
}

# ---- lexer ------------------------------------------------------------------
# bracket stack: a list of "(" "[" "@{" "{" strings, pushed on open, popped on
# ANY close (matching whence/lexer.py's `brackets` — it does not check which
# open matches which close either). Newlines are suppressed while the top of
# the stack is "(" "[" or "@{" — NOT inside plain "{" blocks, so a block body
# still statement-separates on newlines even nested inside a call's parens
# (`map(fn(x) { x * 2\n x }, xs)` keeps the block's internal newline).
# SECOND suppression path, found only by self-hosting round 6 (round 192):
# a newline is ALSO a continuation right after a token that "cannot end a
# statement" — an operator, `=`, `:`, `,`, or `and`/`or`/`not`/`rescue` —
# independent of bracket depth (whence/lexer.py's own `CONTINUES`/
# `CONTINUE_KWS`, module docstring). This guest lexer had only the
# bracket-depth half of the rule; every hand-written example that splits a
# `check "label":` across two lines (self_host.lang's OWN test section,
# lines 556-557) round-trips fine under the HOST but was an unconditional
# parse_error under the guest — invisible to 20+ rounds of guest-differential
# fuzzing because the fuzzer's printer never emits a bare trailing operator/
# colon/keyword followed by a real newline (see round-192 knowledge file).
fn top_of(stack) { if len(stack) == 0 { "" } else { stack[len(stack) - 1] } }
fn pop_last(xs) { list_slice(xs, 0, len(xs) - 1) }
fn list_slice(xs, i, j) { if i >= j { [] } else { [xs[i]] + list_slice(xs, i + 1, j) } }
let continue_ops = ["+", "-", "*", "/", "%", ",", ":", "=", "<", ">",
                     "==", "!=", "<=", ">=", "->"]
let continue_kws = ["and", "or", "not", "rescue"]
fn last_continues(acc) {
  if len(acc) == 0 { false }
  else {
    let last = acc[len(acc) - 1]
    (last.t == "op" and contains(continue_ops, last.v)) or
      (last.t == "kw" and contains(continue_kws, last.v))
  }
}
fn suppressed(stack, acc) {
  let t = top_of(stack)
  t == "(" or t == "[" or t == "@{" or last_continues(acc)
}

# Returns EITHER `@{v: <decoded text>, pos: <index after the closing quote>}`
# on success OR `@{err: <message>}` on failure. Until v0.21 (round 350) the
# failure side was a `miss` literal, and `miss "unterminated string"` gives
# a reason of `unterminated string (line 161)` -- 161 being a line in THIS
# file. That line number was reaching the caller's `bad` token and so the
# guest's user-facing lex error, describing the program being lexed with a
# coordinate into the lexer's own source; it also moved every time this
# file was edited. A plain record carries the message the host's `LexError`
# carries and nothing else. The `""` sentinel below is safe because every
# valid escape decodes to exactly one character.
# v0.24 (round 360): the failure side also carries `at`, the ABSOLUTE
# index the host's `LexError` reports, because host and guest now have to
# agree on a COLUMN and not just on a sentence. The host reports an
# unterminated string at the OPENING QUOTE (`start_col`, captured before
# the scan) and a bad escape at the BACKSLASH (the live `col`), so `q` --
# the quote's index, passed in by the caller -- is what the three
# unterminated arms return and `i` is what the escape arm returns.
fn lex_str_body(s, i, acc, q) {
  if i >= len(s) { @{err: "unterminated string", at: q} }
  # v0.21 (round 350): a RAW newline inside a string literal ends the string
  # unterminated -- whence/lexer.py's `if i >= n or src[i] == "\\n"` has said
  # so since its first commit, and this guest had only the `i >= len(s)`
  # half, so it happily consumed across the line break and produced a
  # multi-line string token the host refuses outright.
  else if s[i] == "\n" { @{err: "unterminated string", at: q} }
  else if s[i] == "\"" { @{v: acc, pos: i + 1} }
  else if s[i] == "\\" {
    if i + 1 >= len(s) { @{err: "unterminated string", at: q} }
    else {
      let e = s[i + 1]
      let ch = if e == "n" { "\n" }
        else if e == "t" { "\t" }
        else if e == "r" { "\r" }
        else if e == "\"" { "\"" }
        else if e == "\\" { "\\" }
        else { "" }
      if ch == "" { @{err: "bad escape '\\" + e + "'", at: i} }
      else { lex_str_body(s, i + 2, acc + ch, q) }
    }
  }
  else { lex_str_body(s, i + 1, acc + s[i], q) }
}

# lex(s, i, stack, acc, line, bol) -> final token list (acc grows via push,
# which is O(1) amortized on the tip of a shared-buffer WList — round 7's
# finding).
#
# v0.24 (round 360): `bol` is the index of the current line's FIRST
# character, and every token's column is `i - bol + 1` — derived from the
# index it already has, never tracked. That is the whole reason this guest
# found a bug in `whence/lexer.py` the day it grew columns: the host
# INCREMENTS a `col` counter per character consumed, and its `#` branch
# advanced `i` to end of line without advancing `col`, so the NEWLINE (or
# EOF) token after a comment carried the `#`'s column. A derived column
# cannot forget to advance. 10 of the 16 git-tracked `examples/*.lang`
# files held at least one such token; see SPEC.md § v0.24.
fn lex(s, i, stack, acc, line, bol) {
  if i >= len(s) { push(acc, @{t: "eof", v: "", line: line, col: i - bol + 1}) }
  else if s[i] == "#" { lex(s, scan_while(s, i, fn(c) { c != "\n" }), stack, acc, line, bol) }
  else if s[i] == "\n" {
    let last_is_nl = len(acc) > 0 and acc[len(acc) - 1].t == "nl"
    if suppressed(stack, acc) or last_is_nl or len(acc) == 0 {
      lex(s, i + 1, stack, acc, line + 1, i + 1)
    } else {
      lex(s, i + 1, stack, push(acc, @{t: "nl", v: "\n", line: line, col: i - bol + 1}),
          line + 1, i + 1)
    }
  }
  # `\r` joined this branch in v0.21 (round 350). whence/lexer.py skips a
  # carriage return with `if c in " \\t\\r"` and always has, so a CRLF
  # file lexes under the host; the guest emitted `bad: unexpected
  # character` at the first CR. It could not have been written before
  # v0.21 added the `\\r` ESCAPE -- until then Whence had no way to
  # spell the character this line compares against.
  else if s[i] == " " or s[i] == "\t" or s[i] == "\r" { lex(s, i + 1, stack, acc, line, bol) }
  else if is_digit(s[i]) {
    let j0 = scan_while(s, i, is_digit)
    let has_frac = j0 + 1 < len(s) and s[j0] == "." and is_digit(s[j0 + 1])
    let j1 = if has_frac { scan_while(s, j0 + 1, is_digit) } else { j0 }
    let j = exp_end(s, j1)
    # v0.40 (round 410), decision 49. The literal door for numeric text now
    # enforces the same round-trip rule `num` always has, so the guest gets
    # a branch it could not have had before: until v0.40 the HOST accepted a
    # 4001-digit literal and this guest could not, because `lit_num` IS
    # `num` and `num` refused -- the divergence `bench/showtok.py`'s
    # KNOWN_DIVERGENT recorded. `j == j0` is "no fraction and no exponent
    # were consumed", i.e. INTEGER text; a float literal still overflows to
    # `pos_inf` and is not refused, because a float has no digits to print
    # back. The message is the host's, character for character
    # (`values.NUM_TEXT_LIMIT_MSG`), and `test_lexer_guest_parity.py` rule 3
    # is what keeps it so.
    if j == j0 and j - i > num_text_digit_limit {
      push(acc, @{t: "bad", v: str(j - i) + " digits is over the " +
                                str(num_text_digit_limit) +
                                "-digit limit for numeric text (str of a " +
                                "larger integer is a summary, not digits)",
                  line: line, col: i - bol + 1})
    } else {
      lex(s, j, stack, push(acc, @{t: "num", v: lit_num(slice(s, i, j)), line: line,
                                   col: i - bol + 1}), line, bol)
    }
  }
  else if is_name_start(s[i]) {
    let j = scan_while(s, i, is_name_cont)
    let word = slice(s, i, j)
    let kind = if contains(keywords, word) { "kw" } else { "name" }
    lex(s, j, stack, push(acc, @{t: kind, v: word, line: line, col: i - bol + 1}),
        line, bol)
  }
  else if s[i] == "\"" {
    let r = lex_str_body(s, i + 1, "", i)
    # v0.21 (round 350): `has(r, "err")` replaces `missed(r)`, and the bad
    # token now carries the bare message (see `lex_str_body`'s header) --
    # byte-identical to what whence/lexer.py's `LexError` carries, minus
    # the position, which a guest token has no field for.
    if has(r, "err") { push(acc, @{t: "bad", v: r.err, line: line, col: r.at - bol + 1}) }
    else { lex(s, r.pos, stack, push(acc, @{t: "str", v: r.v, line: line, col: i - bol + 1}),
               line, bol) }
  }
  else if i + 1 < len(s) and contains(two_char_ops, s[i] + s[i + 1]) {
    let op = s[i] + s[i + 1]
    let stack2 = if op == "@{" { stack + ["@{"] } else { stack }
    lex(s, i + 2, stack2, push(acc, @{t: "op", v: op, line: line, col: i - bol + 1}),
        line, bol)
  }
  else if contains(one_char_ops, s[i]) {
    let c = s[i]
    let stack2 = if c == "(" or c == "[" or c == "{" { stack + [c] }
      else if c == ")" or c == "]" or c == "}" { pop_last(stack) }
      else { stack }
    lex(s, i + 1, stack2, push(acc, @{t: "op", v: c, line: line, col: i - bol + 1}),
        line, bol)
  }
  else { push(acc, @{t: "bad", v: "unexpected character '" + s[i] + "'", line: line,
                     col: i - bol + 1}) }
}
fn lex_all(s) { lex(s, 0, [], [], 1, 0) }

# ---- token helpers ------------------------------------------------------
fn t_at(toks, pos) {
  if pos < len(toks) { toks[pos] } else { @{t: "eof", v: "", line: 0, col: 0} }
}
# v0.24 (round 360), decision 34. The clause every guest parse error ends
# with, in `whence/parser.py`'s own `ParseError` format ("%s at line %d,
# col %d") and built from the OFFENDING TOKEN. Wording is still not a
# host/guest contract (round 354 established that it never was); WHERE a
# program stops being legal now is, and `tests/test_parse_error_
# differential.py` compares exactly this suffix.
fn tok_at(toks, pos) {
  let k = t_at(toks, pos)
  " at line " + str(k.line) + ", col " + str(k.col)
}

fn is_op(toks, pos, o) { let k = t_at(toks, pos)
  k.t == "op" and k.v == o }
fn is_kw(toks, pos, w) { let k = t_at(toks, pos)
  k.t == "kw" and k.v == w }
fn skip_nl(toks, pos) { if is_ntype(toks, pos, "nl") { skip_nl(toks, pos + 1) } else { pos } }
fn is_ntype(toks, pos, ty) { t_at(toks, pos).t == ty }

# v0.36 (round 398), decision 45: how a token is NAMED in a message, and
# what was WANTED where it stood. `whence/parser.py`'s `_show` (v0.24,
# round 360) and `_spell_want` (v0.35, round 396) are the host's two
# halves of the same sentence; these are the guest's, and until this round
# the guest had neither.
#
# The got half was wrong in three different ways, not one. `expect_op`
# quoted UNCONDITIONALLY, so the EOF token -- whose `v` is the empty
# string -- printed `got ''` and a number printed `got '1'`: a field of
# the guest's own token record, not anything the author typed, which is
# exactly the defect v0.24 fixed on the host. `parse_primary`'s catch-all
# wrote `unexpected token 'X'` where the host writes `unexpected X`, and
# rendered the same two kinds the same wrong way. And `expect_name` wrote
# NO got half at all -- the kind round 396's want-half measurement could
# not see, because its shared set is defined by having one.
#
# v0.39 (round 408), decision 48. `quote_str` spells a string VALUE as the
# Whence literal that produces it -- the five escapes `whence/lexer.py`'s
# `_ESCAPES` can spell, and every other byte verbatim, so the rendering
# re-lexes to the input for all 256 of them. It replaces `repr_str`, which
# mirrored Python's `repr` including the quote-switching rule, and it needs
# no `contains` scan of the value to pick a quote character: Whence has one
# string syntax and this is it.
#
# Both of v0.36's residuals go with it, and neither by testing harder.
# The non-printable one goes because there is no `\xNN` rule left to
# mirror -- rendering an unspellable byte is now the IDENTITY, which a
# guest can do without being able to name the byte. (It was also never
# unreachable: the host lexer's string scanner copies every byte except
# `"`, `\` and a raw newline straight into the value, so a RAW NUL in
# source reaches a STRING token. v0.36 checked the ESCAPE spelling
# `"a\x00b"`, which is a different program, and concluded from its
# `bad escape` that the byte could not be reached.) The big-integer one
# goes because the HOST now calls `show_int` where it used to call `repr`,
# so `str(k.v)` on this side and `_show` on that side are the same rule.
#
# v0.40 (round 410), decision 49: that last sentence was true and it was
# not the whole story. Under the rendering fix the two sides still parted
# company at 4001 digits, because the HOST LEXER accepted a literal this
# guest's `lit_num` refused -- a divergence in what the language ACCEPTS,
# wearing a renderer's name. Decision 49 closed it at the other end: the
# literal door now enforces the digit bound `num` always had, on both
# sides, and `lex`'s integer branch below carries this guest's half.
fn quote_body(s, i, acc) {
  if i >= len(s) { acc }
  else {
    let c = s[i]
    let e = if c == "\\" { "\\\\" }
      else if c == "\"" { "\\\"" }
      else if c == "\n" { "\\n" }
      else if c == "\t" { "\\t" }
      else if c == "\r" { "\\r" }
      else { c }
    quote_body(s, i + 1, acc + e)
  }
}
fn quote_str(s) { "\"" + quote_body(s, 0, "") + "\"" }
fn show_tok(k) {
  if k.t == "eof" { "end of input" }
  else if k.t == "nl" { "a line break" }
  else if k.t == "num" { str(k.v) }
  else if k.t == "str" { quote_str(k.v) }
  else { "'" + str(k.v) + "'" }
}

# The want half. `expect_op`/`expect_name` keep their two-and-three
# argument shapes so the twenty-odd call sites that want the DEFAULT
# spelling read as before; the `_as` forms carry the seven host `what=`
# sites (`field name`, `parameter name`, `effect name`, `shape name`,
# `field name after '.'`, `'@{' after shape name`, and `a name` itself).
# One `expect_name` standing in for six different `what=` values is why
# `let r = @{a: 1,}` told a guest reader "expected a name" where the host
# says "expected field name, got '}'".
fn expect_op(toks, pos, o) { expect_op_as(toks, pos, o, "'" + o + "'") }
fn expect_op_as(toks, pos, o, what) {
  if is_op(toks, pos, o) { pos + 1 }
  else { miss ("expected " + what + ", got " + show_tok(t_at(toks, pos)) +
               tok_at(toks, pos)) }
}
fn expect_name(toks, pos) { expect_name_as(toks, pos, "a name") }
fn expect_name_as(toks, pos, what) {
  let k = t_at(toks, pos)
  if k.t == "name" { @{name: k.v, pos: pos + 1} }
  else { miss ("expected " + what + ", got " + show_tok(k) +
               tok_at(toks, pos)) }
}

# ---- expression parser (precedence low -> high, mirrors whence/parser.py) --
fn parse_expr(toks, pos) { parse_rescue(toks, pos) }

fn parse_rescue(toks, pos) {
  let first = parse_or(toks, pos)
  parse_rescue_rest(first.node, toks, first.pos)
}
fn parse_rescue_rest(left, toks, pos) {
  if is_kw(toks, pos, "rescue") {
    let right = parse_or(toks, pos + 1)
    parse_rescue_rest(@{kind: "binary", op: "rescue", left: left, right: right.node},
                       toks, right.pos)
  } else { @{node: left, pos: pos} }
}

fn parse_or(toks, pos) {
  let first = parse_and(toks, pos)
  parse_or_rest(first.node, toks, first.pos)
}
fn parse_or_rest(left, toks, pos) {
  if is_kw(toks, pos, "or") {
    let right = parse_and(toks, pos + 1)
    parse_or_rest(@{kind: "binary", op: "or", left: left, right: right.node}, toks, right.pos)
  } else { @{node: left, pos: pos} }
}

fn parse_and(toks, pos) {
  let first = parse_not(toks, pos)
  parse_and_rest(first.node, toks, first.pos)
}
fn parse_and_rest(left, toks, pos) {
  if is_kw(toks, pos, "and") {
    let right = parse_not(toks, pos + 1)
    parse_and_rest(@{kind: "binary", op: "and", left: left, right: right.node}, toks, right.pos)
  } else { @{node: left, pos: pos} }
}

fn parse_not(toks, pos) {
  if is_kw(toks, pos, "not") {
    let inner = parse_not(toks, pos + 1)
    @{node: @{kind: "unary", op: "not", operand: inner.node}, pos: inner.pos}
  } else { parse_cmp(toks, pos) }
}

let cmp_ops = ["==", "!=", "<", "<=", ">", ">="]
fn parse_cmp(toks, pos) {
  let left = parse_add(toks, pos)
  let k = t_at(toks, left.pos)
  if k.t == "op" and contains(cmp_ops, k.v) {
    let right = parse_add(toks, left.pos + 1)
    let k2 = t_at(toks, right.pos)
    if k2.t == "op" and contains(cmp_ops, k2.v) {
      miss ("comparisons do not chain; use 'and'" + tok_at(toks, right.pos))
    } else {
      @{node: @{kind: "binary", op: k.v, left: left.node, right: right.node}, pos: right.pos}
    }
  } else { left }
}

fn parse_add(toks, pos) {
  let first = parse_mul(toks, pos)
  parse_add_rest(first.node, toks, first.pos)
}
fn parse_add_rest(left, toks, pos) {
  if is_op(toks, pos, "+") or is_op(toks, pos, "-") {
    let op = t_at(toks, pos).v
    let right = parse_mul(toks, pos + 1)
    parse_add_rest(@{kind: "binary", op: op, left: left, right: right.node}, toks, right.pos)
  } else { @{node: left, pos: pos} }
}

fn parse_mul(toks, pos) {
  let first = parse_unary(toks, pos)
  parse_mul_rest(first.node, toks, first.pos)
}
fn parse_mul_rest(left, toks, pos) {
  if is_op(toks, pos, "*") or is_op(toks, pos, "/") or is_op(toks, pos, "%") {
    let op = t_at(toks, pos).v
    let right = parse_unary(toks, pos + 1)
    parse_mul_rest(@{kind: "binary", op: op, left: left, right: right.node}, toks, right.pos)
  } else { @{node: left, pos: pos} }
}

fn parse_unary(toks, pos) {
  let k = t_at(toks, pos)
  if is_op(toks, pos, "-") {
    let inner = parse_unary(toks, pos + 1)
    @{node: @{kind: "unary", op: "-", operand: inner.node}, pos: inner.pos}
  } else if k.t == "kw" and (k.v == "why" or k.v == "snip" or k.v == "miss") {
    let inner = parse_unary(toks, pos + 1)
    @{node: @{kind: "unary", op: k.v, operand: inner.node}, pos: inner.pos}
  } else { parse_postfix(toks, pos) }
}

fn parse_postfix(toks, pos) {
  let first = parse_primary(toks, pos)
  parse_postfix_rest(first.node, toks, first.pos)
}
fn parse_postfix_rest(expr, toks, pos) {
  if is_op(toks, pos, "(") {
    let a = parse_args(toks, pos + 1, [])
    parse_postfix_rest(@{kind: "call", func: expr, args: a.args}, toks, a.pos)
  } else if is_op(toks, pos, "[") {
    let ix = parse_expr(toks, pos + 1)
    let after = expect_op(toks, ix.pos, "]")
    parse_postfix_rest(@{kind: "index", obj: expr, index: ix.node}, toks, after)
  } else if is_op(toks, pos, ".") {
    let fld = expect_name_as(toks, pos + 1, "field name after '.'")
    parse_postfix_rest(@{kind: "field", obj: expr, name: fld.name}, toks, fld.pos)
  } else { @{node: expr, pos: pos} }
}
# v0.24 (round 360): `parse_args_rest` exists so that the empty-list test
# is the ENTRY branch and not also the after-a-comma branch. Before the
# split, `f(1,)` recursed back into `parse_args`, met `)`, and returned a
# one-argument call -- the host refuses it (`unexpected ')'`). Same edit in
# `parse_list_lit`, `parse_record_lit`, `parse_params`, `parse_shape_fields`
# and `skip_effect_names`: FIVE list-like constructs plus the effects
# clause, all silently more permissive than the host, none of them visible
# to any differential this program had, because every corpus it ever fed
# the two parsers held only programs that PARSE.
fn parse_args(toks, pos, acc) {
  if is_op(toks, pos, ")") { @{args: acc, pos: pos + 1} }
  else { parse_args_rest(toks, pos, acc) }
}
fn parse_args_rest(toks, pos, acc) {
  let a = parse_expr(toks, pos)
  let acc2 = push(acc, a.node)
  if is_op(toks, a.pos, ",") { parse_args_rest(toks, a.pos + 1, acc2) }
  else {
    let after = expect_op(toks, a.pos, ")")
    @{args: acc2, pos: after}
  }
}

fn parse_primary(toks, pos) {
  let k = t_at(toks, pos)
  if k.t == "num" { @{node: @{kind: "num", value: k.v}, pos: pos + 1} }
  else if k.t == "str" { @{node: @{kind: "str", value: k.v}, pos: pos + 1} }
  else if k.t == "kw" and (k.v == "true" or k.v == "false") {
    @{node: @{kind: "bool", value: k.v == "true"}, pos: pos + 1}
  }
  else if k.t == "name" { @{node: @{kind: "name", value: k.v}, pos: pos + 1} }
  else if is_op(toks, pos, "[") { parse_list_lit(toks, pos + 1, []) }
  else if is_op(toks, pos, "@{") { parse_record_lit(toks, pos + 1, [], []) }
  else if is_op(toks, pos, "(") {
    let inner = parse_expr(toks, pos + 1)
    @{node: inner.node, pos: expect_op(toks, inner.pos, ")")}
  }
  else if k.t == "kw" and k.v == "if" { parse_if(toks, pos) }
  else if is_op(toks, pos, "{") { parse_block(toks, pos) }
  # v0.34 (round 392): the `and is_op(toks, pos + 1, "(")` guard that used
  # to sit on this branch is GONE, and its removal is a v0.24 rule-2 fix.
  # `let g = fn adder(a, b) { a + b }` is refused by both parsers and used
  # to be refused in two different PLACES: the host consumes `fn` and lets
  # `param_list`'s `expect("(")` report at `adder` (col 12), while this
  # guard declined the whole branch and let the fallback report at `fn`
  # (col 9). A position is a fact about the program under analysis
  # (decision 34) and the fact here is the NAME. The guard was also
  # unnecessary: statement position already claims `fn NAME` (see
  # `parse_stmt`), so any `fn` that reaches `parse_primary` is an
  # anonymous fn or a mistake, which is exactly what the host assumes.
  # Found by `tests/test_v34.py`'s five-case fast-tier position check --
  # NOT by `test_parse_error_differential.py`'s 47-program sweep, whose
  # corpus never contained a named `fn` in expression position. A case is
  # now added there too.
  else if k.t == "kw" and k.v == "fn" {
    let ps = parse_params(toks, pos + 1, [], [])
    let ep = parse_effects_clause(toks, ps.pos)
    let rt = parse_typed_suffix(toks, ep, "->")
    let body0 = parse_block(toks, rt.pos)
    @{node: @{kind: "fnexpr", params: ps.params, ret_type: rt.spec,
              param_types: build_param_contracts(ps.params, ps.types, 0, [], ""),
              body: body0.node},
      pos: body0.pos}
  }
  else { miss ("unexpected " + show_tok(k) + tok_at(toks, pos)) }
}

fn parse_list_lit(toks, pos, acc) {
  if is_op(toks, pos, "]") { @{node: @{kind: "list", items: acc}, pos: pos + 1} }
  else { parse_list_rest(toks, pos, acc) }
}
fn parse_list_rest(toks, pos, acc) {
  let it = parse_expr(toks, pos)
  let acc2 = push(acc, it.node)
  if is_op(toks, it.pos, ",") { parse_list_rest(toks, it.pos + 1, acc2) }
  else { @{node: @{kind: "list", items: acc2}, pos: expect_op(toks, it.pos, "]")} }
}
fn parse_record_lit(toks, pos, acc, seen) {
  if is_op(toks, pos, "}") { @{node: @{kind: "record", pairs: acc}, pos: pos + 1} }
  else { parse_record_rest(toks, pos, acc, seen) }
}
fn parse_record_rest(toks, pos, acc, seen) {
  let key = expect_name_as(toks, pos, "field name")
  let dup = contains(seen, key.name)
  let after_colon = expect_op(toks, key.pos, ":")
  let val = parse_expr(toks, after_colon)
  let pair = @{name: key.name, value: val.node}
  let acc2 = push(acc, pair)
  let seen2 = push(seen, key.name)
  let step = if dup { miss ("duplicate field '" + key.name + "'" + tok_at(toks, pos)) }
    else if is_op(toks, val.pos, ",") { parse_record_rest(toks, val.pos + 1, acc2, seen2) }
    else { @{node: @{kind: "record", pairs: acc2}, pos: expect_op(toks, val.pos, "}")} }
  step
}

# ---- params, blocks, if -----------------------------------------------------
# Type annotations (v0.12/v0.13 guest parity, round 158): `: TAG` on a
# param, `-> TAG` after the param list. Round 338 closed the last gap: a
# type name is now the same TWO things the host's `parse_type` accepts — a
# primitive tag (num str bool list record fn any guess) or a `shape`
# DECLARED EARLIER IN THIS FILE. Anything else is still an "unknown type"
# miss, the same total-error discipline as every other parse failure here.
# v0.15 guest parity (round 176): "guess" joined the host's PRIMITIVE_TYPES
# when the AI-native-primitives feature shipped (round 168), so `fn f(x:
# guess)` must type-check in the guest exactly as it already does at the
# host (verified: `typed(guess(5,0.9,"s"), "guess", "lbl")` is a pass-through,
# `typed(5, "guess", "lbl")` misses "expected guess, got num").
let guest_primitive_types = ["num", "str", "bool", "list", "record", "fn",
                             "any", "guess"]

# ---- `shape` declarations (v0.12 guest parity, round 338; scoped in v0.18,
# ---- round 342) ------------------------------------------------------------
# The host parser carries MUTABLE state for this: `shape_def()` writes a name
# into a scope frame once that declaration finishes, and `parse_type()`
# accepts any name visible from the frame stack. Whence has no mutation, and
# threading a shapes accumulator down would not be enough either: an
# annotation can appear inside an anonymous `fn(a: Point)` anywhere an
# expression can, so every one of the ~25 parser functions would have to
# RETURN the accumulator as well as take it, the whole expression parser
# included.
#
# The guest recovers the state from the TOKEN STREAM instead. The host is
# strictly left-to-right, so at any token position p its shape table is a
# pure function of (toks, p), no threading at all. Three details make that
# exact rather than merely close:
#   * the three tokens must be ADJACENT (`shape` NAME `=`), which is what the
#     host's own `peek(1)`/`peek(2)` require — they do not skip newlines, so
#     `shape` on its own line is NOT a declaration on either side (the host
#     says "unexpected '=' at line 2"), and since NAME NAME never occurs
#     adjacently inside any legal Whence expression, a match can only be at
#     statement start, exactly where the host tests for it;
#   * the declaration must have CLOSED before p (`shape_close` below), which
#     is what rejects `shape Foo = @{x: Foo}` — the host has not yet
#     registered the name while it is parsing its own field types;
#   * (v0.18) the BLOCK the declaration sits in must not have closed before p
#     either. The host pushes one frame per `stmt_list`, i.e. one per `{`;
#     the guest replays exactly that from the brackets themselves
#     (`shape_rel_depth`), counting `{` and `@{` up and `}` down. A record
#     literal's `@{ … }` is balanced, so including it shifts every position
#     inside it by the same constant and never changes an answer — only
#     differences of depth are ever compared.
# `shape_rel_depth` returns the block depth at `limit` RELATIVE to a
# declaration that ended just before `i`, or -1 if the declaring block itself
# closed on the way. So `>= 0` is "still in scope at p" and `== 0` is
# "declared in the very block p sits in" — which is the pair the host reads
# off `self.shape_scopes` as "any frame" vs. "the top frame".
# Cost: `shapes_before` is only ever reached for a name that is NOT a
# primitive tag, so every program written before round 338 — including every
# program `harness/swe/fuzz.py` emits, whose TYPE_TAGS are primitives only —
# pays exactly nothing for it.
fn is_shape_head(toks, i) {
  let k = t_at(toks, i)
  k.t == "name" and k.v == "shape" and is_ntype(toks, i + 1, "name") and
    is_op(toks, i + 2, "=")
}

# index of the `}` closing the record literal that starts at `pos`; `depth`
# starts at 0 so the opening `@{` is what raises it to 1. A malformed
# declaration just runs to eof and reports that index — the real parse below
# is what turns it into a message.
fn shape_close(toks, pos, depth) {
  let k = t_at(toks, pos)
  if k.t == "eof" { pos }
  else if k.t == "op" and (k.v == "@{" or k.v == "{") {
    shape_close(toks, pos + 1, depth + 1)
  }
  else if k.t == "op" and k.v == "}" and depth <= 1 { pos }
  else if k.t == "op" and k.v == "}" { shape_close(toks, pos + 1, depth - 1) }
  else { shape_close(toks, pos + 1, depth) }
}

fn shape_rel_depth(toks, i, limit, rel) {
  if i >= limit { rel }
  else {
    let k = t_at(toks, i)
    if k.t == "eof" { rel }
    else if k.t == "op" and (k.v == "@{" or k.v == "{") {
      shape_rel_depth(toks, i + 1, limit, rel + 1)
    }
    else if k.t == "op" and k.v == "}" and rel == 0 { 0 - 1 }
    else if k.t == "op" and k.v == "}" {
      shape_rel_depth(toks, i + 1, limit, rel - 1)
    }
    else { shape_rel_depth(toks, i + 1, limit, rel) }
  }
}

# `want` picks which of the three questions this scan answers:
# Each entry is `@{n: name, ln: line}` since v0.38 (round 404) — the three
# questions below are answered by membership, and the fourth, which the
# redeclaration MESSAGE asks, is answered by `ln`.
#   "any"   — declared anywhere earlier in the file. Diagnostics only: it is
#             what separates "unknown type" (a typo) from "not in scope here"
#             (a real declaration in a block that has closed). Mirrors the
#             host's `shapes_seen`.
#   "scope" — visible at `limit` (host: any frame of `shape_scopes`).
#   "block" — declared in the very block `limit` sits in (host: the TOP
#             frame), which is what makes a redeclaration an error while a
#             shadowing declaration one block in is fine.
fn shapes_before(toks, limit, want, i, acc) {
  if i + 2 >= limit { acc }
  else {
    let close = if is_shape_head(toks, i) { shape_close(toks, i + 3, 0) }
      else { limit }
    let rel = if close < limit and want != "any" {
      shape_rel_depth(toks, close + 1, limit, 0)
    } else { 0 }
    let keep = close < limit and
      (want == "any" or (want == "scope" and rel >= 0) or
       (want == "block" and rel == 0))
    # v0.38 (round 404), decision 47: a NAME was all three questions ever
    # needed; the fourth one -- "which line was it declared on" -- needs a
    # record, so this accumulates `@{n, ln}`, the same shape v0.37 gave
    # `bound`, and is read back by the same `bound_line`. `t_at(toks, i)`
    # is the `shape` KEYWORD (`is_shape_head` is what put us here), which
    # is the token the host's `shape_def` reads its `tok.line` from.
    let acc2 = if keep {
      push(acc, @{n: (t_at(toks, i + 1)).v, ln: (t_at(toks, i)).line})
    } else { acc }
    shapes_before(toks, limit, want, i + 1, acc2)
  }
}

fn expect_type_name(toks, pos) {
  let k = t_at(toks, pos)
  let name = if k.t == "kw" and k.v == "fn" { "fn" }
    else if k.t == "name" { k.v } else { "" }
  if name == "" { miss ("expected a type name" + tok_at(toks, pos)) }
  else if contains(guest_primitive_types, name) {
    @{type: name, spec: spec_node(name), pos: pos + 1}
  }
  # v0.38: `bound_line(...) != 0` IS the membership test these two used to
  # spell `contains`, because a line is >= 1 and `0` is the absent
  # sentinel -- the same fact `test_v37.py::test_zero_is_a_safe_absent_
  # sentinel_for_a_line` already pins. One lookup, two tables.
  else if bound_line(shapes_before(toks, pos, "scope", 0, []), name, 0) != 0 {
    @{type: name, spec: name_node(name), pos: pos + 1}
  }
  else if bound_line(shapes_before(toks, pos, "any", 0, []), name, 0) != 0 {
    miss ("type '" + name + "' is not in scope here" + tok_at(toks, pos))
  }
  else { miss ("unknown type '" + name + "'" + tok_at(toks, pos)) }
}

# optional `TRIGGER TAG` (`:` for a param, `->` for a return type); absent
# is `@{type: "", spec: "", pos: pos}` — "" is the same no-annotation
# sentinel `guest_tag` already uses for "no __tag field".
#
# `spec` (round 338) is the AST node a `typed()` guard reads its spec FROM,
# mirroring the host's `_type_spec_expr` exactly: a `str` node holding the
# tag for a primitive, a `name` node for a shape. A NameRef, not a copy of
# the shape record, is what makes nested shapes the SAME value on both sides
# — `shape Line = @{a: Point, b: Point}` reads the one binding `Point` names.
fn parse_typed_suffix(toks, pos, trigger) {
  if is_op(toks, pos, trigger) { expect_type_name(toks, pos + 1) }
  else { @{type: "", spec: "", pos: pos} }
}

fn parse_params(toks, pos, acc, tacc) {
  let after_paren = expect_op(toks, pos, "(")
  if is_op(toks, after_paren, ")") { @{params: acc, types: tacc, pos: after_paren + 1} }
  else { parse_params_rest(toks, after_paren, acc, tacc) }
}
fn parse_params_rest(toks, pos, acc, tacc) {
  let nm = expect_name_as(toks, pos, "parameter name")
  let dup = contains(acc, nm.name)
  let acc2 = push(acc, nm.name)
  let tr = parse_typed_suffix(toks, nm.pos, ":")
  let tacc2 = push(tacc, tr.spec)
  if dup { miss ("duplicate parameter '" + nm.name + "'" + tok_at(toks, pos)) }
  else if is_op(toks, tr.pos, ",") { parse_params_rest(toks, tr.pos + 1, acc2, tacc2) }
  else { @{params: acc2, types: tacc2, pos: expect_op(toks, tr.pos, ")")} }
}

# ---- parameter contracts (v0.19 guest parity, round 344) -------------------
# Mirrors whence/parser.py's `_param_contracts`. From v0.12 (round 122) to
# v0.18 this was `apply_type_guards`, which PREPENDED one
# `let <param> = typed(<param>, spec, label)` statement per annotated
# parameter to the body — pure parser-level desugaring, no evaluator
# involvement at all. v0.19 carries the same four facts on the fn NODE
# instead, so the EVALUATOR resolves a parameter's spec in the DEFINING env
# at closure-creation time, exactly where and when it already resolves a
# `-> Type` (`resolve_param_specs` / `check_contract` below, SPEC decision
# 29). The desugaring had to go for the spec to move: a statement inside
# the body can only ever be evaluated in the CALL env.
fn spec_node(tag) { @{kind: "str", value: tag} }
fn name_node(n) { @{kind: "name", value: n} }

# `types` holds SPEC NODES (round 338), not type-name strings: the node
# `expect_type_name` already built, so a shape contract reads `Point` by
# name and a primitive one is the string literal it always was. "" is still
# the no-annotation sentinel, and `<record> == ""` is an ordinary host
# `false` (deep_eq resolves a type mismatch at the top level without
# descending), so the unannotated fast path is unchanged — `[]` out, one
# comparison per parameter, nothing attached to the node.
#
# `index` is the parameter's POSITION. The host drops it after parsing
# (`_closure_params` looks its bindings up by name, since a host call env
# is a dict); the guest keeps it because `bind_params` below walks
# parameters positionally, so position is the cheaper key on this side.
# Both spellings answer the same question, which is why the canonical form
# in tests/test_parser_differential.py compares the index too.
fn build_param_contracts(params, types, i, acc, suffix) {
  if i >= len(params) { acc }
  else {
    let spec = types[i]
    let acc2 = if spec == "" { acc }
      else {
        push(acc, @{index: i, name: params[i], spec: spec,
                    label: "parameter '" + params[i] + "'" + suffix})
      }
    build_param_contracts(params, types, i + 1, acc2, suffix)
  }
}

# ---- effects clause skip (guest parity, round 164) --------------------------
# `effects [name, ...]` sits between the param list and an optional
# `-> Type` (v0.14, SPEC.md; fixed order — same as the host). This function
# recognizes and SKIPS the clause so v0.14 programs PARSE on the guest —
# round 162 taught the fuzzer to generate `effects [...]` and had to no-op
# it for `GuestGen` (`harness/swe/guest.py`) because this file choked on
# the bare NAME('effects') token with "unexpected token 'effects'".
#
# The guest does NOT enforce the declaration. The host's
# `_check_effect_call` is a parse-time check threaded through
# `self.effects_stack`, consulted at EVERY call site the recursive descent
# visits (from `parse_stmt`/`parse_primary` down through
# `parse_postfix_rest`) — reproducing it here would mean threading an
# extra "current effects scope" argument through every one of those
# functions, a materially bigger change than return-type erasure was
# (that one only ever touched the single point where a function's own
# param list meets its own body — no threading through the whole
# expression grammar). Skip-and-parse closes the gap that actually blocked
# guest interpretation of otherwise-valid v0.14 source (`examples/
# effects.lang` itself never violates its own declarations, so it agrees
# with the host guest-vs-host either way); staying permissive where the
# host would reject is a known, deliberate, documented divergence, same
# category as the guest-provenance/why differences already listed at the
# top of this file. `harness/swe/guest.py`'s `GuestGen.maybe_effects`
# override stays a no-op for the FUZZER specifically: the grammar's
# `EFFECT_TAG_SETS` deliberately includes `[]`/`[net]` to fuzz the REJECT
# path (`harness/swe/fuzz.py`), and a guest that parses-but-doesn't-enforce
# would silently diverge (host ParseError vs. guest success) on exactly
# those generated programs — real reject-path fuzz coverage needs the full
# threaded check, not this.
fn parse_effects_clause(toks, pos) {
  let k = t_at(toks, pos)
  if k.t == "name" and k.v == "effects" and is_op(toks, pos + 1, "[") {
    skip_effect_names(toks, pos + 2)
  } else { pos }
}

fn skip_effect_names(toks, pos) {
  if is_op(toks, pos, "]") { pos + 1 }
  else { skip_effect_names_rest(toks, pos) }
}
fn skip_effect_names_rest(toks, pos) {
  let nm = expect_name_as(toks, pos, "effect name")
  if is_op(toks, nm.pos, ",") { skip_effect_names_rest(toks, nm.pos + 1) }
  else { expect_op(toks, nm.pos, "]") }
}

fn parse_block(toks, pos) {
  let open = expect_op(toks, pos, "{")
  let sl = parse_stmt_list(toks, skip_nl(toks, open), "}", [], [])
  let after = expect_op(toks, sl.pos, "}")
  if len(sl.stmts) == 0 {
    miss ("block must contain at least one expression" + tok_at(toks, pos))
  }
  else if (sl.stmts[len(sl.stmts) - 1]).kind != "exprstmt" {
    miss ("block must end with an expression" + tok_at(toks, sl.pos))
  } else { @{node: @{kind: "block", stmts: sl.stmts}, pos: after} }
}

# `end` is either the literal "}" (an operator token) or the string "eof"
# (the sentinel type, NOT an operator) — a block ends on an op, the program
# ends on the real EOF token, and the two are different token *types*, so
# they need different tests (an earlier version used is_op for both, which
# can never match "eof" and looped forever re-parsing synthetic EOF tokens).
fn at_end(toks, pos, end) {
  if end == "eof" { is_ntype(toks, pos, "eof") } else { is_op(toks, pos, end) }
}

# v0.23 guest parity (round 356), decision 33: the tokens a STATEMENT can
# begin with, read off the host's `_STARTS_STATEMENT_TYPES` /
# `_STARTS_STATEMENT_KWS` and, like them, off nothing else. `shape` is a
# soft keyword and lexes as a `name`, so it needs no entry of its own.
#
# The missing-separator error is raised only for these. Everything else is
# a token that can never start a statement at all -- `x = 2` is an attempted
# assignment, not two statements -- and must fall through to `parse_stmt`,
# which already refuses it with the more specific message. The host makes
# exactly this distinction for exactly this reason; a guest that raised the
# separator error for every leftover token would diverge on `missed`-ness
# nowhere but would report the wrong thing everywhere.
let stmt_start_kws = ["let", "fn", "check", "if", "true", "false",
                      "why", "snip", "miss", "not"]
let stmt_start_ops = ["[", "@{", "(", "{", "-"]

fn starts_stmt(toks, pos) {
  let k = t_at(toks, pos)
  if k.t == "kw" { contains(stmt_start_kws, k.v) }
  else if k.t == "op" { contains(stmt_start_ops, k.v) }
  else { k.t == "num" or k.t == "str" or k.t == "name" }
}

# v0.37 (round 402), decision 46: the binding table records WHERE a name was
# bound, not merely THAT it was. `whence/parser.py`'s `stmt_list` keeps
# `bound[name] = s.line` and spends it in the sentence -- `'a' is already
# bound in this block (line 1); Whence has no rebinding` -- so a reader is
# told which line to look at for the binding they collided with. The guest
# kept a list of bare NAMES and could only say `'a' already bound`, and that
# was the LAST divergence in `tests/test_parse_error_differential.py` which
# was neither a host-only hint nor a rendering (round 398's item 1).
#
# It is a DATA change, not a wording change. `bound` becomes a list of
# `@{n: name, ln: line}` records and this is the lookup. Whence has no dict,
# so the scan is linear and written out; the host's `dict` and this loop
# answer the same question, and a single block with enough bindings for the
# difference to matter is not a program this parser is asked to be fast on.
#
# `0` is the absent sentinel: `whence/lexer.py` numbers lines from 1, which
# `tests/test_v37.py::test_zero_is_a_safe_absent_sentinel_for_a_line` pins
# so it stays true. The synthetic eof record `t_at` returns past the end of
# the token list carries `line: 0`, and it is never a binding's head token
# -- `at_end` has already closed the block before `parse_stmt` could run.
fn bound_line(bound, nm, i) {
  if i >= len(bound) { 0 }
  else if bound[i].n == nm { bound[i].ln }
  else { bound_line(bound, nm, i + 1) }
}

fn parse_stmt_list(toks, pos, end, acc, bound) {
  if at_end(toks, pos, end) { @{stmts: acc, pos: pos} }
  else {
    # v0.37: the head token, captured BEFORE the statement is parsed -- which
    # is exactly what the host does (`start = self.peek()` on the line above
    # its own `self.statement()`). The guest has no AST line field to copy,
    # so it reconstructs the host's `(line N)` from this token; `bench/
    # bindline.py` measured 1083 binding statements over the whole example
    # corpus and found the head token's line equal to the node's line every
    # time, which is what makes the reconstruction exact and not a guess.
    let head = t_at(toks, pos)
    let s = parse_stmt(toks, pos)
    let nm = if s.node.kind == "let" or s.node.kind == "fndef" { s.node.name } else { "" }
    let first = if nm == "" { 0 } else { bound_line(bound, nm, 0) }
    let bound2 = if nm != "" { push(bound, @{n: nm, ln: head.line}) } else { bound }
    if first != 0 {
      miss ("'" + nm + "' is already bound in this block (line " + str(first) +
            "); Whence has no rebinding" + tok_at(toks, pos))
    }
    else {
      let acc2 = push(acc, s.node)
      let after = skip_nl(toks, s.pos)
      # `after == s.pos` means `skip_nl` found no newline: two statements are
      # touching. Only between them -- `at_end` above is what closes the
      # block, so nothing is required before the first statement or after
      # the last.
      if at_end(toks, after, end) { @{stmts: acc2, pos: after} }
      else if after == s.pos and starts_stmt(toks, after) {
        miss ("two statements on one line" + tok_at(toks, after))
      }
      else { parse_stmt_list(toks, after, end, acc2, bound2) }
    }
  }
}

# `shape Name = @{field: type, …}` is PURE SUGAR (host `shape_def`): it
# desugars to `let Name = @{__shape: "Name", field: <spec>, …}` and reaches
# `parse_stmt_list` as an ordinary `let` node, so the no-rebinding rule
# applies to a shape name for free and the shape is an ordinary runtime
# record that `matches(x, Name)` and nested shape fields read by name.
#
# The three declaration-time errors are the host's three, in the host's
# order — reserved primitive name, already-declared shape, duplicate field.
# Whence evaluates `let` bindings eagerly, so `fields` below is computed
# before the two name tests are reached; that costs nothing and cannot
# reorder a message, because a miss is a VALUE here (the reserved/duplicate
# branches simply never read it) and the success branch propagates whatever
# `fields` became, exactly like every other parse failure in this file.
fn parse_shape_fields(toks, pos, acc, seen) {
  if is_op(toks, pos, "}") { @{pairs: acc, pos: pos + 1} }
  else { parse_shape_fields_rest(toks, pos, acc, seen) }
}
fn parse_shape_fields_rest(toks, pos, acc, seen) {
  let f = expect_name_as(toks, pos, "field name")
  let dup = contains(seen, f.name)
  let after_colon = expect_op(toks, f.pos, ":")
  let ft = expect_type_name(toks, after_colon)
  let acc2 = push(acc, @{name: f.name, value: ft.spec})
  let seen2 = push(seen, f.name)
  if dup { miss ("duplicate field '" + f.name + "'" + tok_at(toks, pos)) }
  else if is_op(toks, ft.pos, ",") { parse_shape_fields_rest(toks, ft.pos + 1, acc2, seen2) }
  else { @{pairs: acc2, pos: expect_op(toks, ft.pos, "}")} }
}

fn parse_shape_def(toks, pos) {
  let nm = expect_name_as(toks, pos + 1, "shape name")
  let after_eq = expect_op(toks, nm.pos, "=")
  let after_brace = expect_op_as(toks, after_eq, "@{", "'@{' after shape name")
  let head = @{name: "__shape", value: spec_node(nm.name)}
  let fields = parse_shape_fields(toks, after_brace, [head], [])
  # v0.38 (round 404), decision 47. `redecl` is the line of the earlier
  # declaration in THIS block, or 0. It is computed eagerly, one `let`
  # earlier than the branch that spends it, for the same reason `fields`
  # above is: a number cannot reorder a message, and the alternative is
  # scanning the token stream twice to print one integer.
  let redecl = bound_line(shapes_before(toks, pos, "block", 0, []), nm.name, 0)
  if contains(guest_primitive_types, nm.name) {
    miss ("'" + nm.name + "' is a reserved type name" + tok_at(toks, pos + 1))
  }
  else if redecl != 0 {
    miss ("shape '" + nm.name + "' is already declared in this block (line " +
          str(redecl) + ")" + tok_at(toks, pos + 1))
  }
  else {
    @{node: @{kind: "let", name: nm.name,
              value: @{kind: "record", pairs: fields.pairs}},
      pos: fields.pos}
  }
}

fn parse_stmt(toks, pos) {
  if is_kw(toks, pos, "let") {
    let nm = expect_name(toks, pos + 1)
    let after_eq = expect_op(toks, nm.pos, "=")
    let v = parse_expr(toks, after_eq)
    @{node: @{kind: "let", name: nm.name, value: v.node}, pos: v.pos}
  }
  else if is_kw(toks, pos, "fn") and is_ntype(toks, pos + 1, "name") {
    let nm = expect_name(toks, pos + 1)
    let ps = parse_params(toks, nm.pos, [], [])
    let ep = parse_effects_clause(toks, ps.pos)
    let rt = parse_typed_suffix(toks, ep, "->")
    let body0 = parse_block(toks, rt.pos)
    @{node: @{kind: "fndef", name: nm.name, params: ps.params, ret_type: rt.spec,
              param_types: build_param_contracts(ps.params, ps.types, 0, [],
                                                 " of " + nm.name),
              body: body0.node},
      pos: body0.pos}
  }
  else if is_kw(toks, pos, "check") {
    # v0.24 (round 360): the miss is the RESULT, not a field of it. It used
    # to be bound to `label` and stored in the node -- a miss inside a
    # record field is an ordinary value, so `check 1: 1 == 1` produced a
    # perfectly good `check` node whose label happened to be a failure, and
    # `parse_whence` returned success for a program the host refuses. The
    # only acceptance divergence in this file that was a MISSING refusal
    # rather than an over-permissive grammar rule.
    let k = t_at(toks, pos + 1)
    if k.t != "str" {
      miss ("expected a string label after 'check', got " + show_tok(k) +
            tok_at(toks, pos + 1))
    } else {
      let after_colon = expect_op(toks, pos + 2, ":")
      let e = parse_expr(toks, after_colon)
      @{node: @{kind: "check", label: k.v, expr: e.node}, pos: e.pos}
    }
  }
  else if is_shape_head(toks, pos) { parse_shape_def(toks, pos) }
  else {
    let e = parse_expr(toks, pos)
    @{node: @{kind: "exprstmt", expr: e.node}, pos: e.pos}
  }
}

fn parse_if(toks, pos) {
  let cond = parse_expr(toks, pos + 1)
  let then = parse_block(toks, cond.pos)
  let after_then = skip_nl(toks, then.pos)
  if is_kw(toks, after_then, "else") {
    let after_else = after_then + 1
    let other = if is_kw(toks, after_else, "if") { parse_if(toks, after_else) }
      else { parse_block(toks, after_else) }
    @{node: @{kind: "if", cond: cond.node, then: then.node, otherwise: other.node},
      pos: other.pos}
  } else {
    miss ("'if' requires 'else'" + tok_at(toks, after_then))
  }
}

# ---- top level ---------------------------------------------------------
fn parse_program(toks) {
  let sl = parse_stmt_list(toks, skip_nl(toks, 0), "eof", [], [])
  if is_ntype(toks, sl.pos, "eof") { @{kind: "program", stmts: sl.stmts} }
  else { miss ("trailing input" + tok_at(toks, sl.pos)) }
}
# v0.24 (round 360): a LEX error is reported as a lex error. The `bad`
# token used to fall through to `parse_primary`'s catch-all, which reported
# `unexpected token 'unterminated string' at line 1` -- the lexer's message
# wedged into the slot where a token's TEXT goes. `whence/lexer.py` raises
# before `parse` is ever called, so the host says `unterminated string at
# line 1, col 9` and nothing about tokens; `lex` stops at the first bad
# character, so the bad token is always the last one.
fn lex_error_of(toks) {
  let last = t_at(toks, len(toks) - 1)
  if last.t == "bad" { last.v + tok_at(toks, len(toks) - 1) } else { "" }
}
fn parse_whence(src) {
  let toks = lex_all(src)
  let le = lex_error_of(toks)
  if le != "" { miss le } else { parse_program(toks) }
}


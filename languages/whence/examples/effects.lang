# effects.lang — a minimal effect system (v0.14): `effects [...]` declares
# which effectful builtins a function's OWN body may call directly, checked
# entirely at PARSE time (unlike `: Type`/`-> Type`, which check a runtime
# value — whether a function's text names an effectful builtin is a static
# property, decidable before the program ever runs).

# `effects []` promises "this function performs no direct effects". The
# promise is enforced: a version of `total` that slipped a stray `print`
# into its body would fail to PARSE, not run and misbehave.
fn total(prices) effects [] {
  fold(fn(acc, p) { acc + p }, 0, prices)
}

let prices = [10, 20, 30]
check "a declared-pure function computes normally": total(prices) == 60

# `effects [io]` grants the one effectful builtin that exists today
# (`print`, tagged "io" in the parser's effect table).
fn report(label, value) effects [io] {
  print(label + ": " + str(value))
  value
}
check "an io-declared function may print": report("total", total(prices)) == 60

# Combine with a return type (v0.13) — fixed order, effects before `->`.
fn audited_total(prices) effects [io] -> num {
  print("auditing " + str(len(prices)) + " prices")
  total(prices)
}
check "effects and a return type compose": audited_total(prices) == 60

# The check is SHALLOW by design: a declaration only vouches for the
# function's own textual body, not the whole call tree. `total` (declared
# pure above) is free to call `fold`'s callback, and `report` above is
# free to call `total` — a pure function calling another function is
# never itself an "effect", only literally naming `print(...)` is.
#
# v0.14.1: a nested function DEFINED inside a pure body now INHERITS that
# purity by default — `debug_print` below has no clause of its own, so it
# lexically inherits `strict_sum`'s `effects []`, and a bare `print` inside
# it is a ParseError, exactly as if `strict_sum` had printed directly.
# Only an EXPLICIT clause on the nested fn can still opt back in — an
# explicit declaration always overrides the inherited scope, the same
# "one settle point" rule a top-level fn's own clause uses.
fn strict_sum(xs) effects [] {
  fn debug_print(x) effects [io] { print("(debug) " + str(x)) }
  fold(fn(acc, x) { debug_print(x) acc + x }, 0, xs)
}
check "a nested fn may still print, but only via its OWN explicit effects [io]":
  strict_sum(prices) == 60

# v0.14.2: passing an effectful builtin AS A VALUE and calling it back out
# is now tracked too — `let logger = print` makes `logger` a direct alias
# of `print`, checked against the enclosing scope exactly as `print(...)`
# itself would be. `log_total` below is `effects [io]`, so the alias call
# is granted, same as a direct call would be.
fn log_total(prices) effects [io] {
  let logger = print
  logger("logged total: " + str(total(prices)))
  total(prices)
}
check "an aliased builtin is checked the same as calling it directly":
  log_total(prices) == 60
# Writing `let logger = print` inside `total`'s own `effects []` body
# instead would be a ParseError at `logger(...)`, not a silent escape —
# the alias is checked at the point it is CALLED, not where it is bound.
# Still shallow, on purpose: passing `print` as a function ARGUMENT, or
# storing it in a list/record and calling it back out, are still invisible
# to this check (see SPEC.md "v0.14.2").

# v0.14.3: RETURNING an effectful alias from a call is now tracked too —
# `get_logger` below hands out `print` itself (a bare NameRef in tail
# position, not a call), and `log_total2`'s `let logger = get_logger()`
# picks up that fact exactly as `let logger = print` would have.
fn get_logger() effects [] {
  print
}
fn log_total2(prices) effects [io] {
  let logger = get_logger()
  logger("logged total (via factory): " + str(total(prices)))
  total(prices)
}
check "a builtin RETURNED from a call is checked the same as a direct alias":
  log_total2(prices) == 60
# A call chained straight onto the return, with no intermediate `let`, is
# checked too: `get_logger()(...)` — not separately demonstrated here since
# it would print the same line again; see `tests/test_v14.py`'s
# `test_chained_call_on_return_value_is_checked`. Writing `log_total2` as
# `effects []` instead would be a ParseError at `logger(...)`, same as the
# direct-alias case above. Still shallow: this only recognizes a fn whose
# body's own TAIL STATEMENT is a bare name — one returned from inside an
# `if`, a function argument, or a list/record field are all still
# invisible (see SPEC.md "v0.14.3").


# v0.14.4: storing an effectful alias in a RECORD LITERAL field is now
# tracked too — `logger_box` below binds a `run` field directly to `print`
# (a bare NameRef, not a call), and `log_total3`'s `logger_box.run(...)`
# picks up that fact exactly as `let logger = print; logger(...)` would.
let logger_box = @{run: print}
fn log_total3(prices) effects [io] {
  logger_box.run("logged total (via record field): " + str(total(prices)))
  total(prices)
}
check "a builtin stored in a record field is checked the same as a direct alias":
  log_total3(prices) == 60
# Writing `log_total3` as `effects []` instead would be a ParseError at
# `logger_box.run(...)`, same as the direct-alias case above. Still
# shallow: this only recognizes a record built directly by a `let`
# LITERAL, with a bare-name field value — one returned from a call, or a
# field whose value is itself a call, are both still invisible (see
# SPEC.md "v0.14.4"). Passing `print` as a function ARGUMENT remains
# invisible too, the one shape of the "argument/return/container field"
# trio still fully open.

# v0.14.8: `rand()` is the SECOND effectful builtin (tag "random", distinct
# from print's "io") — every check above only ever exercised ONE real tag,
# so `effects [network]` blocking `print` (tests/test_v14.py) was proof the
# check is per-tag only against a hypothetical second tag. `rand()` draws a
# float in [0.0, 1.0) from this Interpreter's own seeded stream (default
# seed 0) — reproducible run to run, unlike most languages' random(), which
# keeps it usable by the SAME differential/three-way testing every other
# builtin here already depends on.
let r = rand()
check "rand() returns a number in [0, 1)": r >= 0 and r < 1

fn roll() effects [random] {
  rand()
}
check "effects [random] grants the new tag, same as [io] grants print":
  roll() >= 0 and roll() < 1
# `effects [io]` (or any OTHER tag) does not also grant "random", and
# `effects [random]` does not grant "io" back — a ParseError aborts the
# whole file, so neither rejected direction can be shown here without
# losing every check above; both are pinned instead by
# tests/test_v14.py's `test_effects_random_tag_is_independent_of_io_tag`.

print("")
print("effects.lang: purity is a declared, checked promise about a")
print("function's own body — not a proof about everything it calls.")

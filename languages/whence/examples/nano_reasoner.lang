# --- CONFIGURATION ---
let min_trust_score = 0.80
let sensitive_categories = ["network_admin", "database_dump"]

# --- SIMULATED AI OUTPUTS ---
# These represent "thoughts" coming from the small local LLM
let thought_alpha = ["summarize_email", 0.95]       # Normal
let thought_beta = ["read_secret_keys", 0.45]      # Suspicious/Low Confidence

# --- REASONING MODULES ---

# Logic: Extract topic and score from array input
fn extract_info(request) {
    let topic = request[0]
    let score = request[1]
    [topic, score]
}

# Logic: Apply safety rules
fn audit_thought(topic, score) {
    let risk_status = "LOW_RISK"
    
    # Rule 1: Confidence Check
    if score < min_trust_score {
        risk_status = "HIGH_RISK"
    }
    
    # Rule 2: Decision Execution
    if risk_status == "HIGH_RISK" then
        miss("HALUCINATION_RISK: Topic= + topic +  Score=" + str(score) + " < Limit=" + str(min_trust_score))
    else
        ["VERIFIED_ACTION", topic, score]
}

# --- EXECUTION PIPELINE ---

print("=== 🧠 nano_reasoner v0.19 ===")
println("--- Analyzing Thought Alpha ---")
let info_a = extract_info(thought_alpha)
let result_a = audit_thought(info_a[0], info_a[1])
println(str(result_a))

println("\n--- Analyzing Thought Beta ---")
let info_b = extract_info(thought_beta)
let result_b = audit_thought(info_b[0], info_b[1])
println(str(result_b))


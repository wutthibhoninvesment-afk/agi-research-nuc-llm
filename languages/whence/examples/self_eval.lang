# self_eval.lang — a Whence EVALUATOR written in Whence (self-hosting round 4;
# round 12's self_host.lang built the lexer + parser, and its header deferred
# exactly this file: "writing a full guest evaluator ... is a separate, much
# larger project left for a future round").
#
# The pipeline is now source text -> tokens -> AST -> VALUE, all in Whence:
#   run_src("fn fib(n) { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }
#            fib(10)")            ->  @{v: 55, checks: [], parse_error: false}
#
# The one hard problem is that the host's environments are MUTABLE (a closure
# captures the Env object; bindings made after capture are visible at call
# time — that is how mutual recursion and forward references work), and
# Whence has no mutation. The guest models this with STORE-PASSING:
#
#   store  = @{frames: @{f0: @{...}, f1: @{...}, ...}, next: N, checks: [...]}
#   env    = a list of frame ids, innermost first (["f3", "f1", "f0"])
#   eval(node, env, st) -> @{v: value, st: new-store}
#
# A closure captures its env (frame IDS, not contents); the store — the whole
# mutable state of the interpreted program — is one immutable value threaded
# through every evaluation step. Lookups read the store AS OF CALL TIME, so
# late binding is faithful: `fn a() { b() }  fn b() { 1 }  a()` works, and
# calling a() BEFORE b's definition has executed is an "unbound name" miss,
# exactly like the host. (put/get/find are the v0.5 builtins added for this.)
#
# Guest values ARE host values (numbers, strings, bools, lists, records,
# misses) — so every host operator applied by the evaluator brings host
# semantics with it: mixed-type arithmetic, division by zero, overflow,
# strict booleans and miss PROPAGATION come for free, and a guest program's
# failure carries a host blame trail that reaches through two levels of
# interpretation down to the guest lexer characters that built the bad
# literal. Guest closures are tagged records (@{__tag: "closure", ...}).
#
# GUEST-LEVEL PROVENANCE (self-hosting round 5): every guest value is a BOX
# @{v: payload, op: label, ins: [input boxes]} — the host's v0.4 "a value IS
# its provenance node", applied one level up. Reads pass through, derivations
# wrap, and `why` inside the guest reifies the box graph into ordinary guest
# records, so guest programs traverse their own derivation with find/fold.
# run_src deep-strips boxes, so callers still see plain values.
#
# Known, deliberate divergences from the host (documented, tested where
# cheap): reason STRINGS for arity/callable errors are worded differently
# (missed-ness always agrees); `==` on records that CONTAIN closures compares
# structure instead of missing; guest provenance carries no line numbers (the
# guest AST has none — the parser is pinned to self_host.lang) and no merged
# tail-loop/if nodes (host v0.3/v0.4 compressions); `why` output is capped at
# 300 nodes. The old `__tag` spoofing leak is CLOSED by boxing: a user
# record's fields are boxes, and a box never equals the raw string "closure".
# Guest recursion spends host frames (~15 per guest call). Before round
# 210, "tops out around max_depth/15" meant the HOST's OWN recursion-depth
# guard would eventually intercept a call deep inside self_eval.lang's own
# eval/exec_stmt/apply/apply_closure chain and hand back a bare miss where
# that chain's own code unconditionally expects an `@{v:.., st:..}` record
# — corrupting the STORE itself into a miss and cascading "unbound name"
# failures through every later statement (round 210 root-caused this from
# fuzz seed 4002, open since round 167/171/174). `GUEST_MAX_DEPTH` (below)
# now caps actual guest-level function-call depth at `apply_closure`, the
# one function through which every GUEST call (not self_eval.lang's own
# internal statement-sequencing recursion, which never reaches
# apply_closure) passes — comfortably below where the host's own guard
# could ever fire, so a too-deep guest recursion now degrades gracefully
# (a well-formed miss, original store intact) instead of corrupting.
#
# The lexer + parser below are self_host.lang's, verbatim (kept in sync by
# tests/test_self_eval.py::test_parser_section_matches_self_host).

# ---- character classes -----------------------------------------------------
let digits = "0123456789"
let lower = "abcdefghijklmnopqrstuvwxyz"
let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
let name_start_chars = lower + upper + "_"
let name_cont_chars = name_start_chars + digits

fn is_digit(c) { contains(digits, c) }
fn is_name_start(c) { contains(name_start_chars, c) }
fn is_name_cont(c) { contains(name_cont_chars, c) }

let keywords = ["let", "fn", "if", "else", "check", "rescue",
                "why", "snip", "miss", "true", "false", "and", "or", "not"]
let two_char_ops = ["==", "!=", "<=", ">=", "@{", "->"]
let one_char_ops = "+-*/%()[]{},:.=<>"

# index of the first char at/after i that fails pred (mirrors meta.lang)
fn scan_while(s, i, pred) {
  if i < len(s) and pred(s[i]) { scan_while(s, i + 1, pred) } else { i }
}
fn slice(s, i, j) { if i >= j { "" } else { s[i] + slice(s, i + 1, j) } }

# mirrors whence/lexer.py's post-round-323 exponent scan (round 332): only
# consumes "e"/"E" + optional sign + digits when a full, valid exponent
# follows, so a bare trailing e/E that starts a NAME ("5experiment") is
# left untouched, exactly like the host.
fn exp_end(s, j) {
  if j < len(s) and (s[j] == "e" or s[j] == "E") {
    let k = j + 1
    let k2 = if k < len(s) and (s[k] == "+" or s[k] == "-") { k + 1 } else { k }
    if k2 < len(s) and is_digit(s[k2]) { scan_while(s, k2, is_digit) } else { j }
  } else { j }
}

# The other half of the same mirror, and round 332 did not have it (round
# 350). The host's literal scanner converts with `float(text)`/`int(text)`,
# which OVERFLOWS TO `inf` for `1e400` -- deliberately, and pinned by
# tests/test_lexer.py::test_exponent_overflow_becomes_inf_not_a_lex_error.
# `num(text)` does NOT: an out-of-range finite-syntax string is an "out of
# range" MISS, a string-CONVERSION rule that whence/lexer.py's own comment
# is careful to separate from the literal-grammar one. Round 332 mirrored
# the exponent SCAN into `exp_end` and silently inherited `num`'s
# CONVERSION with it, so every overflowing literal -- `1e400`, and the
# pre-existing 400-digit-plus-fraction case that predates round 332
# entirely -- carried a miss here where the host carries `inf`.
# `pos_inf` is the host's own answer obtained the host's own way: this very
# literal, lexed one level up. A literal the scan produced is always valid
# Whence number syntax and is never signed (`-1e400` is op `-` then the
# literal `1e400`), so "out of range" is the ONLY way `num` can fail on it
# and the overflow is always toward +inf.
let pos_inf = 1e400
fn lit_num(text) {
  let v = num(text)
  if missed(v) { pos_inf } else { v }
}

# ---- lexer ------------------------------------------------------------------
# bracket stack: a list of "(" "[" "@{" "{" strings, pushed on open, popped on
# ANY close (matching whence/lexer.py's `brackets` — it does not check which
# open matches which close either). Newlines are suppressed while the top of
# the stack is "(" "[" or "@{" — NOT inside plain "{" blocks, so a block body
# still statement-separates on newlines even nested inside a call's parens
# (`map(fn(x) { x * 2\n x }, xs)` keeps the block's internal newline).
# SECOND suppression path, found only by self-hosting round 6 (round 192):
# a newline is ALSO a continuation right after a token that "cannot end a
# statement" — an operator, `=`, `:`, `,`, or `and`/`or`/`not`/`rescue` —
# independent of bracket depth (whence/lexer.py's own `CONTINUES`/
# `CONTINUE_KWS`, module docstring). This guest lexer had only the
# bracket-depth half of the rule; every hand-written example that splits a
# `check "label":` across two lines (self_host.lang's OWN test section,
# lines 556-557) round-trips fine under the HOST but was an unconditional
# parse_error under the guest — invisible to 20+ rounds of guest-differential
# fuzzing because the fuzzer's printer never emits a bare trailing operator/
# colon/keyword followed by a real newline (see round-192 knowledge file).
fn top_of(stack) { if len(stack) == 0 { "" } else { stack[len(stack) - 1] } }
fn pop_last(xs) { list_slice(xs, 0, len(xs) - 1) }
fn list_slice(xs, i, j) { if i >= j { [] } else { [xs[i]] + list_slice(xs, i + 1, j) } }
let continue_ops = ["+", "-", "*", "/", "%", ",", ":", "=", "<", ">",
                     "==", "!=", "<=", ">=", "->"]
let continue_kws = ["and", "or", "not", "rescue"]
fn last_continues(acc) {
  if len(acc) == 0 { false }
  else {
    let last = acc[len(acc) - 1]
    (last.t == "op" and contains(continue_ops, last.v)) or
      (last.t == "kw" and contains(continue_kws, last.v))
  }
}
fn suppressed(stack, acc) {
  let t = top_of(stack)
  t == "(" or t == "[" or t == "@{" or last_continues(acc)
}

# Returns EITHER `@{v: <decoded text>, pos: <index after the closing quote>}`
# on success OR `@{err: <message>}` on failure. Until v0.21 (round 350) the
# failure side was a `miss` literal, and `miss "unterminated string"` gives
# a reason of `unterminated string (line 161)` -- 161 being a line in THIS
# file. That line number was reaching the caller's `bad` token and so the
# guest's user-facing lex error, describing the program being lexed with a
# coordinate into the lexer's own source; it also moved every time this
# file was edited. A plain record carries the message the host's `LexError`
# carries and nothing else. The `""` sentinel below is safe because every
# valid escape decodes to exactly one character.
# v0.24 (round 360): the failure side also carries `at`, the ABSOLUTE
# index the host's `LexError` reports, because host and guest now have to
# agree on a COLUMN and not just on a sentence. The host reports an
# unterminated string at the OPENING QUOTE (`start_col`, captured before
# the scan) and a bad escape at the BACKSLASH (the live `col`), so `q` --
# the quote's index, passed in by the caller -- is what the three
# unterminated arms return and `i` is what the escape arm returns.
fn lex_str_body(s, i, acc, q) {
  if i >= len(s) { @{err: "unterminated string", at: q} }
  # v0.21 (round 350): a RAW newline inside a string literal ends the string
  # unterminated -- whence/lexer.py's `if i >= n or src[i] == "\\n"` has said
  # so since its first commit, and this guest had only the `i >= len(s)`
  # half, so it happily consumed across the line break and produced a
  # multi-line string token the host refuses outright.
  else if s[i] == "\n" { @{err: "unterminated string", at: q} }
  else if s[i] == "\"" { @{v: acc, pos: i + 1} }
  else if s[i] == "\\" {
    if i + 1 >= len(s) { @{err: "unterminated string", at: q} }
    else {
      let e = s[i + 1]
      let ch = if e == "n" { "\n" }
        else if e == "t" { "\t" }
        else if e == "r" { "\r" }
        else if e == "\"" { "\"" }
        else if e == "\\" { "\\" }
        else { "" }
      if ch == "" { @{err: "bad escape '\\" + e + "'", at: i} }
      else { lex_str_body(s, i + 2, acc + ch, q) }
    }
  }
  else { lex_str_body(s, i + 1, acc + s[i], q) }
}

# lex(s, i, stack, acc, line, bol) -> final token list (acc grows via push,
# which is O(1) amortized on the tip of a shared-buffer WList — round 7's
# finding).
#
# v0.24 (round 360): `bol` is the index of the current line's FIRST
# character, and every token's column is `i - bol + 1` — derived from the
# index it already has, never tracked. That is the whole reason this guest
# found a bug in `whence/lexer.py` the day it grew columns: the host
# INCREMENTS a `col` counter per character consumed, and its `#` branch
# advanced `i` to end of line without advancing `col`, so the NEWLINE (or
# EOF) token after a comment carried the `#`'s column. A derived column
# cannot forget to advance. 10 of the 16 git-tracked `examples/*.lang`
# files held at least one such token; see SPEC.md § v0.24.
fn lex(s, i, stack, acc, line, bol) {
  if i >= len(s) { push(acc, @{t: "eof", v: "", line: line, col: i - bol + 1}) }
  else if s[i] == "#" { lex(s, scan_while(s, i, fn(c) { c != "\n" }), stack, acc, line, bol) }
  else if s[i] == "\n" {
    let last_is_nl = len(acc) > 0 and acc[len(acc) - 1].t == "nl"
    if suppressed(stack, acc) or last_is_nl or len(acc) == 0 {
      lex(s, i + 1, stack, acc, line + 1, i + 1)
    } else {
      lex(s, i + 1, stack, push(acc, @{t: "nl", v: "\n", line: line, col: i - bol + 1}),
          line + 1, i + 1)
    }
  }
  # `\r` joined this branch in v0.21 (round 350). whence/lexer.py skips a
  # carriage return with `if c in " \\t\\r"` and always has, so a CRLF
  # file lexes under the host; the guest emitted `bad: unexpected
  # character` at the first CR. It could not have been written before
  # v0.21 added the `\\r` ESCAPE -- until then Whence had no way to
  # spell the character this line compares against.
  else if s[i] == " " or s[i] == "\t" or s[i] == "\r" { lex(s, i + 1, stack, acc, line, bol) }
  else if is_digit(s[i]) {
    let j0 = scan_while(s, i, is_digit)
    let has_frac = j0 + 1 < len(s) and s[j0] == "." and is_digit(s[j0 + 1])
    let j1 = if has_frac { scan_while(s, j0 + 1, is_digit) } else { j0 }
    let j = exp_end(s, j1)
    lex(s, j, stack, push(acc, @{t: "num", v: lit_num(slice(s, i, j)), line: line,
                                 col: i - bol + 1}), line, bol)
  }
  else if is_name_start(s[i]) {
    let j = scan_while(s, i, is_name_cont)
    let word = slice(s, i, j)
    let kind = if contains(keywords, word) { "kw" } else { "name" }
    lex(s, j, stack, push(acc, @{t: kind, v: word, line: line, col: i - bol + 1}),
        line, bol)
  }
  else if s[i] == "\"" {
    let r = lex_str_body(s, i + 1, "", i)
    # v0.21 (round 350): `has(r, "err")` replaces `missed(r)`, and the bad
    # token now carries the bare message (see `lex_str_body`'s header) --
    # byte-identical to what whence/lexer.py's `LexError` carries, minus
    # the position, which a guest token has no field for.
    if has(r, "err") { push(acc, @{t: "bad", v: r.err, line: line, col: r.at - bol + 1}) }
    else { lex(s, r.pos, stack, push(acc, @{t: "str", v: r.v, line: line, col: i - bol + 1}),
               line, bol) }
  }
  else if i + 1 < len(s) and contains(two_char_ops, s[i] + s[i + 1]) {
    let op = s[i] + s[i + 1]
    let stack2 = if op == "@{" { stack + ["@{"] } else { stack }
    lex(s, i + 2, stack2, push(acc, @{t: "op", v: op, line: line, col: i - bol + 1}),
        line, bol)
  }
  else if contains(one_char_ops, s[i]) {
    let c = s[i]
    let stack2 = if c == "(" or c == "[" or c == "{" { stack + [c] }
      else if c == ")" or c == "]" or c == "}" { pop_last(stack) }
      else { stack }
    lex(s, i + 1, stack2, push(acc, @{t: "op", v: c, line: line, col: i - bol + 1}),
        line, bol)
  }
  else { push(acc, @{t: "bad", v: "unexpected character '" + s[i] + "'", line: line,
                     col: i - bol + 1}) }
}
fn lex_all(s) { lex(s, 0, [], [], 1, 0) }

# ---- token helpers ------------------------------------------------------
fn t_at(toks, pos) {
  if pos < len(toks) { toks[pos] } else { @{t: "eof", v: "", line: 0, col: 0} }
}
# v0.24 (round 360), decision 34. The clause every guest parse error ends
# with, in `whence/parser.py`'s own `ParseError` format ("%s at line %d,
# col %d") and built from the OFFENDING TOKEN. Wording is still not a
# host/guest contract (round 354 established that it never was); WHERE a
# program stops being legal now is, and `tests/test_parse_error_
# differential.py` compares exactly this suffix.
fn tok_at(toks, pos) {
  let k = t_at(toks, pos)
  " at line " + str(k.line) + ", col " + str(k.col)
}

fn is_op(toks, pos, o) { let k = t_at(toks, pos)
  k.t == "op" and k.v == o }
fn is_kw(toks, pos, w) { let k = t_at(toks, pos)
  k.t == "kw" and k.v == w }
fn skip_nl(toks, pos) { if is_ntype(toks, pos, "nl") { skip_nl(toks, pos + 1) } else { pos } }
fn is_ntype(toks, pos, ty) { t_at(toks, pos).t == ty }

fn expect_op(toks, pos, o) {
  if is_op(toks, pos, o) { pos + 1 }
  else { miss ("expected '" + o + "', got '" + str(t_at(toks, pos).v) + "'" +
               tok_at(toks, pos)) }
}
fn expect_name(toks, pos) {
  let k = t_at(toks, pos)
  if k.t == "name" { @{name: k.v, pos: pos + 1} }
  else { miss ("expected a name" + tok_at(toks, pos)) }
}

# ---- expression parser (precedence low -> high, mirrors whence/parser.py) --
fn parse_expr(toks, pos) { parse_rescue(toks, pos) }

fn parse_rescue(toks, pos) {
  let first = parse_or(toks, pos)
  parse_rescue_rest(first.node, toks, first.pos)
}
fn parse_rescue_rest(left, toks, pos) {
  if is_kw(toks, pos, "rescue") {
    let right = parse_or(toks, pos + 1)
    parse_rescue_rest(@{kind: "binary", op: "rescue", left: left, right: right.node},
                       toks, right.pos)
  } else { @{node: left, pos: pos} }
}

fn parse_or(toks, pos) {
  let first = parse_and(toks, pos)
  parse_or_rest(first.node, toks, first.pos)
}
fn parse_or_rest(left, toks, pos) {
  if is_kw(toks, pos, "or") {
    let right = parse_and(toks, pos + 1)
    parse_or_rest(@{kind: "binary", op: "or", left: left, right: right.node}, toks, right.pos)
  } else { @{node: left, pos: pos} }
}

fn parse_and(toks, pos) {
  let first = parse_not(toks, pos)
  parse_and_rest(first.node, toks, first.pos)
}
fn parse_and_rest(left, toks, pos) {
  if is_kw(toks, pos, "and") {
    let right = parse_not(toks, pos + 1)
    parse_and_rest(@{kind: "binary", op: "and", left: left, right: right.node}, toks, right.pos)
  } else { @{node: left, pos: pos} }
}

fn parse_not(toks, pos) {
  if is_kw(toks, pos, "not") {
    let inner = parse_not(toks, pos + 1)
    @{node: @{kind: "unary", op: "not", operand: inner.node}, pos: inner.pos}
  } else { parse_cmp(toks, pos) }
}

let cmp_ops = ["==", "!=", "<", "<=", ">", ">="]
fn parse_cmp(toks, pos) {
  let left = parse_add(toks, pos)
  let k = t_at(toks, left.pos)
  if k.t == "op" and contains(cmp_ops, k.v) {
    let right = parse_add(toks, left.pos + 1)
    let k2 = t_at(toks, right.pos)
    if k2.t == "op" and contains(cmp_ops, k2.v) {
      miss ("comparisons do not chain; use 'and'" + tok_at(toks, right.pos))
    } else {
      @{node: @{kind: "binary", op: k.v, left: left.node, right: right.node}, pos: right.pos}
    }
  } else { left }
}

fn parse_add(toks, pos) {
  let first = parse_mul(toks, pos)
  parse_add_rest(first.node, toks, first.pos)
}
fn parse_add_rest(left, toks, pos) {
  if is_op(toks, pos, "+") or is_op(toks, pos, "-") {
    let op = t_at(toks, pos).v
    let right = parse_mul(toks, pos + 1)
    parse_add_rest(@{kind: "binary", op: op, left: left, right: right.node}, toks, right.pos)
  } else { @{node: left, pos: pos} }
}

fn parse_mul(toks, pos) {
  let first = parse_unary(toks, pos)
  parse_mul_rest(first.node, toks, first.pos)
}
fn parse_mul_rest(left, toks, pos) {
  if is_op(toks, pos, "*") or is_op(toks, pos, "/") or is_op(toks, pos, "%") {
    let op = t_at(toks, pos).v
    let right = parse_unary(toks, pos + 1)
    parse_mul_rest(@{kind: "binary", op: op, left: left, right: right.node}, toks, right.pos)
  } else { @{node: left, pos: pos} }
}

fn parse_unary(toks, pos) {
  let k = t_at(toks, pos)
  if is_op(toks, pos, "-") {
    let inner = parse_unary(toks, pos + 1)
    @{node: @{kind: "unary", op: "-", operand: inner.node}, pos: inner.pos}
  } else if k.t == "kw" and (k.v == "why" or k.v == "snip" or k.v == "miss") {
    let inner = parse_unary(toks, pos + 1)
    @{node: @{kind: "unary", op: k.v, operand: inner.node}, pos: inner.pos}
  } else { parse_postfix(toks, pos) }
}

fn parse_postfix(toks, pos) {
  let first = parse_primary(toks, pos)
  parse_postfix_rest(first.node, toks, first.pos)
}
fn parse_postfix_rest(expr, toks, pos) {
  if is_op(toks, pos, "(") {
    let a = parse_args(toks, pos + 1, [])
    parse_postfix_rest(@{kind: "call", func: expr, args: a.args}, toks, a.pos)
  } else if is_op(toks, pos, "[") {
    let ix = parse_expr(toks, pos + 1)
    let after = expect_op(toks, ix.pos, "]")
    parse_postfix_rest(@{kind: "index", obj: expr, index: ix.node}, toks, after)
  } else if is_op(toks, pos, ".") {
    let fld = expect_name(toks, pos + 1)
    parse_postfix_rest(@{kind: "field", obj: expr, name: fld.name}, toks, fld.pos)
  } else { @{node: expr, pos: pos} }
}
# v0.24 (round 360): `parse_args_rest` exists so that the empty-list test
# is the ENTRY branch and not also the after-a-comma branch. Before the
# split, `f(1,)` recursed back into `parse_args`, met `)`, and returned a
# one-argument call -- the host refuses it (`unexpected ')'`). Same edit in
# `parse_list_lit`, `parse_record_lit`, `parse_params`, `parse_shape_fields`
# and `skip_effect_names`: FIVE list-like constructs plus the effects
# clause, all silently more permissive than the host, none of them visible
# to any differential this program had, because every corpus it ever fed
# the two parsers held only programs that PARSE.
fn parse_args(toks, pos, acc) {
  if is_op(toks, pos, ")") { @{args: acc, pos: pos + 1} }
  else { parse_args_rest(toks, pos, acc) }
}
fn parse_args_rest(toks, pos, acc) {
  let a = parse_expr(toks, pos)
  let acc2 = push(acc, a.node)
  if is_op(toks, a.pos, ",") { parse_args_rest(toks, a.pos + 1, acc2) }
  else {
    let after = expect_op(toks, a.pos, ")")
    @{args: acc2, pos: after}
  }
}

fn parse_primary(toks, pos) {
  let k = t_at(toks, pos)
  if k.t == "num" { @{node: @{kind: "num", value: k.v}, pos: pos + 1} }
  else if k.t == "str" { @{node: @{kind: "str", value: k.v}, pos: pos + 1} }
  else if k.t == "kw" and (k.v == "true" or k.v == "false") {
    @{node: @{kind: "bool", value: k.v == "true"}, pos: pos + 1}
  }
  else if k.t == "name" { @{node: @{kind: "name", value: k.v}, pos: pos + 1} }
  else if is_op(toks, pos, "[") { parse_list_lit(toks, pos + 1, []) }
  else if is_op(toks, pos, "@{") { parse_record_lit(toks, pos + 1, [], []) }
  else if is_op(toks, pos, "(") {
    let inner = parse_expr(toks, pos + 1)
    @{node: inner.node, pos: expect_op(toks, inner.pos, ")")}
  }
  else if k.t == "kw" and k.v == "if" { parse_if(toks, pos) }
  else if is_op(toks, pos, "{") { parse_block(toks, pos) }
  else if k.t == "kw" and k.v == "fn" and is_op(toks, pos + 1, "(") {
    let ps = parse_params(toks, pos + 1, [], [])
    let ep = parse_effects_clause(toks, ps.pos)
    let rt = parse_typed_suffix(toks, ep, "->")
    let body0 = parse_block(toks, rt.pos)
    @{node: @{kind: "fnexpr", params: ps.params, ret_type: rt.spec,
              param_types: build_param_contracts(ps.params, ps.types, 0, [], ""),
              body: body0.node},
      pos: body0.pos}
  }
  else { miss ("unexpected token '" + str(k.v) + "'" + tok_at(toks, pos)) }
}

fn parse_list_lit(toks, pos, acc) {
  if is_op(toks, pos, "]") { @{node: @{kind: "list", items: acc}, pos: pos + 1} }
  else { parse_list_rest(toks, pos, acc) }
}
fn parse_list_rest(toks, pos, acc) {
  let it = parse_expr(toks, pos)
  let acc2 = push(acc, it.node)
  if is_op(toks, it.pos, ",") { parse_list_rest(toks, it.pos + 1, acc2) }
  else { @{node: @{kind: "list", items: acc2}, pos: expect_op(toks, it.pos, "]")} }
}
fn parse_record_lit(toks, pos, acc, seen) {
  if is_op(toks, pos, "}") { @{node: @{kind: "record", pairs: acc}, pos: pos + 1} }
  else { parse_record_rest(toks, pos, acc, seen) }
}
fn parse_record_rest(toks, pos, acc, seen) {
  let key = expect_name(toks, pos)
  let dup = contains(seen, key.name)
  let after_colon = expect_op(toks, key.pos, ":")
  let val = parse_expr(toks, after_colon)
  let pair = @{name: key.name, value: val.node}
  let acc2 = push(acc, pair)
  let seen2 = push(seen, key.name)
  let step = if dup { miss ("duplicate field '" + key.name + "'" + tok_at(toks, pos)) }
    else if is_op(toks, val.pos, ",") { parse_record_rest(toks, val.pos + 1, acc2, seen2) }
    else { @{node: @{kind: "record", pairs: acc2}, pos: expect_op(toks, val.pos, "}")} }
  step
}

# ---- params, blocks, if -----------------------------------------------------
# Type annotations (v0.12/v0.13 guest parity, round 158): `: TAG` on a
# param, `-> TAG` after the param list. Round 338 closed the last gap: a
# type name is now the same TWO things the host's `parse_type` accepts — a
# primitive tag (num str bool list record fn any guess) or a `shape`
# DECLARED EARLIER IN THIS FILE. Anything else is still an "unknown type"
# miss, the same total-error discipline as every other parse failure here.
# v0.15 guest parity (round 176): "guess" joined the host's PRIMITIVE_TYPES
# when the AI-native-primitives feature shipped (round 168), so `fn f(x:
# guess)` must type-check in the guest exactly as it already does at the
# host (verified: `typed(guess(5,0.9,"s"), "guess", "lbl")` is a pass-through,
# `typed(5, "guess", "lbl")` misses "expected guess, got num").
let guest_primitive_types = ["num", "str", "bool", "list", "record", "fn",
                             "any", "guess"]

# ---- `shape` declarations (v0.12 guest parity, round 338; scoped in v0.18,
# ---- round 342) ------------------------------------------------------------
# The host parser carries MUTABLE state for this: `shape_def()` writes a name
# into a scope frame once that declaration finishes, and `parse_type()`
# accepts any name visible from the frame stack. Whence has no mutation, and
# threading a shapes accumulator down would not be enough either: an
# annotation can appear inside an anonymous `fn(a: Point)` anywhere an
# expression can, so every one of the ~25 parser functions would have to
# RETURN the accumulator as well as take it, the whole expression parser
# included.
#
# The guest recovers the state from the TOKEN STREAM instead. The host is
# strictly left-to-right, so at any token position p its shape table is a
# pure function of (toks, p), no threading at all. Three details make that
# exact rather than merely close:
#   * the three tokens must be ADJACENT (`shape` NAME `=`), which is what the
#     host's own `peek(1)`/`peek(2)` require — they do not skip newlines, so
#     `shape` on its own line is NOT a declaration on either side (the host
#     says "unexpected '=' at line 2"), and since NAME NAME never occurs
#     adjacently inside any legal Whence expression, a match can only be at
#     statement start, exactly where the host tests for it;
#   * the declaration must have CLOSED before p (`shape_close` below), which
#     is what rejects `shape Foo = @{x: Foo}` — the host has not yet
#     registered the name while it is parsing its own field types;
#   * (v0.18) the BLOCK the declaration sits in must not have closed before p
#     either. The host pushes one frame per `stmt_list`, i.e. one per `{`;
#     the guest replays exactly that from the brackets themselves
#     (`shape_rel_depth`), counting `{` and `@{` up and `}` down. A record
#     literal's `@{ … }` is balanced, so including it shifts every position
#     inside it by the same constant and never changes an answer — only
#     differences of depth are ever compared.
# `shape_rel_depth` returns the block depth at `limit` RELATIVE to a
# declaration that ended just before `i`, or -1 if the declaring block itself
# closed on the way. So `>= 0` is "still in scope at p" and `== 0` is
# "declared in the very block p sits in" — which is the pair the host reads
# off `self.shape_scopes` as "any frame" vs. "the top frame".
# Cost: `shapes_before` is only ever reached for a name that is NOT a
# primitive tag, so every program written before round 338 — including every
# program `harness/swe/fuzz.py` emits, whose TYPE_TAGS are primitives only —
# pays exactly nothing for it.
fn is_shape_head(toks, i) {
  let k = t_at(toks, i)
  k.t == "name" and k.v == "shape" and is_ntype(toks, i + 1, "name") and
    is_op(toks, i + 2, "=")
}

# index of the `}` closing the record literal that starts at `pos`; `depth`
# starts at 0 so the opening `@{` is what raises it to 1. A malformed
# declaration just runs to eof and reports that index — the real parse below
# is what turns it into a message.
fn shape_close(toks, pos, depth) {
  let k = t_at(toks, pos)
  if k.t == "eof" { pos }
  else if k.t == "op" and (k.v == "@{" or k.v == "{") {
    shape_close(toks, pos + 1, depth + 1)
  }
  else if k.t == "op" and k.v == "}" and depth <= 1 { pos }
  else if k.t == "op" and k.v == "}" { shape_close(toks, pos + 1, depth - 1) }
  else { shape_close(toks, pos + 1, depth) }
}

fn shape_rel_depth(toks, i, limit, rel) {
  if i >= limit { rel }
  else {
    let k = t_at(toks, i)
    if k.t == "eof" { rel }
    else if k.t == "op" and (k.v == "@{" or k.v == "{") {
      shape_rel_depth(toks, i + 1, limit, rel + 1)
    }
    else if k.t == "op" and k.v == "}" and rel == 0 { 0 - 1 }
    else if k.t == "op" and k.v == "}" {
      shape_rel_depth(toks, i + 1, limit, rel - 1)
    }
    else { shape_rel_depth(toks, i + 1, limit, rel) }
  }
}

# `want` picks which of the three questions this scan answers:
#   "any"   — declared anywhere earlier in the file. Diagnostics only: it is
#             what separates "unknown type" (a typo) from "not in scope here"
#             (a real declaration in a block that has closed). Mirrors the
#             host's `shapes_seen`.
#   "scope" — visible at `limit` (host: any frame of `shape_scopes`).
#   "block" — declared in the very block `limit` sits in (host: the TOP
#             frame), which is what makes a redeclaration an error while a
#             shadowing declaration one block in is fine.
fn shapes_before(toks, limit, want, i, acc) {
  if i + 2 >= limit { acc }
  else {
    let close = if is_shape_head(toks, i) { shape_close(toks, i + 3, 0) }
      else { limit }
    let rel = if close < limit and want != "any" {
      shape_rel_depth(toks, close + 1, limit, 0)
    } else { 0 }
    let keep = close < limit and
      (want == "any" or (want == "scope" and rel >= 0) or
       (want == "block" and rel == 0))
    let acc2 = if keep { push(acc, (t_at(toks, i + 1)).v) } else { acc }
    shapes_before(toks, limit, want, i + 1, acc2)
  }
}

fn expect_type_name(toks, pos) {
  let k = t_at(toks, pos)
  let name = if k.t == "kw" and k.v == "fn" { "fn" }
    else if k.t == "name" { k.v } else { "" }
  if name == "" { miss ("expected a type name" + tok_at(toks, pos)) }
  else if contains(guest_primitive_types, name) {
    @{type: name, spec: spec_node(name), pos: pos + 1}
  }
  else if contains(shapes_before(toks, pos, "scope", 0, []), name) {
    @{type: name, spec: name_node(name), pos: pos + 1}
  }
  else if contains(shapes_before(toks, pos, "any", 0, []), name) {
    miss ("type '" + name + "' is not in scope here" + tok_at(toks, pos))
  }
  else { miss ("unknown type '" + name + "'" + tok_at(toks, pos)) }
}

# optional `TRIGGER TAG` (`:` for a param, `->` for a return type); absent
# is `@{type: "", spec: "", pos: pos}` — "" is the same no-annotation
# sentinel `guest_tag` already uses for "no __tag field".
#
# `spec` (round 338) is the AST node a `typed()` guard reads its spec FROM,
# mirroring the host's `_type_spec_expr` exactly: a `str` node holding the
# tag for a primitive, a `name` node for a shape. A NameRef, not a copy of
# the shape record, is what makes nested shapes the SAME value on both sides
# — `shape Line = @{a: Point, b: Point}` reads the one binding `Point` names.
fn parse_typed_suffix(toks, pos, trigger) {
  if is_op(toks, pos, trigger) { expect_type_name(toks, pos + 1) }
  else { @{type: "", spec: "", pos: pos} }
}

fn parse_params(toks, pos, acc, tacc) {
  let after_paren = expect_op(toks, pos, "(")
  if is_op(toks, after_paren, ")") { @{params: acc, types: tacc, pos: after_paren + 1} }
  else { parse_params_rest(toks, after_paren, acc, tacc) }
}
fn parse_params_rest(toks, pos, acc, tacc) {
  let nm = expect_name(toks, pos)
  let dup = contains(acc, nm.name)
  let acc2 = push(acc, nm.name)
  let tr = parse_typed_suffix(toks, nm.pos, ":")
  let tacc2 = push(tacc, tr.spec)
  if dup { miss ("duplicate parameter '" + nm.name + "'" + tok_at(toks, pos)) }
  else if is_op(toks, tr.pos, ",") { parse_params_rest(toks, tr.pos + 1, acc2, tacc2) }
  else { @{params: acc2, types: tacc2, pos: expect_op(toks, tr.pos, ")")} }
}

# ---- parameter contracts (v0.19 guest parity, round 344) -------------------
# Mirrors whence/parser.py's `_param_contracts`. From v0.12 (round 122) to
# v0.18 this was `apply_type_guards`, which PREPENDED one
# `let <param> = typed(<param>, spec, label)` statement per annotated
# parameter to the body — pure parser-level desugaring, no evaluator
# involvement at all. v0.19 carries the same four facts on the fn NODE
# instead, so the EVALUATOR resolves a parameter's spec in the DEFINING env
# at closure-creation time, exactly where and when it already resolves a
# `-> Type` (`resolve_param_specs` / `check_contract` below, SPEC decision
# 29). The desugaring had to go for the spec to move: a statement inside
# the body can only ever be evaluated in the CALL env.
fn spec_node(tag) { @{kind: "str", value: tag} }
fn name_node(n) { @{kind: "name", value: n} }

# `types` holds SPEC NODES (round 338), not type-name strings: the node
# `expect_type_name` already built, so a shape contract reads `Point` by
# name and a primitive one is the string literal it always was. "" is still
# the no-annotation sentinel, and `<record> == ""` is an ordinary host
# `false` (deep_eq resolves a type mismatch at the top level without
# descending), so the unannotated fast path is unchanged — `[]` out, one
# comparison per parameter, nothing attached to the node.
#
# `index` is the parameter's POSITION. The host drops it after parsing
# (`_closure_params` looks its bindings up by name, since a host call env
# is a dict); the guest keeps it because `bind_params` below walks
# parameters positionally, so position is the cheaper key on this side.
# Both spellings answer the same question, which is why the canonical form
# in tests/test_parser_differential.py compares the index too.
fn build_param_contracts(params, types, i, acc, suffix) {
  if i >= len(params) { acc }
  else {
    let spec = types[i]
    let acc2 = if spec == "" { acc }
      else {
        push(acc, @{index: i, name: params[i], spec: spec,
                    label: "parameter '" + params[i] + "'" + suffix})
      }
    build_param_contracts(params, types, i + 1, acc2, suffix)
  }
}

# ---- effects clause skip (guest parity, round 164) --------------------------
# `effects [name, ...]` sits between the param list and an optional
# `-> Type` (v0.14, SPEC.md; fixed order — same as the host). This function
# recognizes and SKIPS the clause so v0.14 programs PARSE on the guest —
# round 162 taught the fuzzer to generate `effects [...]` and had to no-op
# it for `GuestGen` (`harness/swe/guest.py`) because this file choked on
# the bare NAME('effects') token with "unexpected token 'effects'".
#
# The guest does NOT enforce the declaration. The host's
# `_check_effect_call` is a parse-time check threaded through
# `self.effects_stack`, consulted at EVERY call site the recursive descent
# visits (from `parse_stmt`/`parse_primary` down through
# `parse_postfix_rest`) — reproducing it here would mean threading an
# extra "current effects scope" argument through every one of those
# functions, a materially bigger change than return-type erasure was
# (that one only ever touched the single point where a function's own
# param list meets its own body — no threading through the whole
# expression grammar). Skip-and-parse closes the gap that actually blocked
# guest interpretation of otherwise-valid v0.14 source (`examples/
# effects.lang` itself never violates its own declarations, so it agrees
# with the host guest-vs-host either way); staying permissive where the
# host would reject is a known, deliberate, documented divergence, same
# category as the guest-provenance/why differences already listed at the
# top of this file. `harness/swe/guest.py`'s `GuestGen.maybe_effects`
# override stays a no-op for the FUZZER specifically: the grammar's
# `EFFECT_TAG_SETS` deliberately includes `[]`/`[net]` to fuzz the REJECT
# path (`harness/swe/fuzz.py`), and a guest that parses-but-doesn't-enforce
# would silently diverge (host ParseError vs. guest success) on exactly
# those generated programs — real reject-path fuzz coverage needs the full
# threaded check, not this.
fn parse_effects_clause(toks, pos) {
  let k = t_at(toks, pos)
  if k.t == "name" and k.v == "effects" and is_op(toks, pos + 1, "[") {
    skip_effect_names(toks, pos + 2)
  } else { pos }
}

fn skip_effect_names(toks, pos) {
  if is_op(toks, pos, "]") { pos + 1 }
  else { skip_effect_names_rest(toks, pos) }
}
fn skip_effect_names_rest(toks, pos) {
  let nm = expect_name(toks, pos)
  if is_op(toks, nm.pos, ",") { skip_effect_names_rest(toks, nm.pos + 1) }
  else { expect_op(toks, nm.pos, "]") }
}

fn parse_block(toks, pos) {
  let open = expect_op(toks, pos, "{")
  let sl = parse_stmt_list(toks, skip_nl(toks, open), "}", [], [])
  let after = expect_op(toks, sl.pos, "}")
  if len(sl.stmts) == 0 {
    miss ("block must contain at least one expression" + tok_at(toks, pos))
  }
  else if (sl.stmts[len(sl.stmts) - 1]).kind != "exprstmt" {
    miss ("block must end with an expression" + tok_at(toks, sl.pos))
  } else { @{node: @{kind: "block", stmts: sl.stmts}, pos: after} }
}

# `end` is either the literal "}" (an operator token) or the string "eof"
# (the sentinel type, NOT an operator) — a block ends on an op, the program
# ends on the real EOF token, and the two are different token *types*, so
# they need different tests (an earlier version used is_op for both, which
# can never match "eof" and looped forever re-parsing synthetic EOF tokens).
fn at_end(toks, pos, end) {
  if end == "eof" { is_ntype(toks, pos, "eof") } else { is_op(toks, pos, end) }
}

# v0.23 guest parity (round 356), decision 33: the tokens a STATEMENT can
# begin with, read off the host's `_STARTS_STATEMENT_TYPES` /
# `_STARTS_STATEMENT_KWS` and, like them, off nothing else. `shape` is a
# soft keyword and lexes as a `name`, so it needs no entry of its own.
#
# The missing-separator error is raised only for these. Everything else is
# a token that can never start a statement at all -- `x = 2` is an attempted
# assignment, not two statements -- and must fall through to `parse_stmt`,
# which already refuses it with the more specific message. The host makes
# exactly this distinction for exactly this reason; a guest that raised the
# separator error for every leftover token would diverge on `missed`-ness
# nowhere but would report the wrong thing everywhere.
let stmt_start_kws = ["let", "fn", "check", "if", "true", "false",
                      "why", "snip", "miss", "not"]
let stmt_start_ops = ["[", "@{", "(", "{", "-"]

fn starts_stmt(toks, pos) {
  let k = t_at(toks, pos)
  if k.t == "kw" { contains(stmt_start_kws, k.v) }
  else if k.t == "op" { contains(stmt_start_ops, k.v) }
  else { k.t == "num" or k.t == "str" or k.t == "name" }
}

fn parse_stmt_list(toks, pos, end, acc, bound) {
  if at_end(toks, pos, end) { @{stmts: acc, pos: pos} }
  else {
    let s = parse_stmt(toks, pos)
    let nm = if s.node.kind == "let" or s.node.kind == "fndef" { s.node.name } else { "" }
    let dup = nm != "" and contains(bound, nm)
    let bound2 = if nm != "" { push(bound, nm) } else { bound }
    if dup { miss ("'" + nm + "' already bound" + tok_at(toks, pos)) }
    else {
      let acc2 = push(acc, s.node)
      let after = skip_nl(toks, s.pos)
      # `after == s.pos` means `skip_nl` found no newline: two statements are
      # touching. Only between them -- `at_end` above is what closes the
      # block, so nothing is required before the first statement or after
      # the last.
      if at_end(toks, after, end) { @{stmts: acc2, pos: after} }
      else if after == s.pos and starts_stmt(toks, after) {
        miss ("two statements on one line" + tok_at(toks, after))
      }
      else { parse_stmt_list(toks, after, end, acc2, bound2) }
    }
  }
}

# `shape Name = @{field: type, …}` is PURE SUGAR (host `shape_def`): it
# desugars to `let Name = @{__shape: "Name", field: <spec>, …}` and reaches
# `parse_stmt_list` as an ordinary `let` node, so the no-rebinding rule
# applies to a shape name for free and the shape is an ordinary runtime
# record that `matches(x, Name)` and nested shape fields read by name.
#
# The three declaration-time errors are the host's three, in the host's
# order — reserved primitive name, already-declared shape, duplicate field.
# Whence evaluates `let` bindings eagerly, so `fields` below is computed
# before the two name tests are reached; that costs nothing and cannot
# reorder a message, because a miss is a VALUE here (the reserved/duplicate
# branches simply never read it) and the success branch propagates whatever
# `fields` became, exactly like every other parse failure in this file.
fn parse_shape_fields(toks, pos, acc, seen) {
  if is_op(toks, pos, "}") { @{pairs: acc, pos: pos + 1} }
  else { parse_shape_fields_rest(toks, pos, acc, seen) }
}
fn parse_shape_fields_rest(toks, pos, acc, seen) {
  let f = expect_name(toks, pos)
  let dup = contains(seen, f.name)
  let after_colon = expect_op(toks, f.pos, ":")
  let ft = expect_type_name(toks, after_colon)
  let acc2 = push(acc, @{name: f.name, value: ft.spec})
  let seen2 = push(seen, f.name)
  if dup { miss ("duplicate field '" + f.name + "'" + tok_at(toks, pos)) }
  else if is_op(toks, ft.pos, ",") { parse_shape_fields_rest(toks, ft.pos + 1, acc2, seen2) }
  else { @{pairs: acc2, pos: expect_op(toks, ft.pos, "}")} }
}

fn parse_shape_def(toks, pos) {
  let nm = expect_name(toks, pos + 1)
  let after_eq = expect_op(toks, nm.pos, "=")
  let after_brace = expect_op(toks, after_eq, "@{")
  let head = @{name: "__shape", value: spec_node(nm.name)}
  let fields = parse_shape_fields(toks, after_brace, [head], [])
  if contains(guest_primitive_types, nm.name) {
    miss ("'" + nm.name + "' is a reserved type name" + tok_at(toks, pos + 1))
  }
  else if contains(shapes_before(toks, pos, "block", 0, []), nm.name) {
    miss ("shape '" + nm.name + "' is already declared in this block" +
          tok_at(toks, pos + 1))
  }
  else {
    @{node: @{kind: "let", name: nm.name,
              value: @{kind: "record", pairs: fields.pairs}},
      pos: fields.pos}
  }
}

fn parse_stmt(toks, pos) {
  if is_kw(toks, pos, "let") {
    let nm = expect_name(toks, pos + 1)
    let after_eq = expect_op(toks, nm.pos, "=")
    let v = parse_expr(toks, after_eq)
    @{node: @{kind: "let", name: nm.name, value: v.node}, pos: v.pos}
  }
  else if is_kw(toks, pos, "fn") and is_ntype(toks, pos + 1, "name") {
    let nm = expect_name(toks, pos + 1)
    let ps = parse_params(toks, nm.pos, [], [])
    let ep = parse_effects_clause(toks, ps.pos)
    let rt = parse_typed_suffix(toks, ep, "->")
    let body0 = parse_block(toks, rt.pos)
    @{node: @{kind: "fndef", name: nm.name, params: ps.params, ret_type: rt.spec,
              param_types: build_param_contracts(ps.params, ps.types, 0, [],
                                                 " of " + nm.name),
              body: body0.node},
      pos: body0.pos}
  }
  else if is_kw(toks, pos, "check") {
    # v0.24 (round 360): the miss is the RESULT, not a field of it. It used
    # to be bound to `label` and stored in the node -- a miss inside a
    # record field is an ordinary value, so `check 1: 1 == 1` produced a
    # perfectly good `check` node whose label happened to be a failure, and
    # `parse_whence` returned success for a program the host refuses. The
    # only acceptance divergence in this file that was a MISSING refusal
    # rather than an over-permissive grammar rule.
    let k = t_at(toks, pos + 1)
    if k.t != "str" {
      miss ("expected a string label after 'check'" + tok_at(toks, pos + 1))
    } else {
      let after_colon = expect_op(toks, pos + 2, ":")
      let e = parse_expr(toks, after_colon)
      @{node: @{kind: "check", label: k.v, expr: e.node}, pos: e.pos}
    }
  }
  else if is_shape_head(toks, pos) { parse_shape_def(toks, pos) }
  else {
    let e = parse_expr(toks, pos)
    @{node: @{kind: "exprstmt", expr: e.node}, pos: e.pos}
  }
}

fn parse_if(toks, pos) {
  let cond = parse_expr(toks, pos + 1)
  let then = parse_block(toks, cond.pos)
  let after_then = skip_nl(toks, then.pos)
  if is_kw(toks, after_then, "else") {
    let after_else = after_then + 1
    let other = if is_kw(toks, after_else, "if") { parse_if(toks, after_else) }
      else { parse_block(toks, after_else) }
    @{node: @{kind: "if", cond: cond.node, then: then.node, otherwise: other.node},
      pos: other.pos}
  } else {
    miss ("'if' requires 'else'" + tok_at(toks, after_then))
  }
}

# ---- top level ---------------------------------------------------------
fn parse_program(toks) {
  let sl = parse_stmt_list(toks, skip_nl(toks, 0), "eof", [], [])
  if is_ntype(toks, sl.pos, "eof") { @{kind: "program", stmts: sl.stmts} }
  else { miss ("trailing input" + tok_at(toks, sl.pos)) }
}
# v0.24 (round 360): a LEX error is reported as a lex error. The `bad`
# token used to fall through to `parse_primary`'s catch-all, which reported
# `unexpected token 'unterminated string' at line 1` -- the lexer's message
# wedged into the slot where a token's TEXT goes. `whence/lexer.py` raises
# before `parse` is ever called, so the host says `unterminated string at
# line 1, col 9` and nothing about tokens; `lex` stops at the first bad
# character, so the bad token is always the last one.
fn lex_error_of(toks) {
  let last = t_at(toks, len(toks) - 1)
  if last.t == "bad" { last.v + tok_at(toks, len(toks) - 1) } else { "" }
}
fn parse_whence(src) {
  let toks = lex_all(src)
  let le = lex_error_of(toks)
  if le != "" { miss le } else { parse_program(toks) }
}

# ==== EVALUATOR (self-hosting rounds 4+5) ===================================

# ---- guest provenance: a guest value IS its provenance node (round 18) ------
# The host's v0.4 idea, applied one level up: every guest value is a BOX
#   @{v: payload, op: label, ins: [input boxes]}
# where `payload` is a host value (number, string, bool, miss, WList of
# boxes, record of boxes, tagged closure record) and `ins` are the boxes it
# was derived from. Reads pass through (name lookup, list index, field and
# `get` return the element's own box, exactly like the host); derivations
# wrap (`let x`, `arg n`, `call f`, `if then branch`, every operator and
# builtin). `why` REIFIES the box graph into ordinary guest records
# (@{op, v, ins}, budget-capped), so a guest program can traverse its own
# derivation with find/fold — no provenance builtins needed at guest level.
# Boxes carry no line numbers: the guest AST has none (the parser section is
# pinned byte-identical to self_host.lang). run_src strips boxes from its
# result, so callers and the host-vs-guest differential see plain values.
fn mkb(p, o, i) { @{v: p, op: o, ins: i} }

# strip: deep-unbox a guest value into a plain host-shaped value. Misses and
# closures pass through unchanged (a closure's fields are raw, not boxed).
# `strip_raw` takes the already-unboxed payload directly (round 176: needed
# by `raw_deep_eq`'s Guess-vs-Guess case, which recurses on `sure(x, 0)`'s
# result — a raw payload, not a box — rather than a fresh box to strip). A
# Guess falls through to the final `else { p }` unchanged, same as a
# closure: it is opaque to `strip`, matching the host's own "deliberately
# shallow" Guess design (indexing/field-access/etc. don't reach inside one).
fn strip_raw(p) {
  if missed(p) { p }
  else if is_callable(p) { p }
  else if is_list(p) { map(strip, p) }
  else if not missed(keys(p)) {
    fold(fn(acc, kk) { put(acc, kk, strip(get(p, kk))) }, @{}, keys(p))
  }
  else { p }
}
fn strip(b) { strip_raw(b.v) }

# reify: box graph -> guest-visible records, threading a node budget so a
# shared/deep history cannot blow up (the host caps render_why the same way;
# a node past the budget keeps its op and payload but drops its inputs).
fn reify_node(op, p, rins) {
  mkb(@{op: mkb(op, "literal", []), v: mkb(p, "literal", []),
        ins: mkb(rins, "list", rins)}, "why", [])
}
fn reify_ins(ins, i, acc, k) {
  if i >= len(ins) or k <= 0 { @{acc: acc, k: k} }
  else {
    let r = reify(ins[i], k)
    reify_ins(ins, i + 1, push(acc, r.r), r.k)
  }
}
fn reify(b, k) {
  if k <= 0 { @{r: reify_node(b.op, b.v, []), k: 0} }
  else {
    let sub = reify_ins(b.ins, 0, [], k - 1)
    @{r: reify_node(b.op, b.v, sub.acc), k: sub.k}
  }
}

# ---- the store: every frame of every environment, one immutable record -----
# f0 is the builtin frame; a guest builtin value is a tagged record naming
# which host builtin it stands for.
let builtin_names = ["print", "rand", "len", "range", "map", "filter", "fold",
                     "push",
                     "str", "num", "abs", "sqrt", "trunc", "missed", "reasons",
                     "note",
                     "contains", "join", "keys", "merge", "get", "put", "has",
                     "find", "typed", "guess", "is_guess", "confidence", "sure",
                     "steps", "at", "blame", "diverge", "contrast",
                     "matches", "shapeof"]

# host builtins whose first step is `_propagate` (a miss argument yields
# a "builtin"-op miss before the builtin looks at anything). `is_guess` is
# deliberately absent — like `missed`/`matches`, it is total and never
# itself propagates a miss (round 176, v0.15 guest parity). `steps`/`at`/
# `blame`/`diverge`/`contrast` are ALSO deliberately absent for the same
# reason: interp.py's own comment above `b_steps` says "these are total:
# they work on misses (that is the point)" — walking a failed value's own
# history is provenance-as-data's whole purpose, so a miss argument must
# reach the real host call below, not get shortcut into a generic
# "builtin"-op miss first (round 206 for `steps`; round 218 extends the
# same reasoning to the rest of the provenance-as-data family below).
let propagating = ["len", "range", "num", "abs", "sqrt", "trunc", "contains",
                   "join", "keys", "merge", "has", "put", "guess",
                   "confidence", "sure"]
let arities = @{print: 1, rand: 0, len: 1, range: -1, map: 2, filter: 2,
                fold: 3,
                push: 2, str: 1, num: 1, abs: 1, sqrt: 1, trunc: 1, missed: 1,
                guess: 3, is_guess: 1, confidence: 1, sure: 2,
                reasons: 1, note: 2, contains: 2, join: 2, keys: 1,
                merge: 2, get: 2, put: 3, has: 2, find: 2, typed: 3,
                steps: -1, at: 2, blame: 1, diverge: -1, contrast: -1,
                matches: 2, shapeof: 1}

# round 210: guest-level function-CALL depth ceiling, checked only in
# apply_closure (see the module-doc comment above and apply_closure's own
# comment below for why this is the right, and only needed, choke point).
# Picked with a wide safety margin under host max_depth/~15 (~1300): no
# example or self-hosting test corpus this project has ever run comes
# close to 400 real guest-level call frames, and even a legitimate,
# intentionally-deep guest recursion test should prefer a graceful guest
# miss at a small, predictable depth over silently depending on exactly
# where the host's own guard happens to land.
let GUEST_MAX_DEPTH = 400

fn new_store() {
  let f0 = fold(fn(fr, n) {
      put(fr, n, mkb(@{__tag: "builtin", name: n}, "builtin " + n, []))
    }, @{}, builtin_names)
  @{frames: put(@{}, "f0", f0), next: 1, checks: [], gd: 0}
}

fn alloc(st) {
  let fid = "f" + str(st.next)
  @{fid: fid,
    st: merge(st, @{frames: put(st.frames, fid, @{}), next: st.next + 1})}
}

fn frame_bind(st, fid, name, v) {
  merge(st, @{frames: put(st.frames, fid,
                          put(get(st.frames, fid), name, v))})
}

# innermost frame that HAS the name wins; reading the store at call time is
# what makes binding late, like the host's mutable Env chain
fn lookup(st, env, name) {
  let fid = find(fn(f) { contains(keys(get(st.frames, f)), name) }, env)
  if missed(fid) { miss ("unbound name '" + name + "'") }
  else { get(get(st.frames, fid), name) }
}

# ---- type tests without a typeof: total operations + missed ----------------
# `v + []` succeeds exactly for lists; `v == true or v == false` is safe once
# misses are excluded (== across types is false, on misses it is a miss).
# guest_tag reads a RAW __tag string, which only genuine closures/builtin
# refs carry — a user record's fields are boxes, and a box never == a string,
# so the old __tag-spoofing leak is closed by boxing itself.
#
# v0.15 guest parity (round 176): a guest Guess value is not a hand-rolled
# tagged record like a closure — it is the REAL host `Guess` payload,
# produced by delegating the `guess`/`is_guess`/`confidence`/`sure`
# builtins straight to the host (see `apply_host_builtin`), so arithmetic
# and comparisons on a guest Guess reuse the host's OWN `_guess_binop`/
# `_unary` propagation for free (the guest never re-derives that machinery
# in Whence source). The cost of that shortcut: every "does v look like a
# T" probe below (`v + 0`, `v + []`, `v == true or v == false`) ALSO
# succeeds for a Guess wrapping that same shape, because Guess arithmetic
# is transparent by design — `is_num`/`is_list`/`is_bool` would otherwise
# misreport a `guess(5, ...)` as a plain number. `is_guess_val` must be
# checked FIRST (or these three guarded against it) everywhere a value's
# kind is probed; `is_guess` itself is total (never misses), so this is a
# plain delegating call, same as `missed`/`matches` elsewhere in this file.
fn is_guess_val(v) { is_guess(v) }

# Round 234: `sure(g, t)` above-threshold pass-through needs the box for
# `g.node` -- the host's `Guess.node` field (interp.py's `b_guess`), set
# ONCE at `guess()` construction time to the RAW pre-wrap argument node,
# untouched by any later `let`/`guess` wrapper. The guest has no accessor
# for a Guess's raw `.node` (same reason it has none for `.sources`, see
# the v0.15 guest-parity note above) -- but the box for that exact same
# node is still reachable by walking the GUEST's own box structure: a
# `let NAME`/`arg NAME` box threads its one real value through unchanged
# (single `ins` element), so descending through a chain of those reaches
# whichever box actually called `guess(...)`; that box's OWN first
# argument is exactly what `b_guess` stored as `.node`. Repeating the walk
# when that argument is ITSELF still a Guess mirrors `b_guess`'s own
# guess-of-guess flattening (`node = g.node` of the INNER Guess, not the
# inner "guess" node). A box with more than one `ins` element (a real
# `call`/`if`/tail-loop merge) is not safely traceable this way -- falls
# back to returning the box UNCHANGED, i.e. the same imperfect-but-safe
# generic wrapping this file used everywhere before this round, not a new
# failure mode.
fn unwrap_guess_box(box) {
  if box.op == "guess" {
    let inner = (box.ins)[0]
    if is_guess_val(inner.v) { unwrap_guess_box(inner) } else { inner }
  }
  else if len(box.ins) == 1 { unwrap_guess_box((box.ins)[0]) }
  else { box }
}
fn is_bool(v) {
  not is_guess_val(v) and not missed(v) and (v == true or v == false)
}
fn is_list(v) { not is_guess_val(v) and not missed(v + []) }
fn guest_tag(v) { (get(v, "__tag")) rescue "" }
fn is_closure(v) { guest_tag(v) == "closure" }
fn is_builtin_ref(v) { guest_tag(v) == "builtin" }
fn is_callable(v) {
  let t = guest_tag(v)
  t == "closure" or t == "builtin"
}

# Round 156: mirrors the host's `show_payload` rendering of a callable
# (`Closure`/`Builtin` in whence/values.py, "<fn %s>"/"<fn>"/"<builtin %s>")
# so guest-built miss REASONS and op-LABELS that name a function read
# identically to the host's for the same program — required wherever a
# guest miss message embeds `str(callee)` (`get`/`.field` on a callable),
# since the host never falls through to a plain record dump the way an
# un-mirrored `str()` on the closure's underlying `@{__tag: "closure", ...}`
# record would.
fn show_callable(v) {
  if is_closure(v) {
    let n = get(v, "name")
    if n == "(anonymous)" { "<fn>" } else { "<fn " + n + ">" }
  }
  else if is_builtin_ref(v) { "<builtin " + get(v, "name") + ">" }
  else { str(v) }
}
fn is_num(v) { not is_guess_val(v) and not missed(v) and not missed(v + 0) }
# is_record needs no Guess guard: `keys()` on a Guess cleanly misses at the
# host ("keys needs a record, got guess ..."), same as on any other
# non-record scalar — verified, not inferred (round 176).
fn is_record(v) { not missed(v) and not is_callable(v) and not missed(keys(v)) }
# The host's deep_eq misses on a function at ANY depth ([odd] == [odd] and
# @{a: odd} == @{a: odd} are misses, not true); a top-level-only test let
# the guest say `[odd, even] == [odd, even]` is true (round 107, guest
# differential seed 115). List items and record fields are boxes.
fn holds_callable(v) {
  if missed(v) { false }
  else if is_callable(v) { true }
  else if is_list(v) { not missed(find(fn(b) { holds_callable(b.v) }, v)) }
  else if is_record(v) {
    not missed(find(fn(k) { holds_callable((get(v, k)).v) }, keys(v)))
  }
  else { false }
}

# ---- eval: node x env x store -> @{v: box, st} ------------------------------
fn eval(node, env, st) {
  let k = node.kind
  if k == "num" or k == "str" or k == "bool" {
    @{v: mkb(node.value, "literal", []), st: st}
  }
  else if k == "name" {
    let b = lookup(st, env, node.value)
    @{v: if missed(b) { mkb(b, "name", []) } else { b }, st: st}
  }
  else if k == "list" {
    let r = eval_items(node.items, 0, [], env, st)
    # Round 156: the op tag must carry the item count to match the host's
    # real label ("list %d items", interp.py's `f_list`) — a bare "list"
    # tag (found by hand-probing the same why-shape-agreement property the
    # get()/field fixes above target, not yet by the guest fuzzer itself)
    # diverged for every list literal, not just an edge case.
    @{v: mkb(r.v, "list " + str(len(r.v)) + " items", r.v), st: r.st}
  }
  else if k == "record" {
    let r = eval_pairs(node.pairs, 0, @{}, env, st)
    @{v: mkb(r.v, "record", map(fn(kk) { get(r.v, kk) }, keys(r.v))), st: r.st}
  }
  else if k == "binary" { eval_binary(node, env, st) }
  else if k == "unary" { eval_unary(node, env, st) }
  else if k == "if" { eval_if(node, env, st) }
  else if k == "block" { eval_block(node, env, st) }
  else if k == "call" { eval_call(node, env, st) }
  else if k == "index" { eval_index(node, env, st) }
  else if k == "field" { eval_field(node, env, st) }
  else if k == "fnexpr" {
    @{v: mkb(@{__tag: "closure", name: "(anonymous)", params: node.params,
               body: node.body, ret_spec: resolve_ret_spec(node.ret_type, env, st),
               param_specs: resolve_param_specs(node.param_types, env, st, 0, []),
               env: env},
             "fn (anonymous)", []),
      st: st}
  }
  else { @{v: mkb(miss ("unknown node kind '" + str(k) + "'"), "eval", []), st: st} }
}

fn eval_items(items, i, acc, env, st) {
  if i >= len(items) { @{v: acc, st: st} }
  else {
    let r = eval(items[i], env, st)
    eval_items(items, i + 1, push(acc, r.v), env, r.st)
  }
}

fn eval_pairs(pairs, i, acc, env, st) {
  if i >= len(pairs) { @{v: acc, st: st} }
  else {
    let p = pairs[i]
    let r = eval(p.value, env, st)
    eval_pairs(pairs, i + 1, put(acc, p.name, r.v), env, r.st)
  }
}

# ---- operators: delegate to the HOST operator on the payloads, so its
# semantics (misses, strictness, overflow, merge-of-reasons) come for free;
# the result box records the operator and both operand boxes ----------------
fn is_str(v) { not is_guess_val(v) and not missed(v) and not missed(v + "") }

# ---- structural types (v0.12/v0.13 guest parity, round 158) ----------------
# `guest_kind` mirrors the host's `_kind` (interp.py): the primitive tag a
# value reports itself as, same order (bool before num — a host bool IS an
# int; callable checked before record, since a closure/builtin ref is
# itself a record under the hood, see `guest_tag`). Primitive tags only —
# `guest_type_ok`'s own spec is always a plain string, because that is what
# `guest_type_ok` is FOR; the record-spec branch is `guest_spec_match`.
# This sentence used to give the reason as "the guest has no `shape`
# DECLARATIONS", which round 338 made false in this very file (it added the
# `shape` statement to the shared parser section) and which survived
# unchanged for 24 rounds — the same stale-note class SPEC.md's own v0.12
# section carries a correction for. Corrected round 362; the CONCLUSION was
# right, only its stated reason was not. STALE until round 335 as to what
# follows from that: this used to add "anything else (a record spec, i.e. a shape)
# simply never matches, same as an unrecognised primitive name would",
# which confuses a shape DECLARATION with a spec VALUE -- a hand-built
# record IS a legal structural spec on the host and guest programs write
# record literals freely. `guest_spec_match` (below `guest_type_ok`) is
# the branch that handles one; `guest_type_ok` itself keeps the plain-
# string contract this comment describes. `guess` is checked
# right after `miss` (round 176, v0.15 guest parity) — it must come before
# every other test below because Guess arithmetic transparently succeeds
# (see `is_guess_val`'s docstring above), so e.g. `is_num` would otherwise
# misfire on a Guess wrapping a number.
fn guest_kind(v) {
  if missed(v) { "miss" }
  else if is_guess_val(v) { "guess" }
  else if is_bool(v) { "bool" }
  else if is_num(v) { "num" }
  else if is_str(v) { "str" }
  else if is_list(v) { "list" }
  else if is_callable(v) { "fn" }
  else if is_record(v) { "record" }
  else { "value" }
}

fn guest_type_ok(v, spec) {
  is_str(spec) and (spec == "any" or guest_kind(v) == spec)
}

# Round 335: `guest_type_ok` above (and `guest_kind`'s comment) assume a
# spec is ALWAYS a plain string, "anything else (a record spec, i.e. a
# shape) simply never matches". That was said to be true of a `shape`
# DECLARATION "because the guest parser has none" -- itself stale since
# round 338 (corrected round 362, see `guest_kind` above) -- but it is not
# true of a spec VALUE either: `typed`/`matches`
# accept an ordinary hand-built record as a structural spec on the host by
# design (SPEC v0.12: "a record built entirely by hand, with no relation to
# the shape ever declared, matches it exactly as one built from it"), and
# an ordinary record literal is something guest programs write freely.
# Round 240 already found and fixed exactly this for `matches`
# (`apply_host_builtin`, via `strip()`); the `typed` branch of
# `apply_builtin` was never revisited and still rejected every Record spec
# outright, so `typed(@{a: 1}, @{a: "num"}, "L")` passed the record
# through on the host and missed on the guest -- a real value divergence,
# plus a guest-only `record` op in the why-shape (the reject branch keeps
# all three args as inputs, the host's mismatch keeps only the value).
#
# `guest_spec_match` is the shared test both now go through. Same three
# cases, same order, same reasoning as the `matches` branch: a callable
# only ever matches a STRING spec (a guest closure is an ordinary
# `@{__tag: "closure", ...}` record under the hood, so a structural spec
# would otherwise match its internals -- round 18's tag-spoofing shape);
# a string spec keeps the cheap non-recursive `guest_type_ok` path
# unchanged; anything else delegates to the real host `matches` over
# `strip()`ped operands, which is exactly `_type_match` with the guest's
# `{v, op, ins}` boxes removed from both sides.
fn guest_spec_match(vbox, specbox) {
  let v = vbox.v
  let spec = specbox.v
  if is_callable(v) { is_str(spec) and (spec == "any" or spec == "fn") }
  else if is_str(spec) { guest_type_ok(v, spec) }
  else { matches(strip(vbox), strip(specbox)) }
}

# The name a mismatch message calls the spec, mirroring host `_type_match`'s
# own `desc`: a string spec names itself, a record spec names its `__shape`
# when that field holds a string and "record" otherwise. Needed because the
# old message built `label + " expected " + spec + ...` by string concat,
# which is itself a MISS when `spec` is a record.
fn guest_spec_name(spec) {
  if is_str(spec) { spec }
  else {
    let n = get(spec, "__shape")
    if is_str(n) { n } else { "record" }
  }
}

# v0.20: the FIELD-level reason a record failed a record spec — the guest
# mirror of the host's `_match_why` (interp.py). "" is its "nothing more to
# say" answer, the same sentinel `param_spec_at`/`unbound_ret_name` use.
#
# Both sides walk `keys(spec)`, which SORTS, and that is the whole reason
# the host walks `sorted(spec.fields)` rather than its own declaration
# order: declaration order lives in the host's `fields` dict and is not
# recoverable through any Whence builtin, so a declaration-order rule would
# be one the guest could not express, and the two sides would name
# different fields in every multi-field mismatch. Same reasoning as
# decision 27 — what the guest can recover from the language is what the
# rule may depend on.
#
# `is_callable(v)` before `is_record(v)` for the reason `guest_spec_ok`
# gives: a guest closure is an ordinary record under the hood, and the
# host's own `isinstance(payload, Record)` excludes a Closure, so without
# the exclusion this would walk a closure's internals (round 18's
# tag-spoofing shape).
#
# `matches(fv, fspec)` is exactly the host's `_type_match(fv, fspec)[0]`
# here: every caller has already established `guest_spec_ok(spec)`, which
# is recursive, so no nested spec can be the malformed kind `matches`
# answers false for on principle rather than on structure.
fn guest_match_why(v, spec, path) {
  if is_str(spec) or is_callable(v) or not is_record(v) { "" }
  else { guest_match_why_at(v, spec, keys(spec), 0, path) }
}

fn guest_match_why_at(v, spec, ks, i, path) {
  if i >= len(ks) { "" }
  else if ks[i] == "__shape" { guest_match_why_at(v, spec, ks, i + 1, path) }
  else {
    let here = path + "'" + ks[i] + "'"
    if not has(v, ks[i]) { "no field " + here }
    else {
      let fv = get(v, ks[i])
      let fspec = get(spec, ks[i])
      if missed(fv) { "field " + here + " is a miss" }
      else if matches(fv, fspec) {
        guest_match_why_at(v, spec, ks, i + 1, path)
      }
      else {
        let deeper = guest_match_why(fv, fspec, here + ".")
        if deeper != "" { deeper }
        else {
          "field " + here + " expected " + guest_spec_name(fspec) +
            ", got " + guest_kind(fv)
        }
      }
    }
  }
}

# The full text of a failed type check, mirroring host `_mismatch_reason`:
# the v0.12 message plus `guest_match_why`'s clause when there is one. Both
# guest sites that build a mismatch message (`check_contract` and the
# `typed` builtin) go through here, exactly as both host sites do.
fn guest_mismatch_reason(label, vraw, spec_raw, sname) {
  let base = label + " expected " + sname + ", got " + guest_kind(vraw)
  # `why` is a KEYWORD (`why x` reifies a history), so it cannot name a
  # binding — the host's `_mismatch_reason` calls this local `why`.
  let clause = guest_match_why(vraw, spec_raw, "")
  if clause == "" { base } else { base + " (" + clause + ")" }
}

# raw_deep_eq mirrors the host's OWN deep_eq (interp.py): recurse only while
# both sides have the SAME shape at the position being compared (bool/bool,
# num/num, str/str, same-length list/list, same-keyset record/record) — a
# SHAPE MISMATCH at any level resolves to false immediately, exactly like
# the host's stack-based walk, WITHOUT ever inspecting whether a callable
# lurks inside the side that was never descended into. `guest_eq`'s old
# implementation instead asked "does a callable exist ANYWHERE in either
# operand" up front (`holds_callable`) — round 140's guest-differential
# fuzzer found this over-fires: `0 != [adder, "-inf", 0]` compares a num to
# a list (host: different top-level types, false immediately, the list is
# never opened) but the guest reported a miss purely because `adder` sits
# somewhere inside the unopened list. Only once two operands are
# shape-identical all the way down does hitting a callable at a
# genuinely-reached position miss, matching the host's `_OPAQUE` check
# firing on the exact pair it pops off its stack (round 107's
# `[odd] == [odd]` case: both lists, same length, recurses to (odd, odd),
# both callable at that reached position -> miss, still correct here).
# v0.28 (round 372): a TOP-LEVEL miss operand propagates (the host never
# reaches `deep_eq` -- `binop` merges the miss first), but a NESTED one is
# `deep_eq` returning None, which the host now words `cannot compare misses
# with ==`. Splitting the two cases here is what lets `raw_deep_eq` say the
# host's sentence without swallowing propagation.
fn guest_eq(a, b) {
  let x = strip(a)
  let y = strip(b)
  if missed(x) { x } else if missed(y) { y } else { raw_deep_eq(x, y) }
}

fn raw_deep_eq(x, y) {
  # v0.28: the host's message names the KIND that stopped the comparison
  # (`_incomparable_kind`, interp.py) -- it said "functions" for all four
  # of `deep_eq`'s opaque kinds until round 372. The guest can name two of
  # them: a callable is a tagged record it can see, and a miss it can test.
  # It cannot name `explanations`, because a guest `why` value is a REIFIED
  # record, not an opaque payload -- that is the v0.28 EXEMPTION E1, and it
  # is the same reason the guest cannot refuse `@{} == why 1` at all.
  if missed(x) { miss "cannot compare misses with ==" }
  else if missed(y) { miss "cannot compare misses with ==" }
  else if is_callable(x) or is_callable(y) {
    miss "cannot compare functions with =="
  }
  # v0.15 guest parity (round 176): mirrors the host `deep_eq`'s OWN
  # Guess-vs-Guess case exactly — structural equality is about the
  # ANSWER, not how sure either side was (confidence/sources are
  # metadata, not identity), and ONLY when BOTH sides are a Guess; a
  # Guess compared against a plain value here falls through to "different
  # types" below, same as the host. `sure(_, 0)` is the guest's only way
  # to reach a Guess's wrapped answer (no `.node`/`.sources` accessor is
  # exposed) — threshold 0 always passes (confidence is never negative),
  # so it is a pure unwrap, never itself a miss. This is deliberately
  # DIFFERENT from top-level `==` (`apply_binop`, below), which wraps the
  # comparison's own result in a NEW Guess instead of returning a plain
  # bool — the same asymmetry the host's `_guess_binop` vs `deep_eq` has.
  else if is_guess_val(x) and is_guess_val(y) {
    raw_deep_eq(strip_raw(sure(x, 0)), strip_raw(sure(y, 0)))
  }
  else if is_bool(x) or is_bool(y) {
    if is_bool(x) and is_bool(y) { x == y } else { false }
  }
  else if is_num(x) and is_num(y) { x == y }
  else if is_str(x) and is_str(y) { x == y }
  else if is_list(x) and is_list(y) {
    if len(x) != len(y) { false } else { raw_deep_eq_list(x, y, 0) }
  }
  else if is_record(x) and is_record(y) {
    if len(keys(x)) != len(keys(y)) { false }
    else if missed(find(fn(k) { not has(y, k) }, keys(x))) {
      raw_deep_eq_fields(x, y, keys(x), 0)
    }
    else { false }
  }
  else { false }
}

fn raw_deep_eq_list(x, y, i) {
  if i >= len(x) { true }
  else {
    let r = raw_deep_eq(x[i], y[i])
    if missed(r) { r } else if r { raw_deep_eq_list(x, y, i + 1) } else { false }
  }
}

fn raw_deep_eq_fields(x, y, ks, i) {
  if i >= len(ks) { true }
  else {
    let k = ks[i]
    let r = raw_deep_eq(get(x, k), get(y, k))
    if missed(r) { r } else if r { raw_deep_eq_fields(x, y, ks, i + 1) } else { false }
  }
}

# Round 252: closes round 251's `guess()`-vs-`>` why-vocab gap. The host's
# own `_guess_binop`/`_unary` (interp.py) are ASYMMETRIC: when an op with a
# Guess operand SUCCEEDS, the node it returns uses the ORIGINAL operand
# node(s) as inputs (the outer "guess"-labeled node included); when it
# MISSES (e.g. ordering a Guess against an incompatible type, or negating a
# Guess-wrapped string), the node it returns is whatever the plain
# `binop()`/`_unary()` built from the Guess's UNWRAPPED inner node
# (`Guess.node`) instead — the outer "guess" node is silently dropped, so
# the host's own why-tree for that miss never mentions "guess" at all
# (verified directly against the host: `guess(0, 0.0, "sampled") > @{...}`'s
# miss node has inputs `(literal 0, record ...)`, no "guess" node anywhere;
# same for `-guess("hi", 0.9, "m")`, `not guess(1, 0.9, "m")`). Both
# `apply_binop` and `eval_unary` boxed their inputs uniformly (`[a, b]` /
# `[r.v]`), which didn't mirror that asymmetry: a miss on a Guess operand
# leaked a "guess" op into the guest's why-tree the host's real derivation
# never has — round 251's minimized repro (`apply_binop`'s `>` case); the
# matching `eval_unary` gap (found this round, checking the sibling code
# path for the same class of bug) was never fuzzed since the differential
# generator's grammar has no unary-minus-on-Guess/not-on-Guess template.
# Fixed by reusing the SAME `unwrap_guess_box` helper `sure()` already
# relies on (round 234) to reconstruct the guest box for a Guess's `.node`,
# applied to whichever operand(s) are Guess-valued, but ONLY when the
# result missed; a succeeding Guess propagation keeps the original box(es)
# unchanged, same as the host's success path.
fn guess_unwrap_if_missed(a, p) {
  if missed(p) and is_guess_val(a.v) { unwrap_guess_box(a) } else { a }
}
fn binop_ins(a, b, p) { [guess_unwrap_if_missed(a, p), guess_unwrap_if_missed(b, p)] }
fn unary_ins(a, p) { [guess_unwrap_if_missed(a, p)] }

# v0.28 (round 372): the arithmetic/ordering dispatch, on bare PAYLOADS, so
# `apply_binop` can run it twice -- once on the guest's boxed payloads (the
# answer) and, only when that misses, once on stripped ones (the wording).
fn raw_binop(op, x, y) {
  if op == "+" { x + y }
  else if op == "-" { x - y }
  else if op == "*" { x * y }
  else if op == "/" { x / y }
  else if op == "%" { x % y }
  else if op == "<" { x < y }
  else if op == "<=" { x <= y }
  else if op == ">" { x > y }
  else if op == ">=" { x >= y }
  else { miss ("unknown operator '" + op + "'") }
}

fn apply_binop(op, a, b) {
  # v0.15 guest parity (round 176): `+ - * / % < <= > >=` need NO Guess
  # handling at all — `a.v OP b.v` is genuine top-level Whence source (this
  # whole file runs directly under the real host interpreter), so a Guess
  # operand already gets the host's real `_guess_binop` propagation for
  # free, for exactly the same reason `is_num`/`is_bool` above had to be
  # guarded (arithmetic on a Guess silently succeeds). `==`/`!=` are the
  # one exception: they deliberately do NOT delegate to the host's real
  # `==`/`!=` for the non-Guess case (`guest_eq`/`raw_deep_eq` exist so a
  # GUEST closure — an ordinary host record under the hood — reads as
  # opaque instead of comparing its fields structurally, round 107/140).
  # A Guess operand bypasses that guest-authored comparator on purpose:
  # the host's top-level `==`/`!=` wrap the comparison's OWN result in a
  # NEW Guess (weakest-link confidence, sources unioned, `_guess_binop`,
  # NOT `deep_eq`), and reconstructing that by hand in Whence source is
  # impossible anyway (no `.sources` accessor is exposed to guest code) —
  # delegating straight to the real operator reproduces it exactly, for
  # free, the same trick the arithmetic ops above already rely on.
  let p0 = if op == "==" {
      if is_guess_val(a.v) or is_guess_val(b.v) { a.v == b.v }
      else { guest_eq(a, b) }
    }
    else if op == "!=" {
      if is_guess_val(a.v) or is_guess_val(b.v) { a.v != b.v }
      else {
        let e = guest_eq(a, b)
        not e
      }
    }
    else { raw_binop(op, a.v, b.v) }
  # v0.28 (round 372): the delegation above hands the host the guest's own
  # payload, and a COMPOUND guest payload is a list/record of BOXES. On the
  # success path that is exactly right ([1] + [2] must concatenate the
  # boxes). On the miss path the host words the message around what it was
  # given, so `[1] + 0` read `cannot add [@{ins: [@{...}...] and 0`. Re-run
  # the operator on deep-stripped payloads and keep THAT wording, only when
  # both runs miss -- so a strip that changes the answer cannot change what
  # this function returns. `==`/`!=` are excluded: `guest_eq` is authored
  # here on purpose (a guest closure must read opaque, round 107/140) and
  # the host's `==` would not reproduce it.
  let p = if missed(p0) and op != "==" and op != "!=" and
            (is_compound(a.v) or is_compound(b.v)) {
      let p1 = raw_binop(op, strip(a), strip(b))
      if missed(p1) { p1 } else { p0 }
    } else { p0 }
  mkb(p, op, binop_ins(a, b, p))
}

fn eval_binary(node, env, st) {
  let op = node.op
  if op == "and" { eval_and(node, env, st) }
  else if op == "or" { eval_or(node, env, st) }
  else if op == "rescue" {
    let l = eval(node.left, env, st)
    if missed(l.v.v) {
      let r = eval(node.right, env, l.st)
      @{v: mkb(r.v.v, "rescue recovered", [r.v, l.v]), st: r.st}
    } else { l }
  }
  else {
    let l = eval(node.left, env, st)
    let r = eval(node.right, env, l.st)
    @{v: apply_binop(op, l.v, r.v), st: r.st}
  }
}

# short-circuit: the right EXPRESSION is only evaluated when needed; a
# miss/non-bool left is handed to the host operator, which words the miss
fn eval_and(node, env, st) {
  let l = eval(node.left, env, st)
  if not is_bool(l.v.v) {
    # v0.28: same box-leak re-render as `apply_binop` -- the host words
    # this miss, so it must be handed the stripped payload.
    let p = if is_compound(l.v.v) {
              remsg(l.v.v and true, strip(l.v) and true)
            } else { l.v.v and true }
    @{v: mkb(p, "and", [l.v]), st: l.st}
  }
  else if l.v.v == false {
    @{v: mkb(false, "and short-circuit", [l.v]), st: l.st}
  }
  else {
    let r = eval(node.right, env, l.st)
    @{v: mkb(true and r.v.v, "and", [l.v, r.v]), st: r.st}
  }
}

fn eval_or(node, env, st) {
  let l = eval(node.left, env, st)
  if not is_bool(l.v.v) {
    let p = if is_compound(l.v.v) {
              remsg(l.v.v or true, strip(l.v) or true)
            } else { l.v.v or true }
    @{v: mkb(p, "or", [l.v]), st: l.st}
  }
  else if l.v.v == true {
    @{v: mkb(true, "or short-circuit", [l.v]), st: l.st}
  }
  else {
    let r = eval(node.right, env, l.st)
    @{v: mkb(false or r.v.v, "or", [l.v, r.v]), st: r.st}
  }
}

fn eval_unary(node, env, st) {
  let r = eval(node.operand, env, st)
  let op = node.op
  let b = if op == "-" {
      # v0.28 (round 372): `0 - x` is a BINOP, and the host words a failed
      # one `cannot apply '-' to 0 and @{}`. The host's own unary minus
      # (`_unary`) says `cannot negate @{}`. Negate for real, and re-render
      # from the stripped payload for the same reason as `apply_binop`.
      let p = if is_compound(r.v.v) { remsg(- (r.v.v), - (strip(r.v))) }
              else { - (r.v.v) }
      mkb(p, "-", unary_ins(r.v, p))
    }
    else if op == "not" {
      let p = if is_compound(r.v.v) { remsg(not r.v.v, not strip(r.v)) }
              else { not r.v.v }
      mkb(p, "not", unary_ins(r.v, p))
    }
    # host `_miss_lit` (interp.py) only keeps the reason box as an input
    # when the reason is itself a miss (propagation) or a valid string
    # (the normal case); a non-string, non-miss reason (e.g. `miss 1`)
    # discards the operand entirely and yields a fresh 0-input miss node
    # (round 210 fix: this branch used to ALWAYS keep [r.v], inventing a
    # "literal" op the host derivation never has for that third case).
    else if op == "miss" {
      # v0.28: the non-string branch is the one whose message renders the
      # reason, so it is the one that box-leaked (`miss len` read
      # `... got @{__tag: "builtin", name: "len"}`).
      if missed(r.v.v) or is_str(r.v.v) { mkb(miss r.v.v, "miss", [r.v]) }
      else if is_compound(r.v.v) {
        mkb(remsg(miss r.v.v, miss strip(r.v)), "miss", [])
      }
      else { mkb(miss r.v.v, "miss", []) }
    }
    else if op == "why" { (reify(r.v, 300)).r }
    else if op == "snip" { mkb(r.v.v, "snipped", []) }
    else { mkb(miss ("unknown unary '" + op + "'"), "unary", []) }
  @{v: b, st: r.st}
}

# a miss/non-bool condition goes through a real host `if`, which words the
# miss exactly as the host would ("if condition must be true/false, ...")
fn eval_if(node, env, st) {
  let c = eval(node.cond, env, st)
  if not is_bool(c.v.v) {
    @{v: mkb(if c.v.v { true } else { true }, "if", [c.v]), st: c.st}
  }
  else if c.v.v {
    let r = eval(node.then, env, c.st)
    @{v: mkb(r.v.v, "if took then-branch", [r.v, c.v]), st: r.st}
  }
  else {
    let r = eval(node.otherwise, env, c.st)
    @{v: mkb(r.v.v, "if took else-branch", [r.v, c.v]), st: r.st}
  }
}

fn eval_block(node, env, st) {
  let a = alloc(st)
  exec_stmts(node.stmts, 0, [a.fid] + env, a.st,
             mkb(miss "empty block", "block", []))
}

fn exec_stmts(stmts, i, env, st, last) {
  if i >= len(stmts) { @{v: last, st: st} }
  else {
    let r = exec_stmt(stmts[i], env, st)
    exec_stmts(stmts, i + 1, env, r.st, r.v)
  }
}

fn exec_stmt(stmt, env, st) {
  let k = stmt.kind
  if k == "exprstmt" { eval(stmt.expr, env, st) }
  else if k == "let" {
    let r = eval(stmt.value, env, st)
    let w = mkb(r.v.v, "let " + stmt.name, [r.v])
    @{v: w, st: frame_bind(r.st, env[0], stmt.name, w)}
  }
  else if k == "fndef" {
    let c = mkb(@{__tag: "closure", name: stmt.name, params: stmt.params,
                  body: stmt.body,
                  ret_spec: resolve_ret_spec(stmt.ret_type, env, st),
                  param_specs: resolve_param_specs(stmt.param_types, env, st,
                                                   0, []),
                  env: env},
                "fn " + stmt.name, [])
    @{v: c, st: frame_bind(st, env[0], stmt.name, c)}
  }
  else if k == "check" {
    let r = eval(stmt.expr, env, st)
    let ok = if missed(r.v.v) { false } else { r.v.v == true }
    @{v: r.v,
      st: merge(r.st, @{checks: push(r.st.checks,
                                     @{label: stmt.label, pass: ok})})}
  }
  else { @{v: mkb(miss ("unknown statement kind '" + str(k) + "'"), "eval", []),
           st: st} }
}

# ---- calls ------------------------------------------------------------------
fn eval_call(node, env, st) {
  let f = eval(node.func, env, st)
  let a = eval_items(node.args, 0, [], env, f.st)
  apply(f.v, a.v, a.st)
}

fn apply(f, args, st) {
  if missed(f.v) { @{v: mkb(f.v, "call", [f] + args), st: st} }
  else if is_closure(f.v) { apply_closure(f, args, st) }
  else if is_builtin_ref(f.v) { apply_builtin(f.v.name, args, st) }
  else {
    # v0.25 (round 362): `show_val`, not `str`. The host renders this with
    # `show_payload`, which QUOTES a string — `"hi" is not callable` — and
    # the old `show_spec`'s own comment cited this very site as the place
    # the "every other payload agrees between the two" assumption came
    # from. It did not agree: `let f = "hi"` read `hi is not callable`
    # here. One renderer, every value slot.
    @{v: mkb(miss (show_val(strip(f)) + " is not callable"), "call", [f]),
      st: st}
  }
}

# NOTE the host calls functions WITH miss arguments (f(miss) runs the body);
# so does the guest: bind_params binds whatever it is given, wrapped in an
# `arg <name>` node exactly like the host's per-param binding step.
#
# round 330: the "call " + <name> op-LABEL built at every return point below
# must mirror the host's own `name = p.name or "<fn>"` (interp.py's
# `_call_direct`/`_call_gen`) exactly, the same "(anonymous)" sentinel ->
# "<fn>" substitution `check_ret`'s `label` already applies (round 326).
# Closes round 326's own "named, not chased" open question: confirmed live
# that `apply_closure`'s UNCONDITIONAL `"call " + c.name` diverged from the
# host for an anonymous closure ("call (anonymous)" vs host's "call <fn>")
# — a real label mismatch, not an intentional divergence like the
# depth-guard REASON text one line below (a different guest-only budget,
# `GUEST_MAX_DEPTH`, with its own deliberately different wording).
fn call_op_name(name) { if name == "(anonymous)" { "<fn>" } else { name } }

fn apply_closure(f, args, st) {
  let c = f.v
  let op_name = call_op_name(c.name)
  if len(args) != len(c.params) {
    # v0.28 (round 372): the host says `<name> expects N args, got M` with
    # the SAME `p.name or "<fn>"` substitution `op_name` already carries.
    # This message said "fn expects ..." for every closure, named or not,
    # so it diverged from the host on BOTH halves: `g expects 1 args, got
    # 2` (named) and `<fn> expects 1 args, got 2` (anonymous).
    @{v: mkb(miss (op_name + " expects " + str(len(c.params)) + " args, got " +
                   str(len(args))),
             "call " + op_name, args),
      st: st}
  } else if st.gd >= GUEST_MAX_DEPTH {
    # round 210: bail out BEFORE recursing into eval(c.body, ...) — the
    # store returned is `st`, the CALLER's own, still-good store, so
    # nothing downstream cascades (see new_store's GUEST_MAX_DEPTH
    # comment and the module-doc comment above for the corruption this
    # replaces: without this guard, a deep-enough guest recursion could
    # reach the HOST's own recursion-depth guard mid-chain, which hands
    # back a bare miss where this function's OWN "eval(...).st" below
    # unconditionally expects a record — replacing the whole store with
    # a miss and turning every later name lookup into a false "unbound
    # name", not just the over-deep call's own result).
    @{v: mkb(miss ("guest recursion too deep in " + c.name +
                   " (guest depth " + str(st.gd) + ")"),
             "call " + op_name, args),
      st: st}
  } else {
    let a = alloc(merge(st, @{gd: st.gd + 1}))
    let st2 = bind_params(a.st, a.fid, c.params, args, 0, c.param_specs)
    let r = eval(c.body, [a.fid] + c.env, st2)
    let checked = check_ret(r.v, c.ret_spec, c.name)
    @{v: mkb(checked.v, "call " + op_name, [checked]),
      st: merge(r.st, @{gd: st.gd})}
  }
}

# Return-type check (v0.13 guest parity, round 158): mirrors the host's
# `_check_ret` exactly — a no-op when the closure has no `-> Type` or the
# settled body result is ALREADY a miss (decision 2: a function that
# already failed does not also get a "wrong return type" gloss), otherwise
# a fresh origin miss (op "typed <label>", ONE input, the settled result) —
# the same node shape `typed()` itself produces on a mismatch. The ordinary
# "call <name>" wrap in `apply_closure` above always runs afterward around
# whichever box this returns, exactly like the host's `Prov("call", ...,
# result, ...)` always wrapping whatever `_check_ret` handed back.
#
# round 326: `fn_name` is ALWAYS a non-empty string here ("(anonymous)" for
# an unnamed closure, per `eval_FnExpr`'s own `name: "(anonymous)"` above),
# so the label must not unconditionally append "of " + fn_name the way an
# earlier version of this function did — the host's own `_closure_ret`
# (interp.py) only adds the " of %s" suffix when the closure's `name` is
# non-None, i.e. NEVER for an `A.FnExpr` (anonymous), and always for an
# `A.FnDef` (named). Mirrored here by treating the "(anonymous)" sentinel
# the same way `show_callable` above already does.
#
# round 338: `-> Shape`. The parser now hands a closure a spec NODE rather
# than a type-name string, and `resolve_ret_spec` below turns it into the
# spec VALUE once, at closure-creation time — mirroring the host's
# `_closure_ret`, which resolves there and never per call, so a typed
# tail-recursive function still costs nothing per bounce (round 336's
# transparency work depends on that staying true).
#
# Three spec shapes reach `check_ret`, and only the third is new:
#   ""                a function with no `-> Type` — the overwhelmingly
#                     common case, one comparison, unchanged.
#   a plain string    a primitive tag. `guest_type_ok` and plain `+`
#                     concatenation, byte-identical to round 158's version.
#   a BOX             a shape's own record, looked up in the defining env.
#                     Compared with `guest_spec_match` — the same shared
#                     test round 335 gave `typed`/`matches`, so a `-> Point`
#                     return and a `: Point` parameter test against the SAME
#                     record value, not two structural copies.
# plus the sentinel `@{__unbound_ret: name}`, which is the guest's
# `_UnboundRetType`. It exists for exactly the host's reason: the parser is
# not scope-aware, so `fn g() { shape L = @{x: num}  1 }  fn f() -> L { 1 }`
# PARSES (L was declared earlier in the token stream) while L's binding only
# ever lives inside g's call frame. The host's naive `env.get(name).payload`
# raised AttributeError on that — a real crash, SPEC v0.13. The guest's
# `lookup` misses instead of raising, so there is no crash to mirror; what
# had to be mirrored is the MESSAGE, since an unbound shape would otherwise
# fall through to `guest_spec_match` and read as an ordinary mismatch
# against a miss-valued spec.
# One spec, one resolution step, used by BOTH halves of a contract (v0.19)
# — the guest's `_closure_spec`. Splitting it out is the point of the
# round: two copies of this lookup, one for `-> Type` at closure creation
# and one for `p: Type` in the call env, are exactly what let one
# signature's `P` name two different shapes (round 342 §7).
fn resolve_spec(spec_node_v, env, st) {
  if spec_node_v == "" { "" }
  else if spec_node_v.kind == "str" { spec_node_v.value }
  else {
    let b = lookup(st, env, spec_node_v.value)
    if missed(b) { @{__unbound_ret: spec_node_v.value} } else { b }
  }
}

fn resolve_ret_spec(ret_type, env, st) { resolve_spec(ret_type, env, st) }

# v0.19: the PARAMETER half, resolved in the same env at the same moment,
# by the same `resolve_spec`. `param_types` is the parser's own list of
# `@{index, name, spec, label}` records; this replaces `spec` with its
# resolved value and drops the node. `[]` in, `[]` out — an unannotated
# function pays one comparison at closure creation and nothing per call.
fn resolve_param_specs(param_types, env, st, i, acc) {
  if i >= len(param_types) { acc }
  else {
    let pt = param_types[i]
    resolve_param_specs(param_types, env, st, i + 1,
                        push(acc, @{index: pt.index, name: pt.name,
                                    spec: resolve_spec(pt.spec, env, st),
                                    label: pt.label}))
  }
}

# "" for anything that is not the unbound sentinel — `get` on an absent key
# is a total miss, the same `rescue`d shape `guest_tag` above already uses.
fn unbound_ret_name(spec) { (get(spec, "__unbound_ret")) rescue "" }

# Mirror of the host's `_spec_ok` (interp.py), which `_type_match` names as
# its own PRECONDITION. Round 335 added it to `typed`/`matches` on the host
# and recorded "the guest does not mirror `_spec_ok`" as open; round 344
# closes that, because v0.19 makes the malformed-spec case REACHABLE from
# an ordinary annotation on both sides — `shape P = @{x: num}` shadowed by
# a plain `let P = 3` in the block a function is defined in resolves the
# annotation's `P` to `3`.
#
# Operates on a STRIPPED (box-free) value, like `guest_spec_match`'s own
# `matches(strip(...), strip(...))` delegation, so the field walk sees the
# same raw records the host's `_spec_ok` walks. No separate callable arm is
# needed: `is_record` already excludes callables (a guest closure is an
# ordinary `@{__tag: "closure", ...}` record under the hood, so without
# that exclusion this would walk its internals and call it a usable spec —
# round 18's tag-spoofing shape), which is the same protection
# `guest_spec_match` gets from testing `is_callable` first.
fn guest_spec_ok(spec) {
  if is_str(spec) { true }
  else if not is_record(spec) { false }
  else { guest_spec_fields_ok(spec, keys(spec), 0) }
}

fn guest_spec_fields_ok(spec, ks, i) {
  if i >= len(ks) { true }
  else if ks[i] == "__shape" { guest_spec_fields_ok(spec, ks, i + 1) }
  else if not guest_spec_ok(get(spec, ks[i])) { false }
  else { guest_spec_fields_ok(spec, ks, i + 1) }
}

# v0.25 (round 362): the guest's mirror of the host's `show_payload` — the
# renderer every message VALUE slot goes through on that side (`typed`'s
# spec and label, `sure`'s threshold, `check_contract`'s malformed-spec
# clause). Called `show_spec` until this round, when the contract-message
# differential measured what it actually answered:
#
#   * a MISS: `str` renders "miss: <reasons> (line N)"; `show_payload`
#     answers a bare "miss". Already special-cased before this round, and
#     the only one of the three that was.
#   * a CALLABLE: `str` DUMPED THE GUEST'S OWN CLOSURE RECORD — the
#     `@{__tag: "closure", body: ..., env: [...], param_specs: ...}` a
#     guest closure is under the hood — into a user-visible message, where
#     the host said `<fn>`. 10 of 436 annotation-site cases. `show_callable`
#     (round 156) has answered exactly this question since round 156 and
#     was simply never called from here: the same "a guest closure is an
#     ordinary record" hazard `guest_spec_ok`/`guest_spec_match` already
#     guard for MATCHING, left unguarded for SHOWING.
#   * a STRING: `show_payload` QUOTES it (`_quote`), `str` does not —
#     `sure(5, "x")` said `got "x"` on the host and `got x` here.
#
# Two things it deliberately does NOT mirror, both properties of the host's
# renderer rather than rules of the language, both enumerated and asserted
# load-bearing in `tests/test_contract_message_differential.py`:
#   E1 `show_payload`'s CAPS — 40 chars, 12 per nested element, 6 list
#      items, 4 record fields, 3 levels. `str` is the uncapped rendering
#      and no Whence expression can reach those constants.
#   E2 `_quote`'s ESCAPING of a backslash, a quote or a newline INSIDE a
#      string. Whence has no string-replace builtin.
fn show_val(v) {
  if missed(v) { "miss" }
  else if is_callable(v) { show_callable(v) }
  else if is_str(v) { "\"" + v + "\"" }
  else { str(v) }
}

# The early-out is repeated here rather than left to `check_contract`
# alone: without it every call of every function would pay the
# "return value of " + fn_name concatenation, and the overwhelmingly
# common case is a function with no `-> Type` at all.
fn check_ret(box, ret_spec, fn_name) {
  if ret_spec == "" or missed(box.v) { box }
  else {
    let label = if fn_name == "(anonymous)" { "return value" }
                else { "return value of " + fn_name }
    check_contract(box, ret_spec, label)
  }
}

fn check_contract(box, spec, label) {
  if spec == "" or missed(box.v) { box }
  else {
    let ub = unbound_ret_name(spec)
    let bad_spec = ub == "" and not is_str(spec) and
                   not guest_spec_ok(strip(spec))
    let ok = if ub != "" or bad_spec { false }
      else if is_str(spec) { guest_type_ok(box.v, spec) }
      else { guest_spec_match(box, spec) }
    if ok { box }
    else {
      let reason = if ub != "" {
          label + ": type '" + ub + "' is not in scope here"
        } else if bad_spec {
          "typed spec must be a type name or a shape, got " +
            show_val(strip(spec))
        } else if is_str(spec) {
          # a primitive tag: "expected num, got str" is already complete,
          # and there is no record spec to walk (v0.20)
          label + " expected " + spec + ", got " + guest_kind(box.v)
        } else {
          guest_mismatch_reason(label, strip(box), strip(spec),
                                guest_spec_name(strip(spec)))
        }
      mkb(miss reason, "typed " + label, [box])
    }
  }
}

# v0.19 (round 344): the parameter half of a function's type contract is
# applied HERE, as each argument crosses the call boundary, mirroring the
# host's `_check_params` (interp.py) — not by a `let p = typed(p, ...)`
# statement the parser prepended to the body, which is what v0.12-v0.18
# did on both sides. Two properties are inherited from those guards
# deliberately, so that moving the check does not also change its meaning:
# the checked box REPLACES the binding (and for a PASSING check
# `check_contract` returns its input unchanged, so a satisfied parameter
# contract leaves no trace in the why-tree, exactly as a satisfied
# `-> Type` already left none); and a FAILING check binds the miss and the
# body still runs, so a function that never reads a badly-typed parameter
# still returns normally.
#
# `param_spec_at` is a linear scan rather than an index into `param_specs`,
# because `param_specs` holds only the ANNOTATED parameters (`fn f(a, b:
# num)` has one entry, at index 1) — the same list `build_param_contracts`
# built, resolved. "" is its "this parameter is unannotated" answer, the
# same sentinel `ret_spec` uses for "no `-> Type`".
fn param_spec_at(pspecs, i, j) {
  if j >= len(pspecs) { "" }
  else if (pspecs[j]).index == i { pspecs[j] }
  else { param_spec_at(pspecs, i, j + 1) }
}

fn bind_params(st, fid, params, args, i, pspecs) {
  if i >= len(params) { st }
  else {
    let w0 = mkb((args[i]).v, "arg " + params[i], [args[i]])
    let pc = param_spec_at(pspecs, i, 0)
    let w = if pc == "" { w0 } else { check_contract(w0, pc.spec, pc.label) }
    bind_params(frame_bind(st, fid, params[i], w), fid,
                params, args, i + 1, pspecs)
  }
}

# round 218 shipped guest DISPATCH for steps/blame/diverge but left their
# LIST ELEMENTS unboxed (flagged as backlog: "steps(x)[0].op reads as a
# miss"). The host's `_step_record` (interp.py) reifies one provenance node
# as a real host Record with fields op/detail/line/show/depth/inputs/count/
# value — none of them individually boxed, because at the HOST level that
# is correct (host field access reads a Record's fields directly, no box
# convention). Every guest-visible record must instead follow line ~618's
# box invariant (every field a box), the same way `reify_node` above builds
# guest `why` records field-by-field — so a raw `_step_record` result has to
# be re-boxed field-by-field before a guest program can read `.op`/`.detail`
# /etc on it. `mkb(..., "step", [])` for each field: no real derivation
# happened INSIDE the bridge (the op/detail/etc are host bookkeeping, not
# computed guest values), so an empty `ins` and a fixed "step" op label
# mirror how `range`/`key`/`reason` elements are labelled just below.
fn box_step_record(rec) {
  @{op: mkb(rec.op, "step", []), detail: mkb(rec.detail, "step", []),
    line: mkb(rec.line, "step", []), show: mkb(rec.show, "step", []),
    depth: mkb(rec.depth, "step", []), inputs: mkb(rec.inputs, "step", []),
    count: mkb(rec.count, "step", []), value: mkb(rec.value, "step", [])}
}

# `diverge`'s items are a DIFFERENT host Record shape (`kind`/`a`/`b`, plus
# `which` for the n-way form) whose `a`/`b` fields are themselves raw
# `_step_record`s nested one level down — the same gap, one level deeper.
fn box_diverge_record(rec) {
  let base = @{kind: mkb(rec.kind, "diverge", []),
               a: mkb(box_step_record(rec.a), "step", []),
               b: mkb(box_step_record(rec.b), "step", [])}
  if has(rec, "which") { put(base, "which", mkb(rec.which, "diverge", [])) }
  else { base }
}

# ---- v0.22 argument-order hints (round 354) ----------------------------
# Host parity for `_BUILTIN_SIGS` / `_sig_fits` / `_order_hint`
# (whence/interp.py). Only the four builtins this evaluator re-implements
# need a mirror; every other builtin is DELEGATED to the host, which
# appends its own clause to its own miss, so parity there is free.
#
# Kinds are the host's `_kind()` tags and `guest_kind` above already
# mirrors that function exactly — including "callable before record",
# which matters here more than anywhere else: a guest closure IS a record
# under the hood, and classifying one as "record" would make
# `fold(nums, 0, fn(...))` look like an unfittable call and silence the
# hint the host emits.
#
# The host enumerates orderings with `itertools.permutations`; two and
# three arguments have two and six of them and the four builtins mirrored
# here take exactly two or three, so the guest lists them. This is
# decision 31 in the small: the rule the host implements is one the guest
# can express, and it is expressed here rather than approximated.
# v0.25 (round 362): `typed` and `sure` join the four. Round 354 wrote
# "only the four builtins this evaluator re-implements need a mirror" and
# that enumeration was wrong — `apply_builtin` re-implements `typed`,
# `sure` and `get` too, and each of the three carries a host message the
# host builds WITH `_order_hint`. `typed` and `sure` are fixed here; `get`
# is a separate finding recorded in round 362's knowledge file (its own
# branch also swallows a propagated miss and drops the "got X" clause, so
# it is a repair rather than an addition to this table).
let sig_names = @{map: ["fn", "xs"], filter: ["fn", "xs"],
                  fold: ["fn", "acc", "xs"], find: ["fn", "xs"],
                  typed: ["value", "spec", "label"], sure: ["v", "threshold"],
                  get: ["r", "name"]}
# [] means kind `any` — the host's `None`.
let sig_kinds = @{map: [["fn"], ["list"]], filter: [["fn"], ["list"]],
                  fold: [["fn"], [], ["list"]], find: [["fn"], ["list"]],
                  typed: [[], ["str", "record"], ["str"]],
                  sure: [[], ["num"]], get: [["record"], ["str"]]}

fn kind_ok(kinds, v) {
  if len(kinds) == 0 { true } else { contains(kinds, guest_kind(v)) }
}
fn sig_fits(kinds, vals, i) {
  if i >= len(vals) { true }
  else if not kind_ok(kinds[i], vals[i]) { false }
  else { sig_fits(kinds, vals, i + 1) }
}
fn perm_indices(n) {
  if n == 2 { [[0, 1], [1, 0]] }
  else { [[0, 1, 2], [0, 2, 1], [1, 0, 2], [1, 2, 0], [2, 0, 1], [2, 1, 0]] }
}
fn any_perm_fits(kinds, vals, ps, i) {
  if i >= len(ps) { false }
  else if sig_fits(kinds, map(fn(k) { vals[k] }, ps[i]), 0) { true }
  else { any_perm_fits(kinds, vals, ps, i + 1) }
}
# `vals` are unboxed guest values (`box.v`), matching the host's use of
# `arg.payload` — the top-level shape is all a kind test can see.
fn order_hint(name, vals) {
  let kinds = get(sig_kinds, name)
  if sig_fits(kinds, vals, 0) { "" }
  else if not any_perm_fits(kinds, vals, perm_indices(len(vals)), 0) { "" }
  else {
    " (arguments fit " + name + "(" + join(get(sig_names, name), ", ") + "))"
  }
}

# ---- builtins: delegate to the host on payloads wherever the argument is
# not a guest function; higher-order builtins re-implement the loop with
# guest apply so callbacks receive boxes (pass-through provenance).
# An INITIAL miss argument is handed to the host builtin so propagation
# happens before inspection, exactly like the host's _propagate; a miss that
# APPEARS mid-loop (a fold accumulator going bad) is still passed to the
# callback, because that is what the host does too.
# v0.28 (round 372): the host's `_arity_str`. `-1` is this table's sentinel
# for the builtins the host declares as the tuple `(1, 2)` -- `range`,
# `steps`, `diverge`, `contrast` -- which the host renders `1..2`.
fn guest_arity_str(ar) { if ar == -1 { "1..2" } else { str(ar) } }

# v0.28 (round 372): `strip` is NOT idempotent -- `strip(b)` is
# `strip_raw(b.v)`, and `strip_raw` maps `strip` over a list, so a list
# whose elements are already bare payloads makes it read `.v` on a number.
# The miss re-render hands `apply_host_builtin` boxes whose `.v` is already
# deep-stripped, so the three branches that strip for themselves must not
# strip again. Found by the re-render regressing `join([1, 1 / 0], ",")`
# from the host's `join: element 1 is not a string` to `cannot access .v
# on 1` -- a guest-only miss the host has no site for.
fn deep_arg(msg, b) { if msg { b.v } else { strip(b) } }

# v0.28 (round 372): keep `bare`'s wording only when BOTH runs miss. Every
# caller computes `boxed` first and `bare` from deep-stripped operands; a
# strip that changes the ANSWER (rather than only the rendering) therefore
# cannot change what the evaluator returns.
fn remsg(boxed, bare) { if missed(boxed) and missed(bare) { bare } else { boxed } }

# v0.28 (round 372) -- the re-render's COST GATE. A box can only leak into a
# message through a COMPOUND value: a guest list holds boxes and a guest
# record's fields are boxes, while a scalar payload is the same object the
# host would have had. Misses are common inside this evaluator (every
# `has`/`get` probe that comes back empty is one), so re-rendering
# unconditionally doubled the fast tier's wall clock -- 40 s to 87 s
# measured. Gating on "some operand is compound" keeps every fix and pays
# for the second call only where a leak is possible. Callables are excluded
# because a guest closure/builtin IS a record and stripping cannot help it
# (exemption E2).
fn is_compound(p) {
  if is_callable(p) { false } else { is_list(p) or is_record(p) }
}
fn any_compound(bs, i) {
  if i >= len(bs) { false }
  else if is_compound((bs[i]).v) { true }
  else { any_compound(bs, i + 1) }
}

fn apply_builtin(name, args, st) {
  let ar = get(arities, name)
  let ok = if ar == -1 { len(args) == 1 or len(args) == 2 }
    else { len(args) == ar }
  if not ok {
    # v0.28 (round 372): the host's builtin-arity message is
    # `<name> expects <arity> args, got <n>` (interp.py `_builtin_inline`,
    # `_call_direct`, `_call_gen`, `f_bcall` -- four copies, all identical),
    # where <arity> is `_arity_str`: a plain count, or `lo..hi` for the
    # range-arity builtins. This said "<name> arity mismatch: got N args",
    # a sentence the host never produces.
    @{v: mkb(miss (name + " expects " + guest_arity_str(ar) + " args, got " +
                   str(len(args))),
             "call " + name, args),
      st: st}
  }
  else if name == "map" {
    if missed((args[0]).v) or missed((args[1]).v) {
      # a propagated arg-miss is the host's merge_miss("builtin", name),
      # not a `map` node (round 24 — found by the why-shape probe's first
      # full campaign)
      @{v: mkb(map((args[0]).v, (args[1]).v), "builtin map", args), st: st}
    }
    else if not is_list((args[1]).v) {
      @{v: mkb(miss ("map needs a list, got "
                     + show_callable(strip(args[1]))
                     + order_hint("map", [(args[0]).v, (args[1]).v])),
               "map", args),
        st: st}
    }
    else {
      let r = guest_map(args[0], (args[1]).v, 0, [], st)
      # ins mirror the host's curated inputs: map records the LIST only,
      # not the mapping fn (round 20, found by the why-shape probe)
      @{v: mkb(r.v, "map", [args[1]]), st: r.st}
    }
  }
  else if name == "filter" {
    if missed((args[0]).v) or missed((args[1]).v) {
      @{v: mkb(filter((args[0]).v, (args[1]).v), "builtin filter", args),
        st: st}
    }
    else if not is_list((args[1]).v) {
      @{v: mkb(miss ("filter needs a list, got "
                     + show_callable(strip(args[1]))
                     + order_hint("filter", [(args[0]).v, (args[1]).v])),
               "filter", args),
        st: st}
    }
    else {
      let r = guest_filter(args[0], (args[1]).v, 0, [], st)
      @{v: mkb(r.v, "filter", [args[1]]), st: r.st}
    }
  }
  else if name == "fold" {
    if missed((args[0]).v) or missed((args[1]).v) or missed((args[2]).v) {
      @{v: mkb(fold((args[0]).v, (args[1]).v, (args[2]).v), "builtin fold",
               args),
        st: st}
    }
    else if not is_list((args[2]).v) {
      @{v: mkb(miss ("fold needs a list, got "
                     + show_callable(strip(args[2]))
                     + order_hint("fold", [(args[0]).v, (args[1]).v,
                                           (args[2]).v])),
               "fold", args),
        st: st}
    }
    else {
      let r = guest_fold(args[0], args[1], (args[2]).v, 0, st)
      # host fold node inputs: (final accumulator, list)
      @{v: mkb((r.v).v, "fold", [r.v, args[2]]), st: r.st}
    }
  }
  else if name == "find" {
    if missed((args[0]).v) or missed((args[1]).v) {
      @{v: mkb(find((args[0]).v, (args[1]).v), "builtin find", args), st: st}
    }
    else if not is_list((args[1]).v) {
      @{v: mkb(miss ("find needs a list, got "
                     + show_callable(strip(args[1]))
                     + order_hint("find", [(args[0]).v, (args[1]).v])),
               "find", args),
        st: st}
    }
    else { guest_find(args[0], (args[1]).v, 0, st) }
  }
  else if name == "typed" {
    # v0.12/v0.13 guest parity (round 158). Until v0.19 this was what the
    # erasure `apply_type_guards` built its calls to; v0.19 deleted the
    # erasure on both sides (a parameter annotation rides on the fn node
    # and is checked by `check_contract` via `bind_params`), so `typed` is
    # now reached only from a guest program that calls it directly. Same
    # contract as the host `typed` builtin: a miss
    # value/spec/label propagates FIRST (decision 2, before inspecting the
    # spec at all — mirrors host `_propagate`), a match is a PURE pass-
    # through (the original box, no new node — like `get`'s success case
    # below), a mismatch is a fresh origin miss with exactly ONE input.
    let value = args[0]
    let spec = args[1]
    let label = args[2]
    # v0.25 (round 362): three of this branch's four guards did not mirror
    # the host, and every one of the three was invisible to every oracle
    # for the same reason — a miss REASON is the guest differential's
    # oldest exemption (`_both_exempt_strings`, round 17), so both sides
    # missing was rated `ok` however differently they explained it.
    #
    # (1) PROPAGATION. The host's `_propagate` returns `merge_miss`, which
    # CARRIES the missed arguments' own reasons: `typed(num("x"), "num",
    # "L")` answers `num: cannot parse "x"`. This branch answered `typed: a
    # propagated miss` — a fresh sentence that DESTROYS the cause, in a
    # language whose decision 2 is that a miss can tell you why. Delegating
    # to the real host `typed` on stripped arguments reproduces the merge
    # exactly and cannot drift from it.
    if missed(value.v) or missed(spec.v) or missed(label.v) {
      @{v: mkb(typed(strip(value), strip(spec), strip(label)),
               "builtin typed", args), st: st}
    }
    # (2) THE LABEL and (3) THE SPEC are two host guards, checked in that
    # order, each naming the offending value; this branch had ONE guard
    # answering "typed: spec and label must be strings" for both. The
    # spec guard is `_spec_ok`, not a bare kind test: a record whose own
    # FIELDS are not specs is as unusable as a numeric one. Round 335
    # recorded "mirroring the host's `_spec_ok` walk here would buy no
    # observable agreement" — true only of the oracle, and it cost more
    # than a sentence: `typed(@{a: @{b: 1}}, @{a: 5}, "L")` fell through to
    # `guest_match_why`, which walked the malformed spec and leaked the
    # guest's OWN internal miss, `keys needs a record, got 5`, to the user.
    # `guest_spec_ok` (round 344) already existed for `check_contract`.
    else if not is_str(label.v) {
      @{v: mkb(miss ("typed label must be a string, got " +
                     show_val(strip(label)) +
                     order_hint("typed", [value.v, spec.v, label.v])),
               "typed", args), st: st}
    }
    else if not guest_spec_ok(strip(spec)) {
      @{v: mkb(miss ("typed spec must be a type name or a shape, got " +
                     show_val(strip(spec)) +
                     order_hint("typed", [value.v, spec.v, label.v])),
               "typed", args), st: st}
    }
    else if guest_spec_match(value, spec) { @{v: value, st: st} }
    else {
      # v0.20: same `guest_mismatch_reason` the contract path uses, so the
      # builtin and the annotation cannot drift apart — mirroring the host,
      # where `typed` and `_check_contract` share `_mismatch_reason`.
      let reason = if is_str(spec.v) {
          label.v + " expected " + spec.v + ", got " + guest_kind(value.v)
        } else {
          guest_mismatch_reason(label.v, strip(value), strip(spec),
                                guest_spec_name(strip(spec)))
        }
      @{v: mkb(miss reason, "typed " + reason, [value]), st: st}
    }
  }
  else if name == "get" {
    # host mirroring (round 24): only KEY-side trouble is get's own node;
    # record-side misses (missed record, non-record, absent field) are
    # _field's — get(r, "a") and r.a are indistinguishable node for node.
    # Key-badness is checked FIRST, matching host b_get's own order (it
    # rejects a non-string name before ever looking at the record side).
    # v0.25 (round 362): the key-side guard was ONE branch answering one
    # sentence where the host has TWO, and the contract-message
    # differential's builtin sweep measured both halves wrong.
    #   * `get(@{a: 1}, num("x"))` — a MISSED key. The host's first line is
    #     `merge_miss`, which carries the key's own reasons (`num: cannot
    #     parse "x"`); this said `get field name must be a string`, which
    #     is not even true of a miss.
    #   * `get("a", @{a: 1})` — a non-string key. The host names the
    #     offending value and appends v0.22's order hint (`got @{a: 1}
    #     (arguments fit get(r, name))`); this named neither, so the one
    #     message v0.22 exists to produce — swap your arguments — never
    #     reached a guest program.
    # `get` is the third builtin `apply_builtin` re-implements that carries
    # an `_order_hint` on the host, after `typed` and `sure`; round 354's
    # "only the four builtins this evaluator re-implements" missed all
    # three. Input ORDER stays as it was ([key, record]) — the host uses
    # (name, r) for the merge and (r, name) for the mismatch, and that
    # difference is measured, not mirrored, in round 362's knowledge file.
    let nm = (args[1]).v
    if missed(nm) {
      @{v: mkb(get(strip(args[0]), strip(args[1])), "get",
               [args[1], args[0]]), st: st}
    }
    else if missed(nm + "") {
      @{v: mkb(miss ("get field name must be a string, got " +
                     show_val(strip(args[1])) +
                     order_hint("get", [(args[0]).v, nm])),
               "get", [args[1], args[0]]), st: st}
    }
    else if is_callable((args[0]).v) {
      # Guest closures/builtin refs are ordinary records under the hood
      # (see the len/keys/put/merge/has guard above) but must stay opaque
      # like a real host function — the host's real `_field` helper (used
      # by BOTH `.field` and `get`) never sees a Record here at all, so it
      # can't pierce through. Mirror its exact node shape for a non-record
      # object: op "field", ONE input (the object only — the key is never
      # itself a derivation input, same as the ordinary non-callable path
      # below). Found by the why-shape probe (round 150, seed 602001893):
      # this branch used to derive its own "get" node naming BOTH args as
      # inputs, an op/arity host `_field` never produces for any object,
      # callable or not.
      # Round 156: the op tag itself must also carry the reason, matching
      # host's Prov.label() == "op + ' ' + detail" (interp.py's `_field`,
      # non-record branch defaults `detail` to the reason string itself).
      # A bare "field" tag here made the guest's op-label diverge from the
      # host's even though the miss VALUE's reason text was already
      # correct — caught by this test's own final `g - h == set()` line.
      let reason = "cannot access ." + nm + " on " + show_callable((args[0]).v)
      @{v: mkb(miss reason, "field " + reason, [args[0]]),
        st: st}
    }
    else {
      let r0 = get((args[0]).v, nm)
      @{v: if missed(r0) { mkb(r0, "field", [args[0]]) } else { r0 },
        st: st}
    }
  }
  # host b_num returns its argument's own node when it is already a number:
  # a pass-through, no `num` node (round 107, why-shape probe: guest-only op
  # `num` on `num(addv)`); strings still derive a `num` node below
  else if name == "num" and len(args) == 1 and is_num((args[0]).v) {
    @{v: args[0], st: st}
  }
  # v0.15 guest parity fix (round 194): host `b_sure` is a PASS-THROUGH (no
  # new node) when `value` was never a Guess — "already certain: sure() is
  # a no-op escape hatch" (interp.py b_sure). Before this fix `sure` fell
  # to the generic catch-all below, which always synthesizes a fresh
  # "sure" box regardless — caught live by the why-shape differential
  # fuzzer (seed 9205, round 192->194): `sure([], 0.0)`, a plain value,
  # showed a guest-only "literal" op the host derivation for the same
  # program never produces (host: {let, list} — the empty-list literal's
  # own node, untouched by a no-op `sure`). Mirrors `typed`'s pass-through
  # success case above. Round 194 left the Guess-carrying cases (both the
  # above-threshold pass-through AND, it turns out, the below-threshold
  # miss) deliberately unfixed pending an actual finding: `sure`/`guess`
  # are not in `harness/swe/guest.py`'s `WHY_VOCAB`, so the why-shape
  # containment probe cannot see either op token, and both gaps' other
  # extra/missing tokens ("literal") already legitimately appear
  # elsewhere in the host derivation, so even the vocabulary tokens that
  # ARE tracked pass the containment check by accident. Round 234
  # confirmed both gaps are real by direct construction (op-walking
  # `let g = guess(1 + 2, 0.9, "m"); let r = sure(g, T)` by hand for T on
  # both sides of 0.9 -- see the round-234 knowledge file for the full
  # op-list repro) and fixed both:
  # - below threshold: host `mk_miss(..., inputs=(v,))` keeps only the
  #   VALUE's own derivation, never the threshold's -- the old guest
  #   code wrapped with `ins: args` (value AND threshold), one spurious
  #   extra "literal" leaf for the threshold's own literal node.
  # - above threshold: `unwrap_guess_box` (defined above, next to
  #   `is_guess_val`) reconstructs the box for `g.node` -- the host's
  #   `Guess.node`, set once at `guess()` construction time to the RAW
  #   pre-wrap argument, bypassing every later `let`/`guess` wrapper --
  #   purely from guest box structure, with a safe do-nothing fallback
  #   for shapes it cannot trace through (see its own docstring above).
  else if name == "sure" {
    let value = args[0]
    let threshold = args[1]
    # v0.25 (round 362): the same two repairs the `typed` branch above
    # takes, for the same reason and found by the same differential — the
    # propagated miss carried a fresh sentence instead of the argument's
    # own reasons, and the threshold message rendered its value with `str`
    # (so a string threshold read `got x`, not the host's `got "x"`) and
    # omitted the v0.22 order-hint clause the host appends here.
    if missed(value.v) or missed(threshold.v) {
      @{v: mkb(sure(strip(value), strip(threshold)), "builtin sure", args),
        st: st}
    }
    else if not is_num(threshold.v) or threshold.v < 0 or threshold.v > 1 {
      @{v: mkb(miss ("sure threshold must be a number between 0 and 1, got " +
                     show_val(strip(threshold)) +
                     order_hint("sure", [value.v, threshold.v])),
               "sure", args), st: st}
    }
    else if not is_guess_val(value.v) { @{v: value, st: st} }
    else {
      let outcome = sure(value.v, threshold.v)
      if missed(outcome) { @{v: mkb(outcome, "sure", [value]), st: st} }
      else {
        # Round 241: `unwrap_guess_box`'s own docstring already documents
        # its fallback ("a box with more than one `ins` element ... falls
        # back to returning the box UNCHANGED") as safe -- true for WHY-
        # SHAPE (no wrong node is invented), but false for VALUE: an
        # unchanged box's `.v` is still the ORIGINAL Guess, not the
        # unwrapped `outcome` this branch already computed and, until
        # this fix, threw away. `guess(5, 0.8, "s") + 1` is exactly this
        # shape (a "+"-op box, 2 `ins` elements, `op` != "guess") --
        # `sure(that, 0)` regressed from a plain `6` to a Guess still
        # wrapping `6`, caught by the pre-existing pinned check "guest
        # arithmetic propagates a guess (weakest link kept)" (line ~1876
        # below) the very next full-suite run. Detect the fallback fired
        # (the walk's own payload is still a Guess) and use the ALREADY-
        # CORRECT `outcome` in a `mkb`-wrapped "sure" node instead --
        # same shape the miss branch above already accepts (one spurious
        # extra why-node in the untraceable case) rather than silently
        # wrong content.
        let unwrapped = unwrap_guess_box(value)
        if is_guess_val(unwrapped.v) { @{v: mkb(outcome, "sure", [value]), st: st} }
        else { @{v: unwrapped, st: st} }
      }
    }
  }
  else {
    # v0.28 (round 372) -- THE BOX-LEAK RE-RENDER.
    #
    # `apply_host_builtin` hands the host builtin the guest's own values.
    # For a scalar that is the same thing the host would have seen; for a
    # LIST or a RECORD it is not, because a compound guest value holds
    # BOXES (`@{op, v, ins}`) where the host holds plain elements. On the
    # SUCCESS path that is exactly right and load-bearing (the boxes are
    # what carry guest provenance). On the MISS path it is a wording bug:
    # every host message that renders an argument then renders a box, so
    # `num(@{a: 1})` read `num of @{a: @{ins: [], o...}` in the guest and
    # `num of @{a: 1}` in the host. Round 362 measured ONE instance of this
    # (its exemption E3, `push`'s order hint) and handed the class to a
    # future language(C) round with that case as the repro; round 372's
    # whole-surface sweep found 14 of them.
    #
    # The fix costs nothing on the success path: delegate exactly as
    # before, and only if the answer is a MISS delegate a SECOND time with
    # deep-stripped arguments and keep that miss's wording instead. The
    # re-call is guarded three ways -- `print`/`rand` are excluded because
    # a second call would repeat the EFFECT, and the re-rendered result is
    # used only when it is also a miss, so a strip that changes the ANSWER
    # can never change what this function returns.
    let p_boxed = apply_host_builtin(name, args, false)
    let p = if missed(p_boxed) and name != "print" and name != "rand" and
              any_compound(args, 0) {
        let bare = map(fn(a) { mkb(strip(a), "literal", []) }, args)
        let p_bare = apply_host_builtin(name, bare, true)
        if missed(p_bare) { p_bare } else { p_boxed }
      } else { p_boxed }
    # element ops mirror the host exactly: range items are `range` leaves,
    # keys are `key`, reasons are `reason` (round 20 — the why-shape probe
    # caught these labelled "literal", an op the host never performed here)
    let p2 = if missed(p) { p }
      else if name == "range" { map(fn(x) { mkb(x, "range", []) }, p) }
      else if name == "keys" { map(fn(x) { mkb(x, "key", []) }, p) }
      else if name == "reasons" { map(fn(x) { mkb(x, "reason", []) }, p) }
      # round 222: box steps/blame's step-record elements (see
      # box_step_record above) so guest code can read `.op`/`.detail`/etc,
      # not just `len(...)` of the list, the same gap this round closed.
      else if name == "steps" or name == "blame" {
        map(fn(x) { mkb(box_step_record(x), "step", []) }, p)
      }
      else if name == "diverge" {
        map(fn(x) { mkb(box_diverge_record(x), "diverge", []) }, p)
      }
      else { p }
    # a PROPAGATED miss — a miss among the arguments the host checks first
    # (`_propagate`) — is the host's merge_miss("builtin", name): op
    # "builtin", inputs = the checked arguments. The higher-order builtins
    # above mirrored this since round 24; the plain ones did not (round 30
    # — the why-shape probe reported `len`/`merge` on misses as guest-only
    # ops). `put` checks (record, key) only: its value may be a miss.
    let pargs = if name == "put" { [args[0], args[1]] } else { args }
    let propagated = contains(propagating, name) and
      not missed(find(fn(a) { missed(a.v) }, pargs))
    # curated ins where the host drops an argument's derivation: put keeps
    # (record, value) but not the key; note keeps only the noted value
    let ins2 = if propagated { pargs }
      else if name == "put" { [args[0], args[2]] }
      else if name == "note" { [args[1]] }
      else { args }
    let o = if propagated { "builtin" } else { name }
    @{v: mkb(p2, o, ins2), st: st}
  }
}

# `msg` (v0.28, round 372): true on the miss RE-RENDER call above. Three
# slots hand the host builtin a guest BOX on purpose, because the host
# stores whatever it is given as a list element / record field and the
# guest needs its box back; on the re-render those same slots must carry
# the bare payload or the host's `_order_hint` sees a record and either
# suppresses a hint it should print (`push(1, [2])` -- round 362's E3) or
# prints one it should not (`put("", [], 1)` -- a record fits the untyped
# `r` slot, so a permutation "fits" that does not).
fn apply_host_builtin(name, args, msg) {
  let a0 = (args[0]).v
  # guest closures/builtin refs are ordinary records under the hood, but the
  # HOST's functions are opaque: len/keys/put/merge on a function miss.
  # Guard the record-piercing builtins so the guest is opaque too
  # (found by the round-17 guest-differential fuzzer: len(fn) was 4).
  if is_callable(a0) and (name == "len" or name == "keys" or
                          name == "put" or name == "merge" or name == "has") {
    # v0.28 (round 372): `merge` is the one of the five whose host message
    # renders NOTHING -- `merge needs two records`, whichever operand is
    # the function -- so the guest can say it exactly. The other four
    # (`len of <builtin len>`, `keys/put/has needs a record, got <fn g>`)
    # all render the callable, which the guest cannot reproduce: the host
    # prints a closure's NAME and Whence has no way to build a named
    # closure at run time. That is exemption E2.
    if name == "merge" { miss "merge needs two records" }
    else { miss (name + " of a function") }
  }
  else if name == "merge" and is_callable((args[1]).v) {
    miss "merge needs two records"
  }
  # host b_contains: a list item that fails deep_eq (a function anywhere
  # in either side makes deep_eq miss) simply does not match — `false`,
  # never a miss (round 107: the guest guard here said miss)
  else if name == "contains" and is_list(a0) and holds_callable((args[1]).v) {
    false
  }
  else if name == "print" { print(strip(args[0])) }
  # v0.14.8 guest parity: `rand` is the first arity-0 builtin, so `a0`
  # above (computed unconditionally as `(args[0]).v`) is a propagated
  # host-level miss here (`args` is `[]`) rather than a real argument --
  # harmless, since this branch never reads it. Calling the real host
  # `rand()` builtin directly draws from the SAME running interpreter's
  # `_rng` that a direct (non-guest) evaluation of the same program would
  # use, so guest and host draw identical sequences given the same seed
  # (self_eval.lang itself never calls `rand()` except here, one draw per
  # guest-level `rand()` call, in the same order the guest program makes
  # them).
  else if name == "rand" { rand() }
  else if name == "len" { len(a0) }
  else if name == "str" { str(deep_arg(msg, args[0])) }
  else if name == "num" { num(a0) }
  else if name == "abs" { abs(a0) }
  else if name == "sqrt" { sqrt(a0) }
  else if name == "trunc" { trunc(a0) }
  else if name == "missed" { missed(a0) }
  else if name == "reasons" { reasons(a0) }
  else if name == "keys" { keys(a0) }
  else if name == "range" {
    if len(args) == 1 { range(a0) } else { range(a0, (args[1]).v) }
  }
  else if name == "push" { push(a0, if msg { strip(args[1]) } else { args[1] }) }
  else if name == "note" { note(a0, (args[1]).v) }
  else if name == "contains" {
    contains(deep_arg(msg, args[0]), deep_arg(msg, args[1]))
  }
  else if name == "join" { join(deep_arg(msg, args[0]), (args[1]).v) }
  else if name == "merge" { merge(a0, (args[1]).v) }
  else if name == "put" {
    put(a0, (args[1]).v, if msg { strip(args[2]) } else { args[2] })
  }
  # v0.6: presence check — field VALUES are boxes but has only reads keys,
  # so the host builtin applies directly (guard above keeps closures opaque)
  else if name == "has" { has(a0, (args[1]).v) }
  # v0.15 guest parity (round 176): `guess`/`is_guess`/`confidence` need NO
  # closure guard the way len/keys/put/merge/has above do — the real host
  # `guess` builtin happily wraps ANY value, including a real Closure
  # (verified directly: `guess(some_fn, 0.9, "s")` succeeds at the host),
  # so a guest closure record passing through unguarded matches that. `sure`
  # moved to its own branch in `apply_builtin` (round 194) — it needs a
  # pass-through case this generic-wrapping helper can't express.
  #
  # Round 251 fix: this branch used to pass the bare `a0` (`args[0].v`)
  # straight to the host `guess` builtin, on the theory that "the value
  # being guessed keeps its own full provenance chain, exactly like
  # `note`'s first argument." That holds for a SCALAR argument (a literal
  # box's `.v` already IS the raw host value, no guest boxing beneath it)
  # but not for a LIST/RECORD argument: a compound guest box's `.v` is a
  # host list/record of NESTED GUEST BOXES (`eval`'s "list"/"record" cases
  # build `mkb(r.v, ..., r.v)` from the ITEM boxes, not their unwrapped
  # values), so `guess([1,2,3], ...)` wrapped a list of `@{op,v,ins}`
  # Records instead of a list of plain ints — a real guest-differential
  # fuzz finding (`harness/swe/guest.py`'s targeted Guess-carrying
  # campaign, minimized to `guess([1,2,3], 0.5, "m")`). `strip()` (used
  # already by `print`/`str`/`contains`/`join` above) is the existing,
  # already-correct fix for exactly this shape: identity on scalars,
  # closures, and Guesses (all opaque to `strip_raw`, matching the old
  # behaviour exactly there), recursive `map(strip, ...)` /
  # field-by-field unwrap on lists/records. Verified this changes nothing
  # for every existing guess-shape case
  # (`test_guest_guess_is_guess_confidence_why_shape_matches_host_exactly`,
  # all scalar-valued) while fixing the list/record case.
  else if name == "guess" { guess(strip(args[0]), (args[1]).v, (args[2]).v) }
  else if name == "is_guess" { is_guess(a0) }
  else if name == "confidence" { confidence(a0) }
  # v0.16 guest parity (round 206): `steps` walks the REAL host provenance
  # already sitting on `a0` — every guest value's `.v` is a genuine host
  # Whence value built through real host `put`/`merge`/record-literal calls
  # as self_eval.lang's own evaluator runs, so it already carries real
  # history for free (same free-delegation trick as `guess`/`is_guess`/
  # `confidence` above, round 176). Found by self_host.lang's own test
  # section (line 651-652, checkpoint 47) calling `steps` on a guest AST at
  # the deep guest-EVALUATOR level for the first time — `steps` was never
  # in `builtin_names` at all, so guest code calling it failed at NAME
  # RESOLUTION ("unbound name 'steps'"), never even reaching this dispatch
  # (see knowledge/round-206-whence-v16-guest-steps-parity.md).
  else if name == "steps" {
    if len(args) == 1 { steps(a0) } else { steps(a0, (args[1]).v) }
  }
  # v0.16.4 guest parity (round 218): `at`/`blame`/`diverge`/`contrast` are
  # the same "provenance as data" (round 4) family as `steps` above and
  # share the identical free-delegation fix — `a0`'s real host provenance
  # is already there for free, so each just calls straight through to the
  # real host builtin of the same name. Round 206 flagged this as follow-up
  # backlog specifically because nothing in the corpus exercised them yet
  # ("evaluate-before-authoring"); `languages/whence/tests/test_self_hosting.py`'s
  # new `test_guest_{at,blame,diverge,contrast}_...` tests (round 218) are
  # that exercising code, written first to make the gap real before fixing
  # it, mirroring `steps`'s own two-arg-pattern test (round 206). None of
  # these four are in `propagating` — like `steps`, they are host-documented
  # as TOTAL (must work on a miss argument, e.g. `blame` walking a failed
  # value's own origin chain is the whole point).
  else if name == "at" { at(a0, (args[1]).v) }
  else if name == "blame" { blame(a0) }
  else if name == "diverge" {
    if len(args) == 1 { diverge(a0) } else { diverge(a0, (args[1]).v) }
  }
  else if name == "contrast" {
    if len(args) == 1 { contrast(a0) } else { contrast(a0, (args[1]).v) }
  }
  # v0.16.6 guest parity (round 224): `matches`/`shapeof` (v0.12 structural
  # types) were never in `builtin_names` at all -- guest code calling
  # either failed at NAME RESOLUTION ("unbound name"), never even reaching
  # this dispatch, the same gap class rounds 206/218/222 already found and
  # fixed for the rest of the builtin surface. Both are TOTAL (never
  # propagate a miss argument -- host `b_matches`/`b_shapeof` are
  # documented "like missed: never itself a miss") and return SCALAR
  # payloads (a bool / a kind string), so the free-delegation trick mostly
  # applies with no post-processing needed (unlike `steps`/`blame`/
  # `diverge`, nothing here returns a list of records to box). One real
  # wrinkle found empirically before writing any test: a GUEST closure is
  # an ordinary tagged Record under the hood (see the `is_callable` guard
  # a few branches above, for `len`/`keys`/`put`/`merge`/`has`), not a
  # real host `Closure`/`Builtin` object, so undguarded delegation reports
  # "record" for a guest function's shape, never "fn" -- `shapeof`/
  # `matches` are the two builtins in this whole family whose entire job
  # is reporting shape, so silently mislabelling a function as a record
  # would be a real, user-visible correctness bug, not a cosmetic gap.
  # Guarded with the SAME `is_callable`/`guest_kind` split `typed`'s own
  # `guest_type_ok` already uses one branch above, rather than reusing
  # `guest_type_ok`/`guest_kind` outright: those two only support a plain
  # STRING spec (`is_str(spec) and (spec == "any" or guest_kind(v) ==
  # spec)`), a narrower feature slice sufficient for `typed`'s param-guard
  # call sites; `matches`/`shapeof` are general-purpose builtins meant to
  # be called directly by user code, so the non-callable case still
  # delegates to the real host `matches`/`shapeof` to keep the FULL
  # v0.12 feature surface (including structural Record specs) reachable.
  # `shapeof` is safe on any non-callable guest value: host `_kind` only
  # inspects the top-level payload type, never recurses into record
  # fields, so it never sees the guest's `{v, op, ins}` box wrapper on a
  # nested field. `matches` is likewise safe for a plain STRING spec
  # against a non-callable value (`_type_match` for a str spec is the same
  # non-recursive `_kind(payload) == spec` check) -- but round 240 found
  # (before this fix existed, by direct probing per "evaluate before
  # authoring") that a STRUCTURAL Record spec against a non-callable guest
  # record does NOT just "mismatch every nested check" as this comment used
  # to predict: it CRASHES the host with an uncaught `AttributeError`
  # (`_type_match` recurses into `payload.fields[fname].value` expecting a
  # str-or-Record, but gets the field's `{v, op, ins}` BOX -- a Record with
  # no `.value` attribute -- one level in, and a WList once the recursion
  # reaches a box's own `ins` list two levels in). A "never raises"
  # violation is a strictly worse bug than a semantic mismatch, so this is
  # fixed rather than left as backlog: `strip()` (defined near the top of
  # this file) deep-unboxes a guest box into a plain host-shaped value
  # (real Prov-wrapped fields via `put`, no `{v,op,ins}` wrapper anywhere),
  # which is exactly the shape `_type_match`'s recursion already assumes.
  # Both the value AND the spec need stripping -- a structural spec built
  # by guest code (e.g. `@{x: "num", y: "num"}`) is itself a guest record
  # with boxed field values, same as any other guest record. The plain-
  # string-spec fast path is UNCHANGED (still `matches(a0, spec)` directly,
  # zero extra cost) since a str spec never recurses into fields regardless
  # of whether the value's own fields are boxed. `strip()` is also safe as
  # a no-op on a miss spec (falls through unchanged, matching host
  # `_is_miss(spec)` -> False) and on any non-Record/non-str spec (a
  # number, bool, etc. -- also falls through unchanged, matching host's
  # `not isinstance(spec.payload, (str, Record))` -> False guard) — so one
  # `else` branch below covers every remaining case correctly, not just
  # the Record-spec case that motivated it.
  else if name == "matches" {
    let spec = (args[1]).v
    if is_callable(a0) { is_str(spec) and (spec == "any" or spec == "fn") }
    else if is_str(spec) { matches(a0, spec) }
    else { matches(strip(args[0]), strip(args[1])) }
  }
  else if name == "shapeof" {
    if is_callable(a0) { "fn" } else { shapeof(a0) }
  }
  else { miss ("builtin '" + name + "' is not implemented in the guest") }
}

fn guest_map(f, xs, i, acc, st) {
  if i >= len(xs) { @{v: acc, st: st} }
  else {
    let r = apply(f, [xs[i]], st)
    guest_map(f, xs, i + 1, push(acc, r.v), r.st)
  }
}

fn guest_filter(f, xs, i, acc, st) {
  if i >= len(xs) { @{v: acc, st: st} }
  else {
    let r = apply(f, [xs[i]], st)
    if missed((r.v).v) { @{v: (r.v).v and true, st: r.st} }
    else if not is_bool((r.v).v) {
      @{v: miss ("filter predicate must return true/false, got "
                 + show_callable(strip(r.v))), st: r.st}
    }
    else if (r.v).v { guest_filter(f, xs, i + 1, push(acc, xs[i]), r.st) }
    else { guest_filter(f, xs, i + 1, acc, r.st) }
  }
}

fn guest_fold(f, acc, xs, i, st) {
  if i >= len(xs) { @{v: acc, st: st} }
  else {
    let r = apply(f, [acc, xs[i]], st)
    guest_fold(f, r.v, xs, i + 1, r.st)
  }
}

fn guest_find(f, xs, i, st) {
  if i >= len(xs) {
    @{v: mkb(miss "find: no element matched", "find", []), st: st}
  }
  else {
    let r = apply(f, [xs[i]], st)
    if missed((r.v).v) { @{v: mkb((r.v).v and true, "find", [r.v]), st: r.st} }
    else if not is_bool((r.v).v) {
      @{v: mkb(miss ("find predicate must return true/false, got "
                     + show_callable(strip(r.v))), "find", [r.v]),
        st: r.st}
    }
    else if (r.v).v { @{v: xs[i], st: r.st} }
    else { guest_find(f, xs, i + 1, r.st) }
  }
}

fn eval_index(node, env, st) {
  let o = eval(node.obj, env, st)
  let ix = eval(node.index, env, o.st)
  let raw0 = ((o.v).v)[(ix.v).v]
  # v0.28: the index guards render the index value, so a LIST index leaked
  # boxes (`("abc")[[1, 2]]` read `... got [@{ins: [], o..., @{ins: [], o...]`).
  let raw = if missed(raw0) and is_compound((ix.v).v) {
              remsg(raw0, (strip(o.v))[strip(ix.v)])
            }
            else { raw0 }
  let b = if missed(raw) { mkb(raw, "index", [o.v, ix.v]) }
    else if is_list((o.v).v) { raw }
    else { mkb(raw, "index", [o.v, ix.v]) }
  @{v: b, st: ix.st}
}

fn eval_field(node, env, st) {
  let o = eval(node.obj, env, st)
  if is_callable((o.v).v) {
    let reason = "cannot access ." + node.name + " on " + show_callable((o.v).v)
    @{v: mkb(miss reason, "field " + reason, [o.v]),
      st: o.st}
  }
  else {
    let raw = get((o.v).v, node.name)
    @{v: if missed(raw) { mkb(raw, "field ." + node.name, [o.v]) } else { raw },
      st: o.st}
  }
}

# ---- driver -----------------------------------------------------------------
fn eval_program(ast, st) {
  let a = alloc(st)
  exec_stmts(ast.stmts, 0, [a.fid, "f0"], a.st,
             mkb(miss "empty program", "program", []))
}

fn run_src(src) {
  let ast = parse_whence(src)
  if missed(ast) { @{v: ast, checks: [], parse_error: true} }
  else {
    let r = eval_program(ast, new_store())
    @{v: strip(r.v), checks: r.st.checks, parse_error: false}
  }
}

# run_src_p keeps the boxes: v is the final statement's provenance node
fn run_src_p(src) {
  let ast = parse_whence(src)
  if missed(ast) { @{v: mkb(ast, "parse", []), checks: [], parse_error: true} }
  else {
    let r = eval_program(ast, new_store())
    @{v: r.v, checks: r.st.checks, parse_error: false}
  }
}

fn gv(src) { (run_src(src)).v }
fn gp(src) { (run_src_p(src)).v }


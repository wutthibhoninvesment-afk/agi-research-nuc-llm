  missed(gv("fn f(a: num) { let a = a\na }\nf(\"x\")"))
check "guest unknown type annotation is a parse-time miss":
  missed((run_src("fn f(a: Bogus) { a }\nf(1)")).v)
check "guest return type is not re-checked over an already-missed body":
  missed(gv("fn f() -> num { 1 / 0 }\nf()"))

# ==== GUEST-LEVEL PROVENANCE (self-hosting round 5) ==========================
# A guest value is its provenance node. The library can read the box graph
# directly (gp); a guest PROGRAM reads its own derivation through `why`,
# which reifies the graph into ordinary records — the language's one idea,
# applied to itself.

let pw = gp("let x = 2 + 3\nlet y = x * 10\ny")
check "guest value is its provenance node": pw.op == "let y"
check "guest derivation input is the multiply": (pw.ins[0]).op == "*"
check "pass-through: reading x keeps its binding node":
  ((pw.ins[0]).ins[0]).op == "let x"
check "the binding's input is the plus": (((pw.ins[0]).ins[0]).ins[0]).op == "+"
check "guest literals sit at the leaves":
  ((((pw.ins[0]).ins[0]).ins[0]).ins[0]).op == "literal"

let pc = gp("fn double(n) { n + n }\ndouble(4)")
check "guest call node names the guest function": pc.op == "call double"
check "the call's input is the body result": (pc.ins[0]).op == "+"
check "params bind through arg nodes": ((pc.ins[0]).ins[0]).op == "arg n"

let pi = gp("if 2 > 1 { \"yes\" } else { \"no\" }")
check "guest if records which branch ran": pi.op == "if took then-branch"
check "guest if keeps the condition": (pi.ins[1]).op == ">"

# `why` inside the guest: the derivation as guest DATA (records op/v/ins)
check "guest why is guest data": gv("let x = 2 + 3\n(why x).op") == "let x"
check "guest why exposes the payload": gv("let x = 2 + 3\n(why x).v") == 5
check "guest why nests": gv("let x = 2 + 3\n((why x).ins[0]).op") == "+"
check "guest snip prunes guest history":
  gv("let x = snip (2 + 3)\nlen(((why x).ins[0]).ins)") == 0
check "guest why is budget-capped, not divergent":
  not missed(gv("let big = fold(fn(a, x) { a + x }, 0, range(100))\n(why big).op"))

# --- the flagship: guest-level blame, written IN the guest -------------------
# origin() walks the why-data to the node that CREATED the miss (its value
# is a miss but no input's is) — the host's blame(), as three lines of
# interpreted guest code traversing its own derivation.
let blame_src = "fn origin(w) { let bad = find(fn(i) { missed(i.v) }, w.ins)\n" +
  "if missed(bad) { w } else { origin(bad) } }\n" +
  "let total = fold(fn(a, r) { a + num(r) }, 0, [\"12\", \"3O\", \"7\"])\n" +
  "let o = origin(why total)\n" +
  "o.op + \": \" + reasons(o.v)[0]"
let verdict = gv(blame_src)
check "guest blame names the origin op": contains(verdict, "num:")
check "guest blame reads the origin reason": contains(verdict, "cannot parse")

print("self_eval.lang: source -> tokens -> AST -> value -> provenance, all in Whence; all checks above passed")

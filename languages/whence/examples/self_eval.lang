# --- the flagship: guest-level blame, written IN the guest -------------------
# origin() walks the why-data to the node that CREATED the miss (its value
# is a miss but no input's is) — the host's blame(), as three lines of
# interpreted guest code traversing its own derivation.
let blame_src = "fn origin(w) { let bad = find(fn(i) { missed(i.v) }, w.ins)\n" +
  "if missed(bad) { w } else { origin(bad) } }\n" +
  "let total = fold(fn(a, r) { a + num(r) }, 0, [\"12\", \"3O\", \"7\"])\n" +
  "let o = origin(why total)\n" +

           "type 'L' is not in scope here")
check "a name never declared at all is still 'unknown type', not 'not in scope'":
  contains(reasons(gv("fn f(p: Nope) { p }\nf(1)"))[0], "unknown type 'Nope'")

# The other half of scoping: a block-local shape is a perfectly good type
# INSIDE its own block, sibling blocks may each declare the same name, and
# an inner block may shadow an outer one — all three exactly as an ordinary
# `let` behaves, which is the point (a `shape` IS a `let`).
check "a block-local shape works inside its own block":
  gv("fn mk() { shape L = @{x: num}\nfn f(p: L) -> L { p }\n(f(@{x: 7})).x }\nmk()") == 7
check "sibling blocks may each declare the same shape name":
  gv("fn a() { shape S = @{x: num}\nfn f(p: S) { p.x }\nf(@{x: 1}) }\n" +
     "fn b() { shape S = @{y: num}\nfn g(p: S) { p.y }\ng(@{y: 2}) }\na() + b()") == 3
check "an inner block may shadow an outer shape name":
  gv("shape S = @{x: num}\n" +
     "fn inner() { shape S = @{y: num}\nfn g(p: S) { p.y }\ng(@{y: 5}) }\ninner()") == 5
check "redeclaring in the SAME block is still refused":
  contains(reasons(gv("shape P = @{x: num}\nshape P = @{y: num}\n1"))[0],
           "shape 'P' is already declared in this block")

# v0.19 (round 344): both halves of a contract — `p: T` and `-> T` — are
# resolved by ONE `resolve_spec`, in the DEFINING env, at closure creation,
# and the parameter half is applied at the call boundary (`bind_params`)
# rather than by a `let p = typed(p, ...)` statement the parser prepends to
# the body. The four checks below are the guest's own version of the
# host's `test_v13.py` v0.19 family; every one of them ran differently
# before this round.
check "a `let` AFTER the annotation no longer captures the spec":
  gv("shape P = @{x: num}\n" +
     "fn g() { fn h(p: P) { p.x }\nlet P = 3\nh(@{x: 1}) }\ng()") == 1
check "one signature means ONE shape — the outer P, at both ends":
  contains(reasons(gv("shape P = @{x: num}\n" +
                      "fn g() { fn h(p: P) -> P { p }\nshape P = @{y: str}\n" +
                      "h(@{y: \"a\"}) }\ng()"))[0],
           "parameter 'p' of h expected P, got record")
check "...and the inner shape wins when IT is the one in scope":
  (gv("shape P = @{x: num}\n" +
      "fn g() { shape P = @{y: str}\nfn h(p: P) -> P { p }\n" +
      "h(@{y: \"a\"}) }\ng()")).y == "a"

# v0.20 (round 348), the guest half. `guest_match_why` walks `keys(spec)`
# — which SORTS — and that is exactly why the host walks
# `sorted(spec.fields)` rather than its own declaration order: declaration
# order is not reachable from Whence, so a rule that depended on it would
# be one this file could not express (decision 27) and the two sides would
# name a different field in every multi-field mismatch.
check "the field clause names the missing field":
  contains(reasons(gv("shape P = @{x: num, a: str}\n" +
                      "fn f(p: P) { p }\nf(@{x: 1})"))[0],
           "expected P, got record (no field 'a')")
check "...and a wrongly-typed field, from the RETURN end":
  contains(reasons(gv("shape P = @{x: num}\n" +
                      "fn f() -> P { @{x: \"s\"} }\nf()"))[0],
           "expected P, got record (field 'x' expected num, got str)")
check "a nested mismatch reports the PATH":
  contains(reasons(gv("shape P = @{x: num}\nshape Q = @{p: P}\n" +
                      "fn f(q: Q) { q }\nf(@{p: @{x: \"s\"}})"))[0],
           "(field 'p'.'x' expected num, got str)")
check "a miss-valued field is its own clause":
  contains(reasons(gv("shape P = @{x: num}\n" +
                      "fn f(p: P) { p }\nf(@{x: 1/0})"))[0],
           "(field 'x' is a miss)")
check "sorted order, not declaration order: b declared first, a named":
  contains(reasons(gv("shape P = @{b: num, a: num}\n" +
                      "fn f(p: P) { p }\nf(@{b: \"s\", a: \"s\"})"))[0],
           "(field 'a' expected num, got str)")
# A reason carries its own " (line N)" suffix, so "there is no clause" is
# pinned by what immediately follows the v0.12 sentence rather than by
# string equality.
check "a primitive spec keeps the v0.12 sentence, with no clause":
  contains(reasons(gv("fn f(p: num) { p }\nf(\"s\")"))[0],
           "parameter 'p' of f expected num, got str (line")
check "and a non-record payload gets no clause either":
  contains(reasons(gv("shape P = @{x: num}\nfn f(p: P) { p }\nf(3)"))[0],
           "parameter 'p' of f expected P, got num (line")
# The `_spec_ok` floor (round 335 left it open on both sides; v0.19 makes
# it reachable from an ordinary annotation, so both sides grew it). On the
# host the RETURN half of this raised AttributeError out of the
# interpreter before round 344.
check "a name that is in the type namespace but not a spec at run time":
  contains(reasons(gv("shape P = @{x: num}\n" +
                      "fn g() { let P = 3\nfn h(p: P) { p }\nh(@{x: 1}) }\ng()"))[0],
           "typed spec must be a type name or a shape, got 3")
check "...and the RETURN half says the identical sentence":
  contains(reasons(gv("shape P = @{x: num}\n" +
                      "fn g() { let P = 3\nfn h(q) -> P { q }\nlet o = h(1)\no }\ng()"))[0],
           "typed spec must be a type name or a shape, got 3")

# Nothing above changes what an untyped or primitive-typed program does.
check "untyped guest code is unaffected":
  gv("fn add(a, b) { a + b }\nadd(1, 2)") == 3
check "primitive annotations still behave exactly as before":
  gv("fn t(a: num) -> num { a * 2 }\nt(21)") == 42
check "and a primitive return mismatch still misses":
  contains(reasons(gv("fn t(a: num) -> num { \"x\" }\nt(1)"))[0],
           "return value of t expected num, got str")

print("self_eval.lang: source -> tokens -> AST -> value -> provenance, all in Whence; all checks above passed")

+/* Longest common prefix of the record and this prompt, capped at np-1: at
+ * least one token must be fed so there is a final hidden state to sample. */
+static int q36_lcp(const kv_prefix *p, const int *ids, int np){
+    if (!p->fed || p->tainted || p->len <= 0) return 0;
+    int n = p->len < np - 1 ? p->len : np - 1;
+    int i = 0;
+    while (i < n && p->fed[i] == ids[i]) i++;
+    return i;
+}

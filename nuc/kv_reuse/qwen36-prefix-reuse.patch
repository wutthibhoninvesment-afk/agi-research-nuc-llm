+/* Parse a SUBMIT header line. Returns the number of numeric fields read
+ * (5 = classic, 6 = +xlen, 7 = +system-prefix hint, 8 = +stable-prefix
+ * hint) or 0 on a malformed line. Hints outside the payload are dropped. */
+static int serve_parse_header(const char *line, int *slot, int *plen, int *max_tok,
+                              float *temp, float *top_p, int *xlen, int *prefix_bytes, int *stable_bytes){
+    *xlen = 0; *prefix_bytes = 0; *stable_bytes = 0;
+    int n = sscanf(line,"%*s %*s %d %d %d %f %f %d %d %d",slot,plen,max_tok,temp,top_p,xlen,prefix_bytes,stable_bytes);
+    if (n < 5) return 0;
+    if (n < 6 || *xlen < 0) *xlen = 0;
+    if (n < 7 || *prefix_bytes < 0 || *prefix_bytes >= *plen) *prefix_bytes = 0;
+    if (n < 8 || *stable_bytes < 0 || *stable_bytes >= *plen) *stable_bytes = 0;
+    return n;

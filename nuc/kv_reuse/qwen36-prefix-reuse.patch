+/* ---- prefix reuse: snapshots + the decision ------------------------------ */
+static size_t q36_dn_rec_n(const Cfg *c){ return (size_t)c->dn_vheads * c->dn_kdim * c->dn_vdim; }
+static size_t q36_dn_conv_n(const Cfg *c){ return (size_t)c->dn_conv_dim * (c->dn_convk - 1); }
+
+static int q36_prefix_enabled(void){
+    const char *e = getenv("Q36_PREFIX");
+    return !(e && *e && atoi(e) == 0);

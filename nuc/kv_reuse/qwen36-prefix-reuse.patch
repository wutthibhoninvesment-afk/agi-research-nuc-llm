+
+/* Snapshot the DeltaNet state as it stands now. Only valid when the state
+ * IS at `pos` (kv_len == pos) and the record covers it; anything else would
+ * label a state with tokens that did not produce it. Buffers are kept for
+ * the process lifetime (one allocation per slot). Returns 1 on success. */
+static int q36_snap_take(Model *m, Q36Snap *s, int pos){
+    Cfg *c = &m->c;
+    s->pos = 0;
+    if (pos <= 0 || m->kv_len != pos || m->kvp.len < pos || m->kvp.tainted) return 0;
+    if (!s->rec){
+        s->rec = calloc(c->n_layers, sizeof(float*)); s->conv = calloc(c->n_layers, sizeof(float*));
+        if (!s->rec || !s->conv){ free(s->rec); free(s->conv); s->rec = NULL; s->conv = NULL; return 0; }
+        for (int i = 0; i < c->n_layers; i++){
+            if (c->is_attn[i]) continue;
+            s->rec[i] = malloc(q36_dn_rec_n(c) * sizeof(float));
+            s->conv[i] = malloc(q36_dn_conv_n(c) * sizeof(float));
+            if (!s->rec[i] || !s->conv[i]){
+                for (int j = 0; j <= i; j++){ free(s->rec[j]); free(s->conv[j]); }
+                free(s->rec); free(s->conv); s->rec = NULL; s->conv = NULL; return 0;
+            }
+        }
+    }
+    for (int i = 0; i < c->n_layers; i++){
+        if (c->is_attn[i]) continue;
+        memcpy(s->rec[i], m->DN_rec[i], q36_dn_rec_n(c) * sizeof(float));
+        memcpy(s->conv[i], m->DN_conv[i], q36_dn_conv_n(c) * sizeof(float));
+    }
+    s->pos = pos;
+    return 1;
 }
 
+static void q36_snap_restore(Model *m, const Q36Snap *s){
+    Cfg *c = &m->c;
+    for (int i = 0; i < c->n_layers; i++){
+        if (c->is_attn[i]) continue;
+        memcpy(m->DN_rec[i], s->rec[i], q36_dn_rec_n(c) * sizeof(float));
+        memcpy(m->DN_conv[i], s->conv[i], q36_dn_conv_n(c) * sizeof(float));
+    }
+}

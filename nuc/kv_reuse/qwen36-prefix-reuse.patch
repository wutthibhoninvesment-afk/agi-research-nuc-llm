+/* Forget the conversation: the record, the recurrent state, the snapshots.
+ * Pairs the three so they can never disagree (kv_prefix.h). */
+static void model_state_reset(Model *m){
+    kv_prefix_clear(&m->kvp);
+    reset_recurrent(m);
+    m->kv_len = 0;
+    for (int k = 0; k < Q36_SNAP_N; k++) m->snap[k].pos = 0;
+}
+
+/* Decide how much of the state to keep BEFORE touching it, then size the
+ * KV cache. Returns the position prefill starts at (0 = cold).
+ *
+ *  1. strict continuation (kv_prefix_reuse): the prompt begins with every
+ *     id the state was built from, prompt and reply alike -> the state
+ *     already IS the state at that position; nothing to restore.
+ *  2. otherwise the deepest snapshot at or before the longest common
+ *     prefix: the attention rows below the LCP are still the rows a cold
+ *     run would compute (a row depends only on its prefix), and the
+ *     snapshot supplies the recurrent state at exactly that position.
+ *     This is what an agent turn needs: the client re-renders the reply
+ *     (tool calls, stripped reasoning) so 1 fails at the reply boundary,
+ *     but the prompt-end snapshot restores everything up to it.
+ *  3. nothing usable -> cold: reset, prefill from 0.
+ * The logits are the ones a cold run would have produced in every case. */
+static int prepare_request_state(Model *m, const int *ids, int np, int max_t, int *lcp_out){
+    int reuse = 0;
+    *lcp_out = 0;
+    if (q36_prefix_enabled()){
+        reuse = kv_prefix_reuse(&m->kvp, ids, np);
+        if (!reuse){
+            int lcp = q36_lcp(&m->kvp, ids, np), best = -1;
+            *lcp_out = lcp;
+            for (int k = 0; k < Q36_SNAP_N; k++)
+                if (m->snap[k].pos > 0 && m->snap[k].pos <= lcp &&
+                    (best < 0 || m->snap[k].pos > m->snap[best].pos)) best = k;
+            if (best >= 0){
+                q36_snap_restore(m, &m->snap[best]);
+                reuse = m->snap[best].pos;
+                m->kvp.len = reuse;      /* the record now ends where the state does */
+            }
+        }
+    }
+    if (!reuse) model_state_reset(m);
+    m->max_t = max_t;
+    ensure_kv(m);
+    if (reuse && m->kvp.len != reuse){ model_state_reset(m); reuse = 0; }   /* growth lost the rows */
+    m->kv_len = reuse;
+    /* snapshots above the kept prefix describe positions about to be overwritten */
+    for (int k = 0; k < Q36_SNAP_N; k++) if (m->snap[k].pos > reuse) m->snap[k].pos = 0;
+    return reuse;
+}

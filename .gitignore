logs/nuc-llm-tunnel*

# Per-round health-check output (round 241/247): reproducible by
# re-running harness/run_tests_fast.sh or languages/whence/run_tests_fast.sh
# directly, and driver.log already carries the PASS/FAIL summary line —
# these full logs are diagnostic scratch, not source, growing one file per
# round forever if left tracked.
logs/health_round_*.log
logs/whence_health_round_*.log

# OS files
.DS_Store
Thumbs.db

# IDE configs
.vscode/
.idea/

# NUC research binaries & model weights (too large for git)
nuc/fast_lane/olmoe_merged/
nuc/fast_lane/colibri-c/olmoe
nuc/.venv/
harness/.venv/

# Round 175 (harness A): local install artifacts for this NUC host's
# `claude` CLI + Python venvs — reproducible from package.json/
# package-lock.json/pyproject.toml, not source, and 100s of MB each.
.venv/
node_modules/
languages/whence/.venv/
languages/whence/research-env/

# Driver single-instance lock (round 157) — a live lock file, not state.
state/.driver.lock

# Evaluation transcripts
state/trigger-eval/round-*/transcripts/
state/trigger-eval/*.json
state/trigger-eval/*.log

# Round 352: the swap-watch supervisor's live poll log. It is appended to once
# a minute for the run's whole duration (8h), so tracking it would leave a
# genuinely uncommitted diff in `git status` for every round in that window and
# trip the record-gap check eight times over for a file that is doing exactly
# what it is supposed to. The DURABLE artifacts of a run -- the checkpoint
# JSONL and the final JSON the watcher scp's back -- are tracked as normal;
# only the supervisor's own progress log is ignored.
state/nuc-swap-watch-*/poll.log
